@{
    # Каталог bin той платформы, на которой работает база.
    V8Bin = 'C:\Program Files\1cv8\8.3.27.2130\bin'

    # Тестовая база. Проверь имя сервера кластера и имя базы в кластере.
    # Скрипт откажется работать, если имя базы не похоже на тестовую (temp, test, copy, stand...).
    Server = 'srv-1c'
    Base   = 'erp_temp'
    File   = ''                      # для файловой базы: каталог базы; тогда Server и Base не используются
    ForbiddenBases = @('erp_base')   # страховка: сюда нельзя ни при каких настройках

    # Код разрешения входа: если в базе установлена блокировка начала сеансов с кодом,
    # конфигуратор и клиент запускаются с ним (/UC). Пусто - без кода.
    UnlockCode = '0'

    # Завершение сеансов тестовой базы при монопольной блокировке (ответ 3 в гейте): через агент
    # сервера 1С, COM-компонента V83.COMConnector. Пусто - tcp://<Server>. Администратор кластера -
    # если он задан в кластере; пароль - файлом от -SavePassword.
    ClusterAgent         = ''
    ClusterAdmin         = ''
    ClusterAdminPassFile = ''

    # Подготовка базы перед прогоном. Гейт всегда ставит у базы блокировку регламентных заданий
    # (нужен вход в свойства базы: AdminUser с паролем или текущий пользователь Windows, если кластер пустит).
    # ReleaseJobsLock = $true - снять её в конце прогона, если её поставил гейт. Ключ -ReleaseJobsLock - то же.
    ReleaseJobsLock = $false
    # Если в базе есть сеансы: 'Ask' - спросить, 'Continue' - работать как есть, 'Exit' - выйти,
    # 'Terminate' - поставить блокировку начала сеансов с кодом UnlockCode и завершить сеансы.
    # Открытый конфигуратор закрывается только по ответу в консоли. Ключ -OnSessions важнее.
    OnSessions = 'Ask'
    # На сколько часов ставится блокировка начала сеансов. В конце прогона гейт её снимает сам.
    SessionLockHours = 2

    # Скрипт обновления рабочей базы (deploy.cmd). Рабочая база обязана стоять в ForbiddenBases.
    ProdBase          = 'erp_base'
    ProdAdminUser     = ''           # пусто - как AdminUser
    ProdAdminPassFile = ''           # пусто - как AdminPassFile
    DeployExtensions  = @()          # пусто - как Extensions; порядок = порядок загрузки
    DeployDeniedFrom  = 22           # с этого часа обновлять нельзя (окно обновления - остальное время; равны - запрета нет)
    DeployDeniedTo    = 2            # до этого часа обновлять нельзя
    ProdSelfCheckForms = $false      # самопроверка на рабочей: проверять формы (создание формы может писать настройки)
    ProdSelfCheckTimeoutMin = 60
    # Сколько ждать ответа «оставить или откатить» после проверок на рабочей, минут. Нет ответа - обновление остаётся. 0 - не спрашивать.
    DeployKeepTimeoutMin = 10
    DeployWarnMinutes = 10           # предупреждение пользователей рабочей до блокировки сеансов; 0 - без него
    CloseWarnMinutes  = 10           # «Закрыть рабочую базу»: предупреждение до запрета входа и регламентных; 0 - только «закрыть сейчас»
    PlainLoginTimeoutSec = 180       # вход без кода разрешения после снятия блокировок: сколько ждать, секунд; 0 - не проверять
    DeployDir         = 'deploy'
    ComTimeoutSec     = 300            # ответ внешнего соединения при чтении расширений, секунд

    # Под кем запускается конфигуратор.
    # Пустое имя = текущий пользователь Windows (доменная авторизация), пароль не нужен.
    # Для пользователя с паролем: .\run.cmd -SavePassword secrets\robot.txt и впиши сюда имя и файл.
    AdminUser     = ''
    AdminPassFile = ''

    # Расширения, которые приходят комплектами. Порядок = порядок загрузки, нижний слой первым.
    # В имени файла .cfe должно быть одно из этих имён: erp_temp_Адаптация_20261115.cfe (база_расширение_дата).
    Extensions = @('Адаптация', 'Доработки', 'Подрядчик_Доработки')

    # Что проверять конфигуратором.
    # Пусто = все расширения базы одним проходом (-AllExtensions).
    # Если чужие расширения дают шум, перечисли только свои: @('Адаптация', 'Доработки')
    CheckOnly = @()

    # Проверка конфигурации (/CheckConfig): на temp идёт около 25 минут.
    # Обычное приложение не включено намеренно: у общих модулей расширений этот признак часто не стоит.
    # -HandlersExistence убран: на расширениях он даёт 2800 ложных «Отсутствует обработчик»,
    # в том числе по заведомо рабочим формам Контура и Деловых линий.
    RunCheckConfig   = $true
    # Проверка конфигурации одним проходом (CheckOnly пусто или одно расширение) стартует после выгрузки расширений
    # в файлы и идёт параллельно с самопроверкой и модульными тестами; итог - перед вердиктом. Прогон короче минут
    # на 15-20 (оценка, не замер).
    # Если на базе будет «конфигуратор занят» в шагах после загрузки - поставь $false.
    ParallelCheckConfig = $true
    CheckConfigFlags = '-ConfigLogIntegrity -IncorrectReferences -ThinClient -Server -ExternalConnection -ExtendedModulesCheck'

    # Отдельный синтаксис-контроль (/CheckModules): 12 минут. Выключен, потому что проверка конфигурации
    # находит те же ошибки компиляции. Включай вместо неё, если нужен быстрый ответ «компилируется ли».
    RunCheckModules   = $false
    CheckModulesFlags = '-ThinClient -Server -ExternalConnection'

    # Проверка применимости расширений: около 2 минут.
    RunCheckCanApply = $true

    # Канареечный вход.
    CanaryEpf        = 'tools\Канарейка.epf'
    CanaryWaitSec    = 10      # сколько секунд клиент живёт после старта, прежде чем написать «ok»
    CanaryTimeoutSec = 300     # сколько ждём результата, потом красный (вход на temp занимал 93 с)
    CanaryUsers = @(
        @{ Name = ''; PassFile = '' }      # текущий пользователь Windows
        # Обычные пользователи добавляются так (нужны право открывать внешние обработки
        # и снятый флажок «Защита от опасных действий»):
        # @{ Name = 'Тест_Кладовщик'; PassFile = 'secrets\kladovschik.txt' }
    )

    # Действия после обновления (раздел 5.24): файлы actions\*.bsl комплекта гейт выполняет после канарейки.
    # ActionsRegister - регистр сведений выполненных действий (измерение Действие, строка): выполненное не повторяется.
    # HistoryRegister - регистр истории загрузок (измерения Момент и Номер); пусто - история не пишется.
    # ActionsRegister = ''
    # HistoryRegister = ''
    ActionsTimeoutSec = 1800   # сколько ждём итога действий

    # Самопроверка: обработка «Выполнить после обновления» запускается гейтом автоматически, сама выполняет
    # тестирование и закрывает 1С. Запускается под той же учёткой, что и конфигуратор (нужны полные права).
    # С комплектом выполняется дважды, до загрузки и после; красное - только новые ошибки.
    # Нет файла обработки - шаг жёлтый, остальное работает.
    RunSelfCheck = $true
    Coverage = $true                 # карта покрытия после самопроверки: что из доработок чем задето (раздел 5.14)
    # Шаг «Обмены» самопроверки (раздел 5.17): Full - объекты пакета, очередь узла (что зарегистрировано к отправке)
    # и срезы пакета; Light - только объекты пакета. Лимиты очереди узла: на вид и всего.
    ExchangeMode = 'Full'
    ExchangeQueuePerType = 5
    ExchangeQueueTotal = 50
    # Проверка правил обмена по выгрузке расширений, без 1С (раздел 5.18).
    ExchangeRules = $true
    # Исключения к правилу R1 (только с перехватом, который гарантирует ключ структуры; пропал перехват - исключение
    # не действует): @{ Rule = 'Справочник_Пример_ИзСтруктуры'; Property = 'Свойство'; Reason = 'почему можно';
    #                   GuardExtension = 'Адаптация'; GuardMethod = 'ФункцияСобирающаяСтруктуру' }
    # ExchangeRuleExceptions = @()
    # Расширения подрядчиков: в них R4 ищет #Вставка, #Удаление и перехваты без пометки автора с датой. Пусто - R4 нет.
    # ContractorExtensions = @()
    # Что в снимках самопроверки меняется само (регулярные выражения, совпадение -> «*»). Пусто - по умолчанию.
    # SnapshotMasks = @('(?<=<(?:\w+:)?(?:CreationDate|MessageNo|ReceivedNo|LastUpdate)>)[^<]*')
    NightlyAt = '03:30'              # ночной прогон «как есть» (nightly.cmd -Install, раздел 5.16); не в часы NightlyDeniedFrom..To
    NightlyDeniedFrom = 22           # ночной прогон не ставить с этого часа (бэкап, обновление рабочей)
    NightlyDeniedTo = 2              # и до этого часа
    MetricSlowFactor = 1.5           # время операций (раздел 5.15): медленно - дольше медианы истории в столько раз
    MetricMinDeltaMs = 500           # ... и на столько миллисекунд
    MetricMinHistory = 3             # меньше замеров в истории - не сравнивается
    SelfCheckEpf = 'tools\ВыполнитьПослеОбновления.epf'
    SelfCheckDocs      = 3       # поле «Документов каждого вида», от 1 до 50: больше документов - дольше прогон
    SelfCheckForms     = $true   # проверять формы расширений
    SelfCheckPost      = $true   # проводить документы (внутри транзакции, которая всегда отменяется)
    SelfCheckSkipDocs  = ''      # виды документов через запятую, которые не проводить: 'ЗаказКлиента, РеализацияТоваровУслуг'
    SelfCheckNotOlder  = ''      # поле «Документы не старше», ГГГГММДД; пусто = обработка решает сама
    SelfCheckStartTimeoutSec = 300   # сколько ждём, пока обработка откроется
    ParallelProcessingBuild = $true  # собирать следующий EPF/ERF во время записи предыдущего на тестовой базе
    ProcessingAllForms = $false      # дополнительно создавать каждую именованную форму без параметров на тестовой базе
    ProcessingTimeoutSec = 600       # запись внешней обработки в справочник (режим regepf): сколько ждём итога
    SelfCheckStallMin        = 20    # нет новых заданий дольше этого - клиент снимается, прогон продолжается со следующего задания
    SelfCheckRestarts        = 2     # сколько раз так перезапускать за один прогон самопроверки
    SelfCheckTimeoutMin      = 120   # предел на один сеанс обработки
    # Два исполнителя самопроверки (раздел 5.25 руководства): 2 - группу SelfCheckSplitGroup делят два сеанса обработки,
    # остальное идёт как всегда. Группа - шаг очереди, как в заголовке шага журнала, например 'Формы расширений'.
    # Делится только группа из заданий, которые лишь читают (формы, клиентские модули, компиляция серверных модулей,
    # печатные формы, отчёты), иначе её целиком выполняет первый. Сначала замерить: run.cmd -SelfCheckGroup.
    SelfCheckWorkers         = 1
    SelfCheckSplitGroup      = ''

    # Что делать с загруженным комплектом, если вердикт красный или жёлтый с замечаниями:
    # 'Ask' - спросить в консоли, оставить или откатить; 'Keep' - оставить в базе; 'Rollback' - откатить.
    # Откат: прежняя версия расширения загружается из папки прогона before, а расширение, которого
    # до загрузки в базе не было, удаляется. Ключ запуска -OnNotGreen важнее этой настройки.
    OnNotGreen = 'Ask'

    # Модульные тесты YAxUnit (readme.txt, раздел «Модульные тесты»). Тестовые расширения грузятся из файлов
    # UnitTestsDir\<имя> (выгрузка в файлы) только в тестовую базу; в Extensions и DeployExtensions их не пишут:
    # комплектом они не грузятся и в рабочую не уходят. Движок - расширение UnitTestEngine - ставится в temp руками.
    # Пусто - шага «Модульные тесты» нет.
    # UnitTestExtensions = @('Тесты')
    RunUnitTests       = $true
    UnitTestEngine     = 'YAXUNIT'
    UnitTestsDir       = 'tests'
    UnitTestTimeoutMin = 30          # предел на прогон тестов
    UnitTestAuthor     = ''          # автор новых тестов из меню «Тесты»: Фамилия И.О. (дата добавляется сама)

    # Обновление гейта из релизов GitHub (readme.txt, раздел 5.20): пусто - пункта в меню нет.
    # UpdateRepo = 'владелец/репозиторий'
    # GitHubTokenPassFile = 'secrets\githubtoken.txt'   # токен, зашифрован DPAPI: «Настройки - Обновление гейта и git»
    # Итог каждого прогона - в GitHub (раздел 5.22): событие gate-run в этот репозиторий, нужен Contents: write.
    # RunReportRepo = 'владелец/репозиторий'
    # Расширения и обработки через git (раздел 5.23): «Загрузить из git», «Выгрузить temp в git». Токен - тот же,
    # с правами Contents и Pull requests: чтение и запись.
    # ExtensionsRepo = 'владелец/репозиторий'
    ExtensionsBranch = 'main'
    # Снимок внешних обработок рабочей (deploy.ps1 -GitProd) - в эту ветку; пишет её только гейт.
    ExtensionsProdBranch = 'prod'
    # Типовая конфигурация temp - в свой репозиторий (только для чтения агентами), портативным git (MinGit в
    # tools\git, скачивается сам; или GitExe). Выгружается в конце «Выгрузить temp в git», если версия изменилась.
    # TypicalRepo = 'владелец/репозиторий'
    TypicalBranch = 'main'
    TypicalDumpTimeoutMin = 180
    # Свободного места меньше - типовую не выгружать (ГБ); держать ли выгрузку между версиями (гигабайты на диске).
    TypicalMinFreeGB = 12
    TypicalKeepDump = $false
    GitDir = 'git'
    UpdateTagPrefix = 'gate-'

    # Папка с обновлениями для меню гейта (.\run.cmd без ключей).
    InboxDir = 'inbox'

    # Приёмка поставок подрядчика (раздел 5.26, deploy.ps1 -Delivery, меню «Приёмка поставок»): бинарники .cfe,
    # .epf, .erf или папка комплекта во «Входящих» -> git (PR, CI) -> temp -> гейт. Отдельно от inbox: оттуда прямой
    # загрузкой ничего не берётся. Техническая база - файловая, для разбора поставок (имя папки - как у тестовой).
    DeliveryInboxDir = 'Входящие'
    DeliveryDir = 'deliveries'
    DeliveryTechBase = 'deliveries\tech-stand'
    # Слияние PR самим гейтом через ci/merge_checked.py репозитория расширений - только если хеш файла в main равен
    # закреплённому (DeliveryMergeCheckedBlob, git hash-object): изменённый CI сначала смотрит человек. Нужен Python 3.9+.
    DeliveryAutoMerge = $false
    # DeliveryMergeCheckedBlob = 'хеш блоба git'
    DeliveryPython = 'python'
    DeliveryCiWaitMin = 30

    # Статистика длительностей шагов (stats.ps1): папка журнала и за сколько дней брать записи для прогноза.
    StatsDir  = 'stats'
    StatsDays = 120

    # Таймауты шагов конфигуратора, минуты.
    TimeoutLoadMin   = 30
    TimeoutUpdateMin = 120
    TimeoutCheckMin  = 120

    # Куда складывать прогоны (относительно папки скрипта или полный путь).
    RunsDir = 'runs'
}
