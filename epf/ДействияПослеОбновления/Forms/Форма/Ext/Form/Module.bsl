// Действия после обновления: форма запуска. Версия 00000000.000000.
// ** Хлебников С.Ю. 20261120 Новая обработка гейта: исполнитель действий после обновления.
//
// Запуск (делает run.ps1):
//   1cv8c ENTERPRISE /S"сервер\база" /Execute "ДействияПослеОбновления.epf" /C"actions;in=<файл параметров>;out=<файл результата>"
//
// Сразу после открытия форма пишет отметку <файл результата>.started, читает файл параметров, выполняет
// действия на сервере (модуль объекта), пишет файл результата и завершает работу 1С.
// Без слова actions в параметре запуска ничего не делает.

#Область ОписаниеПеременных

&НаКлиенте
Перем ПутьКФайлуРезультата;

&НаКлиенте
Перем ДокументПараметров;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастройкиЗапуска = НастройкиИзСтрокиЗапуска(ПараметрЗапуска);
	Если НастройкиЗапуска = Неопределено Тогда
		ПоказатьСостояние(СтрШаблон("запуск не для действий, ничего не делаю. Параметр запуска: [%1]", ПараметрЗапуска));
		Возврат;
	КонецЕсли;

	ПутьКФайлуРезультата = НастройкиЗапуска.ФайлРезультата;
	// Отметка «обработка открылась и разобрала параметр запуска»: по ней гейт понимает, докуда дошло.
	ЗаписатьФайл(ПутьКФайлуРезультата + ".started", "started=1", "ПослеЗаписиОтметкиЗапуска");

	ПоказатьСостояние("читаю параметры " + НастройкиЗапуска.ФайлПараметров);
	ДокументПараметров = Новый ТекстовыйДокумент;
	Оповещение = Новый ОписаниеОповещения("ПослеЧтенияПараметров", ЭтотОбъект, Неопределено,
		"ПриОшибкеЧтенияПараметров", ЭтотОбъект);
	ДокументПараметров.НачатьЧтение(Оповещение, НастройкиЗапуска.ФайлПараметров, "UTF-8");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает параметр запуска вида "actions;in=C:\папка\params.txt;out=C:\папка\result.txt".
//
// Параметры:
//  СтрокаЗапуска - Строка - значение параметра запуска /C.
//
// Возвращаемое значение:
//  Структура, Неопределено - ФайлПараметров и ФайлРезультата (Строка); Неопределено - запуск не для действий.
//
&НаКлиенте
Функция НастройкиИзСтрокиЗапуска(Знач СтрокаЗапуска)

	ЭтоДействия = Ложь;
	ФайлПараметров = "";
	ФайлРезультата = "";
	Для Каждого ЧастьСтрокиЗапуска Из СтрРазделить(СтрокаЗапуска, ";", Ложь) Цикл
		Часть = СокрЛП(ЧастьСтрокиЗапуска);
		ЧастьНРег = НРег(Часть);
		Если ЧастьНРег = "actions" Тогда
			ЭтоДействия = Истина;
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "in=") Тогда
			ФайлПараметров = Сред(Часть, 4);
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "out=") Тогда
			ФайлРезультата = Сред(Часть, 5);
		КонецЕсли;
	КонецЦикла;

	Если Не ЭтоДействия Или ПустаяСтрока(ФайлПараметров) Или ПустаяСтрока(ФайлРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("ФайлПараметров, ФайлРезультата", ФайлПараметров, ФайлРезультата);

КонецФункции

// Файл параметров прочитан: действия - на сервере, результат - в файл.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - не используется.
//
&НаКлиенте
Процедура ПослеЧтенияПараметров(ДополнительныеПараметры) Экспорт

	ТекстПараметров = ДокументПараметров.ПолучитьТекст();
	ПоказатьСостояние("выполняю действия");
	Попытка
		ТекстРезультата = ВыполнитьНаСервере(ТекстПараметров);
	Исключение
		ТекстРезультата = "status=error" + Символы.ПС + "error="
			+ СтрЗаменить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " ");
	КонецПопытки;
	ПоказатьСостояние("пишу результат в " + ПутьКФайлуРезультата);
	ЗаписатьФайл(ПутьКФайлуРезультата, ТекстРезультата, "ПослеЗаписиФайлаРезультата");

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеЧтенияПараметров(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой платформа не показывает: при автозапуске его некому закрыть.
	СтандартнаяОбработка = Ложь;
	ТекстРезультата = "status=error" + Символы.ПС + "error=не прочитал файл параметров: "
		+ СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке), Символы.ПС, " ");
	ЗаписатьФайл(ПутьКФайлуРезультата, ТекстРезультата, "ПослеЗаписиФайлаРезультата");

КонецПроцедуры

&НаСервере
Функция ВыполнитьНаСервере(Знач ТекстПараметров)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ВыполнитьПоТекстуПараметров(ТекстПараметров);

КонецФункции

// Записывает текстовый файл на компьютере клиента без модальных и синхронных вызовов.
//
// Параметры:
//  ПутьКФайлу - Строка - полный путь к файлу.
//  ТекстФайла - Строка - содержимое.
//  ИмяОбработчикаЗавершения - Строка - экспортная процедура формы, которая вызывается после записи.
//
&НаКлиенте
Процедура ЗаписатьФайл(Знач ПутьКФайлу, Знач ТекстФайла, Знач ИмяОбработчикаЗавершения)

	ДокументФайла = Новый ТекстовыйДокумент;
	ДокументФайла.УстановитьТекст(ТекстФайла);
	Оповещение = Новый ОписаниеОповещения(ИмяОбработчикаЗавершения, ЭтотОбъект, ПутьКФайлу,
		"ПриОшибкеЗаписиФайла", ЭтотОбъект);
	ДокументФайла.НачатьЗапись(Оповещение, ПутьКФайлу, "UTF-8");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиОтметкиЗапуска(Результат, ДополнительныеПараметры) Экспорт

	// Отметка записана; дальше работает чтение параметров.
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиФайлаРезультата(Результат, ДополнительныеПараметры) Экспорт

	ПоказатьСостояние("результат записан, закрываюсь");
	ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьРаботу", 0.5, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеЗаписиФайла(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой остановило бы клиент: текст - в заголовке формы, его снимет гейт.
	СтандартнаяОбработка = Ложь;
	ПоказатьСостояние(СтрШаблон("не удалось записать файл %1: %2", ДополнительныеПараметры,
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке)));
	Если ДополнительныеПараметры = ПутьКФайлуРезультата Тогда
		// Результата не будет: гейт увидит это по времени, клиент дольше не держим.
		ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьРаботу", 10, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗавершитьРаботу() Экспорт

	// Без вопроса пользователю и без обработчиков завершения работы.
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// Показывает, чем обработка занята: в заголовке формы и сообщением.
//
// Параметры:
//  ТекстСостояния - Строка - что происходит.
//
&НаКлиенте
Процедура ПоказатьСостояние(Знач ТекстСостояния)

	ПолныйТекст = "Действия после обновления: " + ТекстСостояния;
	ЭтотОбъект.АвтоЗаголовок = Ложь;
	ЭтотОбъект.Заголовок = ПолныйТекст;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ПолныйТекст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
