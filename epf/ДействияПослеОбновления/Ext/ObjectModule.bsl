// Действия после обновления: после загрузки расширений выполняет новые действия (то, что меняет данные
// и настройки базы) и записывает загрузку в историю. Версия 00000000.000000.
// ** Хлебников С.Ю. 20261120 Новая обработка гейта: исполнитель действий после обновления.
//
// Запуск (делает run.ps1):
//   1cv8c ENTERPRISE /S"сервер\база" /Execute "ДействияПослеОбновления.epf" /C"actions;in=<файл параметров>;out=<файл результата>"
//
// Действия вставляет гейт перед сборкой обработки, между метками @@ДЕЙСТВИЯ. Действие - процедура
// ДействиеN(Журнал) с телом из файла actions/<имя>.bsl; Журнал - Массив строк, гейт показывает их в итоге шага.
// Каждое действие - в своей транзакции, под исключительной управляемой блокировкой своей записи в регистре
// выполненных действий. Запись есть - действие не выполняется: так при двух одновременных запусках действие
// выполнит только один. Первое упавшее действие останавливает остальные: следующие могут на него опираться.
// История: при каждом запуске - запись в регистр истории загрузок, если он задан и есть в базе.
// Имена регистров - из файла параметров (настройки гейта ActionsRegister и HistoryRegister).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Выполняет новые действия и записывает историю загрузки.
//
// Параметры:
//  ТекстПараметров - Строка - строки «ключ=значение» файла параметров гейта:
//    done - имя регистра выполненных действий (измерение Действие);
//    history - имя регистра истории загрузок (измерения Момент и Номер);
//    run, commit, branch, gate, kind, items - сведения о загрузке для истории;
//    action - идентификатор действия, строка на действие, в порядке выполнения.
//
// Возвращаемое значение:
//  Строка - строки файла результата «ключ=значение»; последняя - status=ok, failed или error.
//
Функция ВыполнитьПоТекстуПараметров(Знач ТекстПараметров) Экспорт

	Параметры = ПараметрыИзТекста(ТекстПараметров);
	Результат = Новый Массив;
	Результат.Добавить("actions=" + ВерсияОбработки());

	// Обработка должна быть собрана ровно из тех действий, которые ждёт гейт: иначе это чужая или старая сборка.
	Собранные = СписокДействий();
	Если СтрСоединить(Собранные, ",") <> СтрСоединить(Параметры.Действия, ",") Тогда
		Результат.Добавить("error=обработка собрана с другим списком действий: " + СтрСоединить(Собранные, ", "));
		Результат.Добавить("status=error");
		Возврат СтрСоединить(Результат, Символы.ПС);
	КонецЕсли;

	ИмяРегистра = Параметры.РегистрВыполненных;
	ОшибкаРегистра = ОшибкаРегистраВыполненных(ИмяРегистра);
	Если ПустаяСтрока(ОшибкаРегистра) Тогда
		Результат.Добавить("done-register=ok");
	Иначе
		Результат.Добавить("done-register=" + ОшибкаРегистра);
	КонецЕсли;

	Итог = "ok";
	Выполнено = 0;
	БылиРаньше = 0;
	Для Номер = 1 По Собранные.Количество() Цикл
		Ид = Собранные[Номер - 1];
		Если Итог <> "ok" Или Не ПустаяСтрока(ОшибкаРегистра) Тогда
			Итог = "failed";
			Результат.Добавить("action=" + Ид + "|notrun");
			Продолжить;
		КонецЕсли;
		Исход = ВыполнитьДействие(Номер, Ид, ИмяРегистра, Параметры, Результат);
		Если Исход = "done" Тогда
			Выполнено = Выполнено + 1;
		ИначеЕсли Исход = "already" Тогда
			БылиРаньше = БылиРаньше + 1;
		Иначе
			Итог = "failed";
		КонецЕсли;
	КонецЦикла;

	Если Итог = "ok" Тогда
		ИтогДляИстории = СтрШаблон("действий выполнено: %1, выполнены раньше: %2", Выполнено, БылиРаньше);
	Иначе
		ИтогДляИстории = СтрШаблон("действия не выполнены до конца: выполнено %1, выполнены раньше %2", Выполнено, БылиРаньше);
	КонецЕсли;
	Результат.Добавить("history=" + ЗаписьИстории(Параметры, ИтогДляИстории));
	Результат.Добавить("status=" + Итог);
	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВерсияОбработки()

	Возврат "00000000.000000";

КонецФункции

// Разбирает файл параметров гейта.
//
// Параметры:
//  ТекстПараметров - Строка - строки «ключ=значение».
//
// Возвращаемое значение:
//  Структура - РегистрВыполненных, РегистрИстории, Прогон, Коммит, Ветка, ВерсияГейта, Вид, Состав (Строка),
//              Действия (Массив из Строка).
//
Функция ПараметрыИзТекста(Знач ТекстПараметров)

	Параметры = Новый Структура;
	Параметры.Вставить("РегистрВыполненных", "");
	Параметры.Вставить("РегистрИстории", "");
	Параметры.Вставить("Прогон", "");
	Параметры.Вставить("Коммит", "");
	Параметры.Вставить("Ветка", "");
	Параметры.Вставить("ВерсияГейта", "");
	Параметры.Вставить("Вид", "");
	Параметры.Вставить("Состав", "");
	Параметры.Вставить("Действия", Новый Массив);

	Ключи = Новый Соответствие;
	Ключи.Вставить("done", "РегистрВыполненных");
	Ключи.Вставить("history", "РегистрИстории");
	Ключи.Вставить("run", "Прогон");
	Ключи.Вставить("commit", "Коммит");
	Ключи.Вставить("branch", "Ветка");
	Ключи.Вставить("gate", "ВерсияГейта");
	Ключи.Вставить("kind", "Вид");
	Ключи.Вставить("items", "Состав");

	Для Каждого СтрокаПараметров Из СтрРазделить(ТекстПараметров, Символы.ПС, Ложь) Цикл
		СтрокаБезПробелов = СокрЛП(СтрЗаменить(СтрокаПараметров, Символы.ВК, ""));
		ПозицияРавно = СтрНайти(СтрокаБезПробелов, "=");
		Если ПозицияРавно < 2 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(Лев(СтрокаБезПробелов, ПозицияРавно - 1));
		Значение = Сред(СтрокаБезПробелов, ПозицияРавно + 1);
		Если Ключ = "action" Тогда
			Параметры.Действия.Добавить(Значение);
		ИначеЕсли Ключи[Ключ] <> Неопределено Тогда
			Параметры[Ключи[Ключ]] = Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Параметры;

КонецФункции

// Что не так с регистром выполненных действий.
//
// Параметры:
//  ИмяРегистра - Строка - имя регистра сведений.
//
// Возвращаемое значение:
//  Строка - пусто - регистр годится; notset, missing, nodimension - что не так.
//
Функция ОшибкаРегистраВыполненных(Знач ИмяРегистра)

	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат "notset";
	КонецЕсли;
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат "missing";
	КонецЕсли;
	Если МетаданныеРегистра.Измерения.Найти("Действие") = Неопределено Тогда
		Возврат "nodimension";
	КонецЕсли;
	Возврат "";

КонецФункции

// Выполняет одно действие, если его ещё нет в регистре выполненных, и дописывает исход в результат.
//
// Параметры:
//  Номер - Число - номер действия в сборке.
//  Ид - Строка - идентификатор действия.
//  ИмяРегистра - Строка - регистр выполненных действий.
//  Параметры - см. ПараметрыИзТекста.
//  Результат - Массив из Строка - строки файла результата.
//
// Возвращаемое значение:
//  Строка - done (выполнено сейчас), already (выполнено раньше), failed.
//
Функция ВыполнитьДействие(Знач Номер, Знач Ид, Знач ИмяРегистра, Знач Параметры, Результат)

	Журнал = Новый Массив;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		БылоРаньше = ВыполнитьДействиеВТранзакции(Номер, Ид, ИмяРегистра, Параметры, Журнал);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Действия после обновления'"), УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон(НСтр("ru = 'Действие %1 не выполнено: %2'"), Ид, ТекстОшибки));
		ДобавитьЖурналДействия(Результат, Ид, Журнал);
		Результат.Добавить("action=" + Ид + "|failed|" + ОднойСтрокой(ТекстОшибки));
		Возврат "failed";
	КонецПопытки;

	ДобавитьЖурналДействия(Результат, Ид, Журнал);
	Если БылоРаньше Тогда
		Результат.Добавить("action=" + Ид + "|already");
		Возврат "already";
	КонецЕсли;
	Результат.Добавить("action=" + Ид + "|done|" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧН=0; ЧГ=0"));
	Возврат "done";

КонецФункции

// Транзакция одного действия: блокировка своей записи в регистре выполненных, проверка «уже выполнено»,
// само действие и запись о нём. Ошибка - транзакция отменяется целиком, записи о выполнении нет.
//
// Параметры:
//  Номер - Число - номер действия в сборке.
//  Ид - Строка - идентификатор действия.
//  ИмяРегистра - Строка - регистр выполненных действий.
//  Параметры - см. ПараметрыИзТекста.
//  Журнал - Массив из Строка - строки, которые добавляет действие.
//
// Возвращаемое значение:
//  Булево - Истина - действие было выполнено раньше, сейчас не выполнялось.
//
Функция ВыполнитьДействиеВТранзакции(Знач Номер, Знач Ид, Знач ИмяРегистра, Знач Параметры, Журнал)

	БылоРаньше = Ложь;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений." + ИмяРегистра);
		ЭлементБлокировки.УстановитьЗначение("Действие", Ид);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		БылоРаньше = ДействиеВыполнено(ИмяРегистра, Ид);
		Если Не БылоРаньше Тогда
			ВыполнитьДействиеПоНомеру(Номер, Журнал);
			ЗаписатьВыполненное(ИмяРегистра, Ид, Параметры);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат БылоРаньше;

КонецФункции

Функция ДействиеВыполнено(Знач ИмяРегистра, Знач Ид)

	Запрос = Новый Запрос;
	// ** Хлебников С.Ю. 20261123 Для проверки записи используем допустимый псевдоним поля.
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК ЗаписьНайдена
	|ИЗ
	|	РегистрСведений." + ИмяРегистра + " КАК Выполненные
	|ГДЕ
	|	Выполненные.Действие = &Действие";
	// ** Хлебников С.Ю. 20261123 конец
	Запрос.УстановитьПараметр("Действие", Ид);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура ЗаписатьВыполненное(Знач ИмяРегистра, Знач Ид, Знач Параметры)

	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Отбор.Действие.Установить(Ид);
	Запись = Набор.Добавить();
	Запись.Действие = Ид;
	Значения = Новый Структура;
	Значения.Вставить("Момент", ТекущаяДатаСеанса());
	Значения.Вставить("Пользователь", ИмяПользователя());
	Значения.Вставить("Прогон", Параметры.Прогон);
	Значения.Вставить("Коммит", Параметры.Коммит);
	Значения.Вставить("ВерсияГейта", Параметры.ВерсияГейта);
	ЗаполнитьПоляЗаписи(Запись, МетаданныеРегистра, Значения);
	Набор.Записать();

КонецПроцедуры

// Записывает загрузку в регистр истории.
//
// Параметры:
//  Параметры - см. ПараметрыИзТекста.
//  ИтогДляИстории - Строка - что сделали действия.
//
// Возвращаемое значение:
//  Строка - ok, notset (регистр не задан), missing (регистра нет в базе), error|<текст>.
//
Функция ЗаписьИстории(Знач Параметры, Знач ИтогДляИстории)

	ИмяРегистра = Параметры.РегистрИстории;
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат "notset";
	КонецЕсли;
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат "missing";
	КонецЕсли;
	Если МетаданныеРегистра.Измерения.Найти("Момент") = Неопределено
		Или МетаданныеРегистра.Измерения.Найти("Номер") = Неопределено Тогда
		Возврат "error|в регистре " + ИмяРегистра + " нет измерений Момент и Номер";
	КонецЕсли;

	Значения = Новый Структура;
	Значения.Вставить("Вид", Параметры.Вид);
	Значения.Вставить("Коммит", Параметры.Коммит);
	Значения.Вставить("Ветка", Параметры.Ветка);
	Значения.Вставить("ВерсияГейта", Параметры.ВерсияГейта);
	Значения.Вставить("Прогон", Параметры.Прогон);
	Значения.Вставить("Состав", Параметры.Состав);
	Значения.Вставить("Пользователь", ИмяПользователя());
	Значения.Вставить("Итог", ИтогДляИстории);
	Попытка
		ЗаписатьИсторию(ИмяРегистра, МетаданныеРегистра, Значения);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Действия после обновления'"), УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон(НСтр("ru = 'История загрузки не записана: %1'"), ТекстОшибки));
		Возврат "error|" + ОднойСтрокой(ТекстОшибки);
	КонецПопытки;
	Возврат "ok";

КонецФункции

Процедура ЗаписатьИсторию(Знач ИмяРегистра, Знач МетаданныеРегистра, Знач Значения)

	Момент = ТекущаяДатаСеанса();
	НачатьТранзакцию();
	Попытка
		// Две записи в одну секунду различает Номер: следующий за последним - под блокировкой этой секунды.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений." + ИмяРегистра);
		ЭлементБлокировки.УстановитьЗначение("Момент", Момент);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(История.Номер), 0) КАК Номер
		|ИЗ
		|	РегистрСведений." + ИмяРегистра + " КАК История
		|ГДЕ
		|	История.Момент = &Момент";
		Запрос.УстановитьПараметр("Момент", Момент);
		Выборка = Запрос.Выполнить().Выбрать();
		Номер = 1;
		Если Выборка.Следующий() Тогда
			Номер = Выборка.Номер + 1;
		КонецЕсли;

		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор.Момент.Установить(Момент);
		Набор.Отбор.Номер.Установить(Номер);
		Запись = Набор.Добавить();
		Запись.Момент = Момент;
		Запись.Номер = Номер;
		ЗаполнитьПоляЗаписи(Запись, МетаданныеРегистра, Значения);
		Набор.Записать();

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Заполняет поля записи, которые есть в регистре: реквизиты и ресурсы с такими именами. Остальное пропускается -
// у площадки регистр может быть короче.
//
// Параметры:
//  Запись - РегистрСведенийЗапись - запись набора.
//  МетаданныеРегистра - ОбъектМетаданных - регистр сведений.
//  Значения - Структура - имя поля и значение.
//
Процедура ЗаполнитьПоляЗаписи(Запись, Знач МетаданныеРегистра, Знач Значения)

	Для Каждого Поле Из Значения Цикл
		Если МетаданныеРегистра.Реквизиты.Найти(Поле.Ключ) <> Неопределено
			Или МетаданныеРегистра.Ресурсы.Найти(Поле.Ключ) <> Неопределено Тогда
			Запись[Поле.Ключ] = Поле.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЖурналДействия(Результат, Знач Ид, Знач Журнал)

	Для Каждого СтрокаЖурнала Из Журнал Цикл
		Результат.Добавить("log=" + Ид + "|" + ОднойСтрокой(Строка(СтрокаЖурнала)));
	КонецЦикла;

КонецПроцедуры

Функция ОднойСтрокой(Знач Текст)

	Возврат СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, " ");

КонецФункции

