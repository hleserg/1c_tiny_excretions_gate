// Канарейка: проверка, что сеанс запускается и расширения применились.
// Версия 00000000.000000.
//
// Запуск (делает run.ps1):
//   1cv8c ENTERPRISE /S"сервер\база" /Execute "Канарейка.epf" /C"canary;out=<файл результата>;wait=<секунд>"
//
// Сразу после открытия обработка пишет файл-отметку <файл результата>.started,
// через <секунд> записывает файл результата и завершает работу 1С.
// Что обработка делает сейчас, видно в заголовке формы и в сообщениях.
// Если в параметре запуска нет слова canary, обработка ничего не делает.
// В базу обработка не пишет.
// ** Хлебников С.Ю. 20261117 В файл результата добавлены чужие сеансы базы и активные фоновые задания:
// по ним гейт объясняет, что мешает монопольному доступу при обновлении конфигурации БД.
// ** Хлебников С.Ю. 20261117 Экран канарейки: вместо пустой формы - поле HTML с анимированной птичкой
// и тем, что она делает (ждёт, зовёт сервер, пишет результат, улетает). См. область ЭкранКанарейки.

#Область ОписаниеПеременных

&НаКлиенте
Перем ПутьКФайлуРезультата;

// ** Хлебников С.Ю. 20261117 Демонстрация (параметр demo): канарейка только показывает экран, сервер не зовёт,
// итог - случайно успех или провал. Нужна кнопке «Показать канарейку» в настройках гейта.
&НаКлиенте
Перем РежимДемонстрации;
// ** Хлебников С.Ю. 20261117 конец

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПараметрыКанарейки = ПараметрыКанарейкиИзСтрокиЗапуска(ПараметрЗапуска);
	Если ПараметрыКанарейки = Неопределено Тогда
		// ** Хлебников С.Ю. 20261117 Экран канарейки: птичка сидит, ничего не делает
		ТекстСостояния = СтрШаблон("запуск не канареечный, ничего не делаю. Параметр запуска: [%1]",
			ПараметрЗапуска);
		ЭкранКанарейки = СтраницаКанарейки("idle", 0, ТекстСостояния);
		ПоказатьСостояние(ТекстСостояния);
		// ** Хлебников С.Ю. 20261117 конец
		Возврат;
	КонецЕсли;

	ПутьКФайлуРезультата = ПараметрыКанарейки.ПутьКФайлу;
	РежимДемонстрации = ПараметрыКанарейки.Демонстрация; // ** Хлебников С.Ю. 20261117 Режим demo
	// ** Хлебников С.Ю. 20261117 Экран канарейки: птичка ждёт, на экране обратный отсчёт паузы
	ТекстСостояния = СтрШаблон("жду %1 с, результат запишу в %2", ПараметрыКанарейки.Пауза,
		ПутьКФайлуРезультата);
	ЭкранКанарейки = СтраницаКанарейки("wait", ПараметрыКанарейки.Пауза, ТекстСостояния);
	ПоказатьСостояние(ТекстСостояния);
	// ** Хлебников С.Ю. 20261117 конец

	// Отметка «обработка открылась и разобрала параметр запуска»: по ней скрипт понимает, докуда дошло.
	ЗаписатьФайл(ПутьКФайлуРезультата + ".started", "started=" + ВерсияКанарейки(), "ПослеЗаписиОтметкиЗапуска");

	// Пауза нужна, чтобы успела отработать отложенная часть запуска программы.
	ПодключитьОбработчикОжидания("Подключаемый_ЗаписатьРезультатИЗавершитьРаботу", ПараметрыКанарейки.Пауза, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает параметр запуска вида "canary;out=C:\папка\файл.txt;wait=10".
//
// Параметры:
//  СтрокаЗапуска - Строка - значение параметра запуска /C.
//
// Возвращаемое значение:
//  Структура, Неопределено - ПутьКФайлу (Строка) и Пауза (Число, секунды);
//                            Неопределено, если запуск не канареечный.
//
&НаКлиенте
Функция ПараметрыКанарейкиИзСтрокиЗапуска(Знач СтрокаЗапуска)

	ЭтоКанарейка = Ложь;
	ПутьКФайлу = "";
	Пауза = 10;
	Демонстрация = Ложь; // ** Хлебников С.Ю. 20261117 Режим demo

	Для Каждого ЧастьСтрокиЗапуска Из СтрРазделить(СтрокаЗапуска, ";", Ложь) Цикл

		Часть = СокрЛП(ЧастьСтрокиЗапуска);
		ЧастьНРег = НРег(Часть);

		Если ЧастьНРег = "canary" Тогда
			ЭтоКанарейка = Истина;
		// ** Хлебников С.Ю. 20261117 Режим demo
		ИначеЕсли ЧастьНРег = "demo" Тогда
			Демонстрация = Истина;
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "out=") Тогда
			ПутьКФайлу = Сред(Часть, 5);
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "wait=") Тогда
			Попытка
				Пауза = Макс(1, Число(Сред(Часть, 6)));
			Исключение
				// В параметре не число: остаётся пауза по умолчанию.
				Пауза = 10;
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	Если Не ЭтоКанарейка Или ПустаяСтрока(ПутьКФайлу) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("ПутьКФайлу, Пауза, Демонстрация", ПутьКФайлу, Пауза, Демонстрация);

КонецФункции

&НаКлиенте
Процедура Подключаемый_ЗаписатьРезультатИЗавершитьРаботу()

	// ** Хлебников С.Ю. 20261117 Демонстрация: сервер не зовётся, итог - через несколько секунд, случайный
	Если РежимДемонстрации = Истина Тогда
		ПоказатьСостояние("проверяю вход (демонстрация)", "server");
		ПодключитьОбработчикОжидания("Подключаемый_ИтогДемонстрации", 4, Истина);
		Возврат;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	ПоказатьСостояние("вызываю сервер", "server");

	Попытка
		ТекстРезультата = "status=ok" + Символы.ПС + СведенияОСеансеНаСервере();
	Исключение
		ТекстРезультата = "status=servererror" + Символы.ПС + "error="
			+ СтрЗаменить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " ");
	КонецПопытки;

	// ** Хлебников С.Ю. 20261117 Вид состояния для экрана: ok - сервер ответил, error - нет
	ПоказатьСостояние("пишу результат в " + ПутьКФайлуРезультата, ?(СтрНачинаетсяС(ТекстРезультата, "status=ok"), "write", "error"));
	// ** Хлебников С.Ю. 20261117 конец
	ЗаписатьФайл(ПутьКФайлуРезультата, ТекстРезультата, "ПослеЗаписиФайлаРезультата");

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Итог демонстрации: случайно успех (птичка улетает) или провал (сидит понуро).
// В файл ничего не пишется, через несколько секунд 1С закрывается.
&НаКлиенте
Процедура Подключаемый_ИтогДемонстрации() Экспорт

	Генератор = Новый ГенераторСлучайныхЧисел;
	Если Генератор.СлучайноеЧисло(0, 1) = 1 Тогда
		ПоказатьСостояние("вход прошёл, расширения применились (демонстрация)", "write");
		ПодключитьОбработчикОжидания("Подключаемый_УлететьВДемонстрации", 2, Истина);
	Иначе
		ПоказатьСостояние("вход не удался (демонстрация провала)", "error");
		ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьРаботу", 7, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УлететьВДемонстрации() Экспорт

	ПоказатьСостояние("всё хорошо, улетаю (демонстрация)", "done");
	ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьРаботу", 1.5, Истина);

КонецПроцедуры
// ** Хлебников С.Ю. 20261117 конец

// Записывает текстовый файл на компьютере клиента без модальных и синхронных вызовов.
//
// Параметры:
//  ПутьКФайлу - Строка - полный путь к файлу.
//  ТекстФайла - Строка - содержимое.
//  ИмяОбработчикаЗавершения - Строка - экспортная процедура формы, которая вызывается после записи.
//
&НаКлиенте
Процедура ЗаписатьФайл(Знач ПутьКФайлу, Знач ТекстФайла, Знач ИмяОбработчикаЗавершения)

	ДокументФайла = Новый ТекстовыйДокумент;
	ДокументФайла.УстановитьТекст(ТекстФайла);

	Оповещение = Новый ОписаниеОповещения(ИмяОбработчикаЗавершения, ЭтотОбъект, ПутьКФайлу,
		"ПриОшибкеЗаписиФайла", ЭтотОбъект);
	ДокументФайла.НачатьЗапись(Оповещение, ПутьКФайлу, "UTF-8");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиОтметкиЗапуска(Результат, ДополнительныеПараметры) Экспорт

	// Отметка записана, делать больше нечего: работу продолжит обработчик ожидания.
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиФайлаРезультата(Результат, ДополнительныеПараметры) Экспорт

	// ** Хлебников С.Ю. 20261117 Птичка улетает полторы секунды, потом работа 1С завершается
	ПоказатьСостояние("результат записан, улетаю", "done");
	ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьРаботу", 1.5, Истина);

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Завершение работы после того, как птичка улетела.
&НаКлиенте
Процедура Подключаемый_ЗавершитьРаботу() Экспорт

	// Без вопроса пользователю и без обработчиков завершения работы.
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры
// ** Хлебников С.Ю. 20261117 конец

&НаКлиенте
Процедура ПриОшибкеЗаписиФайла(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой остановило бы клиент, поэтому текст показываем в заголовке формы: его снимет скрипт.
	СтандартнаяОбработка = Ложь;
	ПоказатьСостояние(СтрШаблон("не удалось записать файл %1: %2",
		ДополнительныеПараметры, КраткоеПредставлениеОшибки(ИнформацияОбОшибке)), "error");

КонецПроцедуры

// Показывает, чем обработка занята: в заголовке формы, сообщением и на экране канарейки.
//
// Параметры:
//  ТекстСостояния - Строка - что происходит.
//  ВидСостояния - Строка - для экрана: wait, server, write, done, error; пусто - вид не меняется.
//
&НаКлиенте
Процедура ПоказатьСостояние(Знач ТекстСостояния, Знач ВидСостояния = "")

	ПолныйТекст = "Канарейка " + ВерсияКанарейки() + ": " + ТекстСостояния;

	ЭтотОбъект.АвтоЗаголовок = Ложь;
	ЭтотОбъект.Заголовок = ПолныйТекст;

	// ** Хлебников С.Ю. 20261117 Экран канарейки
	ОбновитьЭкранКанарейки(ТекстСостояния, ВидСостояния);
	// ** Хлебников С.Ю. 20261117 конец

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ПолныйТекст;
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВерсияКанарейки()

	Возврат "00000000.000000";

КонецФункции

// Собирает сведения о сеансе: пользователь, конфигурация, расширения базы и их состояние в сеансе.
//
// Возвращаемое значение:
//  Строка - строки вида "ключ=значение". Для расширений: "ext=Имя|Версия|Состояние",
//           где Состояние: active - применено в сеансе, disabled - выключено в списке расширений,
//           NOT_APPLIED - включено, но в сеансе не применилось.
//
&НаСервереБезКонтекста
Функция СведенияОСеансеНаСервере()

	Сведения = Новый Массив;
	Сведения.Добавить("canary=" + ВерсияКанарейки());
	Сведения.Добавить("time=" + XMLСтрока(ТекущаяДатаСеанса()));
	Сведения.Добавить("user=" + ИмяПользователя());
	Сведения.Добавить("config=" + Метаданные.Имя + " " + Метаданные.Версия);
	Сведения.Добавить("base=" + СтрокаСоединенияИнформационнойБазы());

	Попытка

		УстановитьПривилегированныйРежим(Истина);
		РасширенияБазы = РасширенияКонфигурации.Получить();
		РасширенияСеанса = РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные);
		УстановитьПривилегированныйРежим(Ложь);

		ИменаРасширенийСеанса = Новый Соответствие;
		Для Каждого РасширениеСеанса Из РасширенияСеанса Цикл
			ИменаРасширенийСеанса.Вставить(РасширениеСеанса.Имя, Истина);
		КонецЦикла;

		Для Каждого РасширениеБазы Из РасширенияБазы Цикл

			Если Не РасширениеБазы.Активно Тогда
				Состояние = "disabled";
			ИначеЕсли ИменаРасширенийСеанса.Получить(РасширениеБазы.Имя) = Истина Тогда
				Состояние = "active";
			Иначе
				Состояние = "NOT_APPLIED";
			КонецЕсли;

			Сведения.Добавить("ext=" + РасширениеБазы.Имя + "|" + РасширениеБазы.Версия + "|" + Состояние);

		КонецЦикла;

	Исключение
		// Обычному пользователю список расширений может быть недоступен: вход всё равно считается успешным.
		Сведения.Добавить("exterror="
			+ СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " "));
	КонецПопытки;

	// ** Хлебников С.Ю. 20261117 Сеансы и фоновые задания для гейта
	ДобавитьСеансыИФоновыеЗадания(Сведения);
	// ** Хлебников С.Ю. 20261117 конец

	Возврат СтрСоединить(Сведения, Символы.ПС);

КонецФункции

// ** Хлебников С.Ю. 20261117 Сеансы и фоновые задания для гейта
// Дописывает в сведения чужие сеансы базы и активные фоновые задания. Нужны права администратора;
// если списки недоступны, пишется строка sessionserror.
//
// Строки:
//  session=Номер|Приложение|Начало|Пользователь|Компьютер|ФоновоеЗадание
//  job=Наименование/ИмяМетода/Начало/РегламентноеЗадание
//
// Параметры:
//  Сведения - Массив - строки «ключ=значение», в который добавляются строки.
//
&НаСервереБезКонтекста
Процедура ДобавитьСеансыИФоновыеЗадания(Сведения)

	Попытка

		УстановитьПривилегированныйРежим(Истина);
		НомерСвоегоСеанса = НомерСеансаИнформационнойБазы();
		СеансыБазы = ПолучитьСеансыИнформационнойБазы();

		Для Каждого СеансБазы Из СеансыБазы Цикл

			Если СеансБазы.НомерСеанса = НомерСвоегоСеанса Тогда
				Продолжить;
			КонецЕсли;

			ИмяПользователяСеанса = "";
			Если СеансБазы.Пользователь <> Неопределено Тогда
				ИмяПользователяСеанса = СеансБазы.Пользователь.Имя;
			КонецЕсли;

			ЗаданиеСеанса = "";
			Попытка
				ФоновоеЗаданиеСеанса = СеансБазы.ПолучитьФоновоеЗадание();
				Если ФоновоеЗаданиеСеанса <> Неопределено Тогда
					ЗаданиеСеанса = ОписаниеФоновогоЗадания(ФоновоеЗаданиеСеанса);
				КонецЕсли;
			Исключение
				// Сеанс не отдал своё фоновое задание: остаётся общий список заданий ниже.
				ЗаданиеСеанса = "";
			КонецПопытки;

			ЧастиСтроки = Новый Массив;
			ЧастиСтроки.Добавить(Формат(СеансБазы.НомерСеанса, "ЧГ=0"));
			ЧастиСтроки.Добавить(ЗначениеДляФайла(СеансБазы.ИмяПриложения));
			ЧастиСтроки.Добавить(Формат(СеансБазы.НачалоСеанса, "ДФ='yyyy-MM-dd HH:mm:ss'"));
			ЧастиСтроки.Добавить(ЗначениеДляФайла(ИмяПользователяСеанса));
			ЧастиСтроки.Добавить(ЗначениеДляФайла(СеансБазы.ИмяКомпьютера));
			ЧастиСтроки.Добавить(ЗаданиеСеанса);
			Сведения.Добавить("session=" + СтрСоединить(ЧастиСтроки, "|"));

		КонецЦикла;

		ОтборЗаданий = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);
		АктивныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(ОтборЗаданий);
		Для Каждого АктивноеЗадание Из АктивныеЗадания Цикл
			Сведения.Добавить("job=" + ОписаниеФоновогоЗадания(АктивноеЗадание));
		КонецЦикла;

		УстановитьПривилегированныйРежим(Ложь);

	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Сведения.Добавить("sessionserror="
			+ СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " "));
	КонецПопытки;

КонецПроцедуры

// Описание фонового задания одной строкой: Наименование/ИмяМетода/Начало/РегламентноеЗадание.
//
// Параметры:
//  Задание - ФоновоеЗадание - задание.
//
// Возвращаемое значение:
//  Строка - описание; регламентное задание - имя в метаданных или пусто.
//
&НаСервереБезКонтекста
Функция ОписаниеФоновогоЗадания(Задание)

	ИмяРегламентногоЗадания = "";
	Если Задание.РегламентноеЗадание <> Неопределено Тогда
		ИмяРегламентногоЗадания = Задание.РегламентноеЗадание.Метаданные.Имя;
	КонецЕсли;

	ЧастиОписания = Новый Массив;
	ЧастиОписания.Добавить(ЗначениеДляФайла(Задание.Наименование));
	ЧастиОписания.Добавить(ЗначениеДляФайла(Задание.ИмяМетода));
	ЧастиОписания.Добавить(Формат(Задание.Начало, "ДФ='yyyy-MM-dd HH:mm:ss'"));
	ЧастиОписания.Добавить(ЗначениеДляФайла(ИмяРегламентногоЗадания));
	Возврат СтрСоединить(ЧастиОписания, "/");

КонецФункции

// Значение для строки файла: без переводов строк и разделителей.
//
// Параметры:
//  Значение - Произвольный - значение.
//
// Возвращаемое значение:
//  Строка - текст без «|», «/» и переводов строк.
//
&НаСервереБезКонтекста
Функция ЗначениеДляФайла(Значение)

	ТекстЗначения = Строка(Значение);
	ТекстЗначения = СтрЗаменить(ТекстЗначения, "|", " ");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, "/", " ");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, Символы.ПС, " ");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, Символы.ВК, " ");
	Возврат СокрЛП(ТекстЗначения);

КонецФункции
