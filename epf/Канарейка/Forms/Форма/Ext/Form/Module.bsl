#КонецОбласти

// ** Хлебников С.Ю. 20261117 Экран канарейки: поле HTML с анимированной птичкой.
// Вид состояния - класс у страницы, текст - строка под птичкой. Страница обновляется вызовом ciState внутри
// страницы; не получилось (страница ещё грузится) - текст и вид сохраняются в документе при следующей записи.
#Область ЭкранКанарейки

// Обновляет экран: вид и текст состояния.
//
// Параметры:
//  ТекстСостояния - Строка - что происходит.
//  ВидСостояния - Строка - wait, server, write, done, error, idle; пусто - не меняется.
//
&НаКлиенте
Процедура ОбновитьЭкранКанарейки(Знач ТекстСостояния, Знач ВидСостояния)

	Попытка
		ДокументСтраницы = Элементы.ЭкранКанарейки.Документ;
		Попытка
			ОкноСтраницы = ДокументСтраницы.defaultView;
		Исключение
			ОкноСтраницы = ДокументСтраницы.parentWindow;
		КонецПопытки;
		ОкноСтраницы.ciState(ВидСостояния, ТекстСостояния);
	Исключение
		// Страница ещё не загрузилась: текст состояния виден в заголовке и сообщениях, экран догонит позже.
		ОкноСтраницы = Неопределено;
	КонецПопытки;

КонецПроцедуры

// Возвращает страницу экрана канарейки.
//
// Параметры:
//  ВидСостояния - Строка - начальный вид: wait или idle.
//  Пауза - Число - секунд до записи результата, для обратного отсчёта.
//  ТекстСостояния - Строка - строка под птичкой.
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
&НаКлиенте
Функция СтраницаКанарейки(ВидСостояния, Пауза, ТекстСостояния)

	// Провал (error) - по-мультяшному: дрожит, глаза крестиком, переворачивается и падает с жёрдочки,
	// перья кружатся, душа с нимбом улетает вверх.
	Стили = "html,body{margin:0;height:100%;overflow:hidden}"
		+ "body{background:linear-gradient(180deg,#bfe3ff 0%,#e8f6ff 70%,#f6fbff 100%);"
		+ "font:14px/1.4 'Segoe UI',Arial,sans-serif;color:#24324a}"
		+ ".sky{position:absolute;left:0;top:0;right:0;bottom:0;overflow:hidden}"
		+ ".cloud{position:absolute;background:#fff;border-radius:40px;opacity:.85;animation:drift linear infinite}"
		+ ".cloud:before,.cloud:after{content:'';position:absolute;background:#fff;border-radius:50%}"
		+ ".c1{width:120px;height:34px;top:40px;animation-duration:38s}"
		+ ".c1:before{width:50px;height:50px;left:18px;top:-24px}"
		+ ".c1:after{width:60px;height:60px;left:50px;top:-32px}"
		+ ".c2{width:90px;height:26px;top:110px;animation-duration:52s;animation-delay:-20s;opacity:.6}"
		+ ".c2:before{width:40px;height:40px;left:14px;top:-20px}"
		+ ".c2:after{width:44px;height:44px;left:40px;top:-24px}"
		+ "@keyframes drift{from{transform:translateX(-160px)}to{transform:translateX(110vw)}}"
		+ ".stage{position:absolute;left:50%;top:46%;width:240px;height:200px;margin:-120px 0 0 -120px}"
		+ ".perch{position:absolute;left:10px;right:10px;top:150px;height:8px;border-radius:4px;background:#8a5a33;"
		+ "box-shadow:0 2px 0 #6b4426}"
		+ ".bird{position:absolute;left:62px;top:28px;width:120px;height:126px;transform-origin:50% 100%;"
		+ "animation:bob 1.2s ease-in-out infinite}"
		+ "@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}"
		+ ".wing{transform-origin:62px 70px;animation:flap .5s ease-in-out infinite}"
		+ "@keyframes flap{0%,100%{transform:rotate(0)}50%{transform:rotate(-14deg)}}"
		+ ".eye{animation:blink 4s infinite}"
		+ "@keyframes blink{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.1)}}"
		+ ".note{position:absolute;font-size:20px;color:#e0a100;opacity:0;animation:sing 2.4s ease-out infinite}"
		+ ".n1{left:170px;top:40px}.n2{left:186px;top:60px;animation-delay:.8s}"
		+ ".n3{left:160px;top:70px;animation-delay:1.6s}"
		+ "@keyframes sing{0%{opacity:0;transform:translate(0,0) rotate(0)}20%{opacity:1}"
		+ "100%{opacity:0;transform:translate(22px,-60px) rotate(20deg)}}"
		+ ".idle .note,.error .note{display:none}"
		+ ".server .bird{animation:peck .6s ease-in-out infinite}"
		+ "@keyframes peck{0%,100%{transform:rotate(0)}50%{transform:rotate(9deg) translateY(4px)}}"
		+ ".server .wing{animation-duration:.25s}"
		+ ".write .bird{animation:bob .6s ease-in-out infinite}"
		+ ".done .bird{animation:fly 1.5s ease-in forwards}.done .wing{animation-duration:.12s}"
		+ "@keyframes fly{0%{transform:translate(0,0)}25%{transform:translate(-10px,6px)}"
		+ "100%{transform:translate(520px,-320px) rotate(-18deg) scale(.6)}}"
		+ ".xeyes,.feather,.ghost{display:none}"
		+ ".error .eye{display:none}.error .xeyes{display:inline}.error .note{display:none}"
		+ ".error .bird{animation:die 2.8s ease-in .2s forwards}.error .wing{animation:none}"
		+ "@keyframes die{0%{transform:translate(0,0)}6%{transform:translate(-5px,0) rotate(-4deg)}"
		+ "12%{transform:translate(5px,0) rotate(4deg)}18%{transform:translate(-5px,0) rotate(-4deg)}"
		+ "24%{transform:translate(5px,0) rotate(4deg)}34%{transform:translate(0,-18px) rotate(-30deg)}"
		+ "50%{transform:translate(6px,-26px) rotate(-180deg)}"
		+ "100%{transform:translate(30px,420px) rotate(-200deg)}}"
		+ ".error .perch{animation:wobble .5s ease-in-out 1.2s 3}"
		+ "@keyframes wobble{0%,100%{transform:rotate(0)}50%{transform:rotate(3deg)}}"
		+ ".error .feather{display:block;position:absolute;width:14px;height:6px;border-radius:50%;"
		+ "background:#ffd23a;opacity:0;animation:feather 3.4s ease-in-out forwards}"
		+ ".f1{left:110px;top:60px;animation-delay:1.1s!important}"
		+ ".f2{left:140px;top:50px;animation-delay:1.3s!important}"
		+ ".f3{left:95px;top:80px;animation-delay:1.5s!important}"
		+ "@keyframes feather{0%{opacity:0;transform:translate(0,0) rotate(0)}10%{opacity:1}"
		+ "30%{transform:translate(-18px,40px) rotate(-40deg)}55%{transform:translate(16px,80px) rotate(30deg)}"
		+ "80%{opacity:.9;transform:translate(-12px,120px) rotate(-30deg)}"
		+ "100%{opacity:0;transform:translate(6px,150px) rotate(10deg)}}"
		+ ".error .ghost{display:block;position:absolute;left:92px;top:40px;width:60px;height:80px;opacity:0;"
		+ "animation:rise 3.2s ease-out 1.6s forwards}"
		+ "@keyframes rise{0%{opacity:0;transform:translateY(20px)}20%{opacity:.85}"
		+ "40%{transform:translate(-8px,-30px)}60%{transform:translate(8px,-60px)}"
		+ "100%{opacity:0;transform:translate(0,-130px)}}"
		+ ".error .ttl{color:#b03030;animation:sob 1s ease-in-out infinite}"
		+ "@keyframes sob{0%,100%{transform:translateY(0)}50%{transform:translateY(2px)}}"
		+ ".card{position:absolute;left:50%;top:46%;width:420px;margin:110px 0 0 -210px;text-align:center}"
		+ ".ttl{font-size:20px;font-weight:600;color:#1d2b44}"
		+ ".st{margin-top:6px;color:#3b4a66;min-height:20px;word-wrap:break-word}"
		+ ".cd{display:inline-block;margin-top:10px;padding:3px 12px;border-radius:12px;"
		+ "background:rgba(255,255,255,.75);"
		+ "color:#1d2b44;font-weight:600}"
		+ ".error .ttl{color:#b03030}.done .ttl{color:#1f8a52}"
		+ ".hidden{display:none}";

	Птичка = "<svg class=""bird"" viewBox=""0 0 120 126"">"
		+ "<path d=""M24 82 L2 96 L8 104 L30 92 Z"" fill=""#e0a100""/>"
		+ "<ellipse class=""body"" cx=""58"" cy=""78"" rx=""40"" ry=""34"" fill=""#ffd23a""/>"
		+ "<ellipse cx=""62"" cy=""90"" rx=""24"" ry=""16"" fill=""#ffe68a""/>"
		+ "<circle cx=""82"" cy=""42"" r=""24"" fill=""#ffd23a""/>"
		+ "<path class=""wing"" d=""M40 68 Q62 56 82 76 Q66 96 40 86 Z"" fill=""#f0b400""/>"
		+ "<path d=""M102 40 L118 46 L102 52 Z"" fill=""#ff8a1f""/>"
		+ "<g class=""eye"" style=""transform-origin:90px 38px"">"
		+ "<circle cx=""90"" cy=""38"" r=""4.5"" fill=""#1d2b44""/>"
		+ "<circle cx=""91.5"" cy=""36.5"" r=""1.4"" fill=""#fff""/></g>"
		+ "<g class=""xeyes"" stroke=""#1d2b44"" stroke-width=""2.6"" stroke-linecap=""round"">"
		+ "<path d=""M85 33 L95 43 M95 33 L85 43""/></g>"
		+ "<circle cx=""96"" cy=""50"" r=""4"" fill=""#ffb38a"" opacity="".7""/>"
		+ "<path d=""M50 110 L46 124 M50 110 L54 124 M70 110 L66 124 M70 110 L74 124"" stroke=""#8a5a33"""
		+ " stroke-width=""3"" stroke-linecap=""round""/>"
		+ "</svg>";

	Скрипт = "var ciLeft=" + Формат(Пауза, "ЧН=0; ЧГ=0") + ";"
		+ "var ciTitles={idle:'Канарейка отдыхает',wait:'Канарейка проверяет вход',server:'Зову сервер',"
		+ "write:'Сервер ответил, записываю',done:'Всё хорошо, улетаю',error:'Канарейка не выжила...'};"
		+ "function ciState(k,t){if(k){document.body.className=k;"
		+ "document.getElementById('ttl').innerHTML=ciTitles[k]||k;"
		+ "if(k!='wait'){document.getElementById('cd').className='cd hidden';}}"
		+ "if(t){document.getElementById('st').innerHTML=String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;');}"
		+ "return 1;}"
		+ "function ciTick(){if(document.body.className!='wait'||ciLeft<=0){return;}ciLeft--;"
		+ "document.getElementById('cd').innerHTML='осталось '+ciLeft+' с';}"
		+ "window.onload=function(){setInterval(ciTick,1000);};";

	Отсчет = "";
	Если ВидСостояния = "wait" Тогда
		Отсчет = "осталось " + Формат(Пауза, "ЧН=0; ЧГ=0") + " с";
	КонецЕсли;

	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8"">"
		+ "<meta http-equiv=""X-UA-Compatible"" content=""IE=edge""><style>" + Стили + "</style>"
		+ "<script>" + Скрипт + "</script></head><body class=""" + ВидСостояния + """>"
		+ "<div class=""sky""><div class=""cloud c1""></div><div class=""cloud c2""></div></div>"
		+ "<div class=""stage""><div class=""perch""></div>" + Птичка
		+ "<span class=""note n1"">&#9834;</span><span class=""note n2"">&#9835;</span>"
		+ "<span class=""note n3"">&#9834;</span>"
		+ "<i class=""feather f1""></i><i class=""feather f2""></i><i class=""feather f3""></i>"
		+ "<svg class=""ghost"" viewBox=""0 0 60 80"">"
		+ "<ellipse cx=""30"" cy=""12"" rx=""14"" ry=""4"" fill=""none"" stroke=""#ffcc33"" stroke-width=""3""/>"
		+ "<path d=""M10 74 L10 40 Q10 20 30 20 Q50 20 50 40 L50 74 L43 68 L36 74 L30 68 L24 74 L17 68 Z"""
