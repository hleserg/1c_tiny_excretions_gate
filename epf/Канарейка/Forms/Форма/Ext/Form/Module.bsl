		+ "<div class=""st"" id=""st"">" + ТекстДляСтраницы(ТекстСостояния) + "</div>"
		+ "<div class=""cd" + ?(ВидСостояния = "wait", "", " hidden")
		+ """ id=""cd"">" + Отсчет + "</div></div></body></html>";

КонецФункции

&НаКлиенте
Функция ТекстДляСтраницы(Знач Текст)

	Текст = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Возврат СтрЗаменить(Текст, ">", "&gt;");

КонецФункции

