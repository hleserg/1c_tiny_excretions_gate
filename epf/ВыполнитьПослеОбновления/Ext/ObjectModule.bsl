// Документы старше этой даты тесты не записывают и не проводят. Запись старого документа заставляет типовой код
// пересчитать оперативные взаиморасчёты по его объекту расчётов с даты документа до текущей: на прогоне 14.11
// перепроведение корректировки реализации от 31.01.2024 заняло больше десяти минут.
// Граница считается один раз за прогон (см. ГраницаДатыДокументов) и приходит в параметрах шага.
Функция ГраницаДатыДокументовДляЗаписи()

	Если ПараметрыЗапуска <> Неопределено
		И ПараметрыЗапуска.Свойство("ГраницаДатыДокументов")
		И ТипЗнч(ПараметрыЗапуска.ГраницаДатыДокументов) = Тип("Дата")
		И ЗначениеЗаполнено(ПараметрыЗапуска.ГраницаДатыДокументов) Тогда
		Возврат ПараметрыЗапуска.ГраницаДатыДокументов;
	КонецЕсли;

	Возврат ГраницаДатыДокументов();

КонецФункции

Функция ПояснениеОСтаромДокументе(ДатаДокумента)

	Возврат "последний проведённый документ от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy") + ", раньше "
		+ Формат(ГраницаДатыДокументовДляЗаписи(), "ДФ=dd.MM.yyyy") + " - " + ОписаниеГраницыДаты() + "."
		+ " Старые документы тест не записывает: это запускает пересчёт взаиморасчётов за весь период после документа."
		+ " Взять документы старше можно, указав дату в поле «Документы не старше».";

КонецФункции

// Возвращает пояснение, откуда взята граница даты документов: из поля формы или посчитана по данным базы.
Функция ОписаниеГраницыДаты()

	Если ПараметрыЗапуска <> Неопределено
		И ПараметрыЗапуска.Свойство("ГраницаЗаданаВручную")
		И ПараметрыЗапуска.ГраницаЗаданаВручную = Истина Тогда
		Возврат "даты из поля «Документы не старше»";
	КонецЕсли;

	Возврат "начала месяца самого нового документа базы";

КонецФункции

// Возвращает Истина, если вид документов перечислен в поле «Не проводить документы» формы.
Функция ДокументИсключен(ИмяДокумента)

	Если Не ПараметрыЗапуска.Свойство("НеПроводитьДокументы") Тогда
		Возврат Ложь;
	КонецЕсли;

	СписокИмен = СтрЗаменить(Строка(ПараметрыЗапуска.НеПроводитьДокументы), ";", ",");
	СписокИмен = СтрЗаменить(СписокИмен, Символы.ПС, ",");

	Для Каждого ИмяИзСписка Из СтрРазделить(СписокИмен, ",", Ложь) Цикл
		ИмяБезПрефикса = СтрЗаменить(СокрЛП(ИмяИзСписка), "Документ.", "");
		Если ВРег(ИмяБезПрефикса) = ВРег(ИмяДокумента) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Вторая линия защиты: вызывается в начале каждой процедуры, которая пишет в базу.
// Первая линия - проверки ЗаписьРазрешена и ПроведениеРазрешено в шагах.
Процедура ПроверитьЧтоЗаписьРазрешена()

	Если Не ЗаписьРазрешена() Тогда
		ВызватьИсключение "Тест пытался писать в базу, хотя запись запрещена: " + ПричинаЗапретаЗаписи() + ".";
	КонецЕсли;

КонецПроцедуры

Функция ЗаписьРазрешена()

	Возврат ПараметрыЗапуска.РазрешитьЗапись = Истина И БазаПохожаНаТестовую();

