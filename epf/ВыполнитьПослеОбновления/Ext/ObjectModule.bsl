Функция ПараметрСтрокиСоединения(СтрокаСоединения, ИмяПараметра)

	НачалоПараметра = СтрНайти(ВРег(СтрокаСоединения), ВРег(ИмяПараметра) + "=""");
	Если НачалоПараметра = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаСоединения, НачалоПараметра + СтрДлина(ИмяПараметра) + 2);
	КонецЗначения = СтрНайти(Остаток, """");
	Если КонецЗначения = 0 Тогда
		Возврат Остаток;
	КонецЕсли;

	Возврат Лев(Остаток, КонецЗначения - 1);

