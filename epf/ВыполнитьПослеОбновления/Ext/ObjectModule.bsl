#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// ** 20261113 Самопроверка после обновления расширений конфигурации.
// ** Хлебников С.Ю. 20261117 Обработка делится на ядро и пакеты сценариев.
//  Ядро - то, что годится для любой конфигурации на БСП: журнал, шаги и задания, окружение, платформенная
//  проверка применимости, компиляция модулей, операции со справочниками и документами, перепроведение и отмена
//  проведения в отменяемой транзакции, отключение почты на время проведения.
//  Пакет сценариев - всё, что относится к конкретной базе: какие расширения «наши», списки их объектов,
//  ожидаемые версии, шаги и сценарии доработок этой базы, её настройки. Ядро обращается к пакету только
//  через область ПакетыСценариев. Пакеты лежат отдельно (packages/<Имя>), сборщик src/build вставляет их на места
//  меток @@ПАКЕТЫ@@ и сам пишет область ПакетыСценариев и функцию ТекущийПакетСценариев. Пакет выбирается сам:
//  первый, чья функция ПакетПодходит<Имя> вернула Истина. Нет подходящего пакета - выполняется одно ядро.
//  Как написать пакет - docs/packages.md.
//
// Тесты разбиты на шаги. Форма обработки вызывает шаги по одному и собирает общий журнал.
// Каждый шаг пишет в журнал строки с пометками:
//  [ОК]       - проверка прошла;
//  [ОШИБКА]   - доработка ведёт себя не так, как задумано, либо модуль не компилируется;
//  [ВНИМАНИЕ] - результат получен, но его должен посмотреть человек;
//  [ПРОПУСК]  - проверку выполнить не удалось или она запрещена параметрами запуска;
//  [ИНФО]     - сведения для разбора журнала.
//
// В базу тесты пишут только внутри транзакции, которая всегда отменяется.
// Тесты с записью выполняются, только если имя базы похоже на тестовое (см. БазаПохожаНаТестовую).

#Область ОписаниеПеременных

Перем СтрокиЖурнала;
Перем СчетчикиЖурнала;
Перем ПараметрыЗапуска;
Перем ПакетСценариев; // ** Хлебников С.Ю. 20261117 выбранный пакет, см. ТекущийПакетСценариев
Перем СнимкиШага; // ** Хлебников С.Ю. 20261117 снимки шага для гейта, см. ЗаписатьСнимок

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает шаги серверной части тестирования в порядке выполнения.
//
// Возвращаемое значение:
//  Массив из Структура - шаги с ключами Имя и Представление.
//
Функция ШагиТестирования() Экспорт

	// ** Хлебников С.Ю. 20261117 Шаги ядра и шаги пакета вперемешку, в прежнем порядке: пакет добавляет свои шаги в места,
	// которые ему отводит ядро.
	Шаги = Новый Массив;
	ДобавитьШаг(Шаги, "Окружение", "Окружение и расширения");
	ДобавитьШагиПакета(Шаги, "ПослеОкружения");
	ДобавитьШаг(Шаги, "ПрименимостьРасширений", "Платформенная проверка применимости расширений");
	ДобавитьШагиПакета(Шаги, "ПослеПрименимости");
	ДобавитьШаг(Шаги, "КомпиляцияМодулей", "Компиляция серверных модулей расширений");
	ДобавитьШагиПакета(Шаги, "ПослеКомпиляции");
	ДобавитьШаг(Шаги, "ОперацииСоСправочниками", "Операции со справочниками: новый, проверка заполнения, запись, копия");
	ДобавитьШаг(Шаги, "ОперацииСДокументами", "Операции с документами: новый, проверка заполнения, копия, запись копии");
	ДобавитьШагиПакета(Шаги, "ПослеОпераций");
	ДобавитьШаг(Шаги, "Обмены", "Обмены: сообщения обмена для пары объектов по узлам, без отправки"); // ** Хлебников С.Ю. 20261117

	// Шаги, в которых проводятся и распроводятся реальные документы, идут последними: проведение одного документа
	// может длиться долго (пересчёт взаиморасчётов, чужие расширения), прервать серверный вызов нельзя.
	ДобавитьШаг(Шаги, "ПерепроведениеДокументов", "Перепроведение документов с модулями расширений");
	ДобавитьШаг(Шаги, "ОтменаПроведенияДокументов", "Отмена проведения документов с модулями расширений");
	// ** Хлебников С.Ю. 20261117 конец

	Возврат Шаги;

КонецФункции

// Выполняет один шаг тестирования.
//
// Параметры:
//  ИмяШага       - Строка - имя шага, см. ШагиТестирования.
//  ПараметрыШага - Структура - параметры запуска с ключами РазрешитьЗапись, ПроводитьДокументы,
//                  ОтключатьПочту, ПроверятьПрименимость, КоличествоДокументов. Необязательные ключи: Элемент -
//                  одна проверка из шага, см. ЗаданияТестирования; НеПроводитьДокументы - имена видов документов
//                  через запятую, которые тесты не записывают и не проводят; ГраницаДатыДокументов - дата,
//                  старше которой документы не проводятся, см. ГраницаДатыДокументов; ГраницаЗаданаВручную -
//                  Булево, Истина, если дата взята из поля формы «Документы не старше».
//
// Возвращаемое значение:
//  Структура - ключи Текст (строки журнала шага), ОК, Ошибок, Внимание, Пропусков, Снимки (Массив из Строка -
//               блоки снимков для гейта, см. ЗаписатьСнимок; пустой, если в параметрах нет Снимки = Истина).
//
Функция ВыполнитьШагТестирования(ИмяШага, ПараметрыШага) Экспорт

	СтрокиЖурнала = Новый Массив;
	СчетчикиЖурнала = Новый Структура("ОК, Ошибок, Внимание, Пропусков", 0, 0, 0, 0);
	ПараметрыЗапуска = ПараметрыШага;
	СнимкиШага = Новый Массив; // ** Хлебников С.Ю. 20261117

	НачалоШага = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Шаг можно выполнять по частям: в параметре Элемент передаётся одна проверка из шага
	// (см. ЗаданияТестирования). Тогда заголовок и итог шага выводит вызывающая сторона.
	ЭлементШага = "";
	Если ПараметрыШага.Свойство("Элемент") И ЗначениеЗаполнено(ПараметрыШага.Элемент) Тогда
		ЭлементШага = ПараметрыШага.Элемент;
	КонецЕсли;
	ШагЦеликом = ПустаяСтрока(ЭлементШага);

	Если ШагЦеликом Тогда
		СтрокиЖурнала.Добавить("");
		СтрокиЖурнала.Добавить("=== " + ПредставлениеШага(ИмяШага) + " ===");
	КонецЕсли;

	Если ТранзакцияАктивна() Тогда
		ЗаписатьОшибку("Шаг запущен внутри активной транзакции, тесты не выполняются.");
	Иначе
		Попытка
			ВыполнитьШаг(ИмяШага, ЭлементШага);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Пока ТранзакцияАктивна() Цикл
				ОтменитьТранзакцию();
			КонецЦикла;
			ЗаписатьОшибку("Шаг прерван исключением:" + Символы.ПС + ТекстОшибки);
		КонецПопытки;
	КонецЕсли;

	Если ТранзакцияАктивна() Тогда
		Пока ТранзакцияАктивна() Цикл
			ОтменитьТранзакцию();
		КонецЦикла;
		ЗаписатьОшибку("После шага осталась открытая транзакция, она отменена.");
	КонецЕсли;

	// Сообщения, которые типовой код вывел пользователю во время шага, в окно сообщений не выпускаются.
	ПолучитьСообщенияПользователю(Истина);

	Если ШагЦеликом Тогда
		ДлительностьШага = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоШага;
		СтрокиЖурнала.Добавить(СтрШаблон(
			"--- шаг занял %1 мс; ОК: %2, ошибок: %3, внимание: %4, пропусков: %5",
			ЧислоСтрокой(ДлительностьШага),
			ЧислоСтрокой(СчетчикиЖурнала.ОК),
			ЧислоСтрокой(СчетчикиЖурнала.Ошибок),
			ЧислоСтрокой(СчетчикиЖурнала.Внимание),
			ЧислоСтрокой(СчетчикиЖурнала.Пропусков)));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Текст", СтрСоединить(СтрокиЖурнала, Символы.ПС));
	Результат.Вставить("ОК", СчетчикиЖурнала.ОК);
	Результат.Вставить("Ошибок", СчетчикиЖурнала.Ошибок);
	Результат.Вставить("Внимание", СчетчикиЖурнала.Внимание);
	Результат.Вставить("Пропусков", СчетчикиЖурнала.Пропусков);
	Результат.Вставить("Снимки", СнимкиШага); // ** Хлебников С.Ю. 20261117

	Возврат Результат;

КонецФункции

// Возвращает задания тестирования в порядке выполнения. Шаги, которые обращаются к модулям многих объектов
// (компиляция модулей, перепроведение документов), разбиты на задания по одному объекту: обращение к модулю,
// который не компилируется, платформа прерывает целиком, перехватить такую ошибку нельзя. Форма выполняет
// каждое задание отдельным вызовом, и прерванным оказывается только оно.
//
// Возвращаемое значение:
//  Массив из Структура - ключи Вид ("Сервер"), Шаг, ПредставлениеШага, Элемент, Представление,
//                        НачалоШага, КонецШага, ВКонце, СохранятьЖурнал. Элемент пуст, если шаг выполняется целиком.
//
Функция ЗаданияТестирования() Экспорт

	Задания = Новый Массив;

	Для Каждого ОписаниеШага Из ШагиТестирования() Цикл

		Если ОписаниеШага.Имя = "КомпиляцияМодулей" Тогда
			ЭлементыШага = ЭлементыКомпиляцииМодулей();
		ИначеЕсли ОписаниеШага.Имя = "ПерепроведениеДокументов" Тогда
			ЭлементыШага = ЭлементыПерепроведенияДокументов();
		ИначеЕсли ОписаниеШага.Имя = "ОперацииСДокументами" Тогда
			ЭлементыШага = ЭлементыОперацийСДокументами();
		ИначеЕсли ОписаниеШага.Имя = "ОперацииСоСправочниками" Тогда
			ЭлементыШага = ЭлементыОперацийСоСправочниками();
		ИначеЕсли ОписаниеШага.Имя = "ОтменаПроведенияДокументов" Тогда
			ЭлементыШага = ЭлементыОтменыПроведенияДокументов();
		Иначе
			ЭлементыШага = ЭлементыШагаПакета(ОписаниеШага.Имя); // ** Хлебников С.Ю. 20261117 шаги пакета
		КонецЕсли;

		Если ЭлементыШага = Неопределено Тогда
			ДобавитьЗадание(Задания, ОписаниеШага, "", ОписаниеШага.Представление, Ложь, Ложь);
			Продолжить;
		КонецЕсли;

		Для Индекс = 0 По ЭлементыШага.ВГраница() Цикл
			ДобавитьЗадание(Задания, ОписаниеШага, ЭлементыШага[Индекс].Элемент, ЭлементыШага[Индекс].Представление,
				Индекс = 0, Индекс = ЭлементыШага.ВГраница());
		КонецЦикла;

	КонецЦикла;

	Возврат Задания;

КонецФункции

// Возвращает дату, старше которой тесты документы не записывают и не проводят: начало месяца самого нового
// проведённого документа среди видов, у которых в расширениях есть модуль. Документы с датой позже текущей
// не учитываются. База может быть копией на прошлую дату, поэтому отсчёт идёт от её данных, а не от даты сеанса.
//
// Возвращаемое значение:
//  Дата
//
Функция ГраницаДатыДокументов() Экспорт

	ГраницаПоУмолчанию = НачалоМесяца(ТекущаяДатаСеанса());

	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Т.Дата) КАК ДатаДокумента
	|ИЗ
	|	Документ.#Документ# КАК Т
	|ГДЕ
	|	Т.Проведен
	|	И Т.Дата <= &ТекущаяДата";

	ТекстыЗапросов = Новый Массив;
	Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
		Если Метаданные.Документы.Найти(ИмяДокумента) <> Неопределено Тогда
			ТекстыЗапросов.Добавить(СтрЗаменить(ШаблонЗапроса, "#Документ#", ИмяДокумента));
		КонецЕсли;
	КонецЦикла;

	Если ТекстыЗапросов.Количество() = 0 Тогда
		Возврат ГраницаПоУмолчанию;
	КонецЕсли;

	Разделитель = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;
	ДатаНовейшегоДокумента = Дата(1, 1, 1);

	Попытка

		Запрос = Новый Запрос(СтрСоединить(ТекстыЗапросов, Разделитель));
		Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДатаСеанса()));

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ДатаДокумента) Тогда
				ДатаНовейшегоДокумента = Макс(ДатаНовейшегоДокумента, Выборка.ДатаДокумента);
			КонецЕсли;
		КонецЦикла;

	Исключение
		Возврат ГраницаПоУмолчанию;
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ДатаНовейшегоДокумента) Тогда
		Возврат ГраницаПоУмолчанию;
	КонецЕсли;

	Возврат НачалоМесяца(ДатаНовейшегоДокумента);

КонецФункции

// Возвращает версию сборки обработки в виде ГГГГММДД.ЧЧММСС: дата и время сборки, московское время.
// Значение подставляется при сборке.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияСборки() Экспорт

	Возврат "00000000.000000";

КонецФункции

// Возвращает имя информационной базы из строки соединения (параметр Ref, для файловой базы - File).
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяИнформационнойБазы() Экспорт

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();

	ИмяБазы = ПараметрСтрокиСоединения(СтрокаСоединения, "Ref");
	Если ПустаяСтрока(ИмяБазы) Тогда
		ИмяБазы = ПараметрСтрокиСоединения(СтрокаСоединения, "File");
	КонецЕсли;

	Возврат ИмяБазы;

КонецФункции

// Истина, если имя базы похоже на имя тестовой базы. Только в такой базе выполняются тесты с записью.
//
// Возвращаемое значение:
//  Булево
//
Функция БазаПохожаНаТестовую() Экспорт

	ИмяБазы = ВРег(ИмяИнформационнойБазы());

	Признаки = СтрРазделить("TEMP,TEST,COPY,TMP,DEV,SANDBOX,STAND,ТЕСТ,КОПИЯ,СТЕНД,ПЕСОЧНИЦ", ",", Ложь);
	Для Каждого Признак Из Признаки Цикл
		Если СтрНайти(ИмяБазы, Признак) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает имена общих модулей расширений, которые компилируются на клиенте.
// Клиентская часть проверки выполняется в модуле формы.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция КлиентскиеОбщиеМодули() Экспорт

	Результат = Новый Массив;

	Для Каждого ИмяМодуля Из ОбъектыПакета("ОбщиеМодули") Цикл

		МетаданныеМодуля = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
		Если МетаданныеМодуля = Неопределено
			Или МетаданныеМодуля.Глобальный
			Или Не МетаданныеМодуля.КлиентУправляемоеПриложение Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(ИмяМодуля);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает формы расширений для клиентской проверки: форма создаётся на клиенте без открытия.
//
// Возвращаемое значение:
//  Массив из Структура - ключи ПолноеИмя, Существует, Ключ, Основная, ПрефиксыНаших (Массив из Строка).
//
Функция ФормыДляПроверки() Экспорт

	Результат = Новый Массив;
	ПрефиксыНаших = ПрефиксыНашихОбъектов(); // ** Хлебников С.Ю. 20261117 префиксы имён наших объектов - от пакета

	Для Каждого ПолноеИмяФормы Из ОбъектыПакета("Формы") Цикл

		ОписаниеФормы = Новый Структура("ПолноеИмя, Существует, Ключ, Основная, ПрефиксыНаших",
			ПолноеИмяФормы, Ложь, Неопределено, Ложь, ПрефиксыНаших); // ** Хлебников С.Ю. 20261117 ПрефиксыНаших
		ОписаниеФормы.Существует = Метаданные.НайтиПоПолномуИмени(ПолноеИмяФормы) <> Неопределено;

		ЧастиИмени = СтрРазделить(ПолноеИмяФормы, ".", Ложь);
		Если ОписаниеФормы.Существует И ЧастиИмени.Количество() = 4 Тогда

			ИмяФормы = ЧастиИмени[3];
			ОписаниеФормы.Основная = ИмяФормы = "ФормаДокумента"
				Или ИмяФормы = "ФормаЭлемента"
				Или ИмяФормы = "ФормаСписка"
				Или ИмяФормы = "ФормаВыбора"
				Или ИмяФормы = "ФормаЗаписи";

			Если ЧастиИмени[0] = "Документ" И ИмяФормы = "ФормаДокумента" Тогда
				ОписаниеФормы.Ключ = ПоследняяСсылка("Документ." + ЧастиИмени[1], Истина);
			ИначеЕсли ЧастиИмени[0] = "Справочник" И ИмяФормы = "ФормаЭлемента" Тогда
				ОписаниеФормы.Ключ = ПоследняяСсылка("Справочник." + ЧастиИмени[1], Ложь);
			КонецЕсли;

		КонецЕсли;

		Результат.Добавить(ОписаниеФормы);

	КонецЦикла;

	Возврат Результат;

КонецФункции

