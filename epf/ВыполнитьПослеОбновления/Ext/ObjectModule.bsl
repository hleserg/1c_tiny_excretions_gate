Процедура ДобавитьЗадание(Задания, ОписаниеШага, ЭлементШага, ПредставлениеЗадания, НачалоШага, КонецШага)

	Задание = Новый Структура;
	Задание.Вставить("Вид", "Сервер");
	Задание.Вставить("Шаг", ОписаниеШага.Имя);
	Задание.Вставить("ПредставлениеШага", ОписаниеШага.Представление);
	Задание.Вставить("Элемент", ЭлементШага);
	Задание.Вставить("Представление", ПредставлениеЗадания);
	Задание.Вставить("НачалоШага", НачалоШага);
	Задание.Вставить("КонецШага", КонецШага);

	// ВКонце - задание выполняется после всех остальных, в том числе клиентских.
	Задание.Вставить("ВКонце", ОписаниеШага.Имя = "ПерепроведениеДокументов" Или ОписаниеШага.Имя = "ОтменаПроведенияДокументов");
	// СохранятьЖурнал - перед заданием журнал сохраняется: задание пишет в базу и может не вернуть управление.
	Задание.Вставить("СохранятьЖурнал", ОписаниеШага.Имя <> "КомпиляцияМодулей");

	Задания.Добавить(Задание);

