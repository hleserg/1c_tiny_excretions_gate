Функция ПричинаЗапретаЗаписи()

	Если Не БазаПохожаНаТестовую() Тогда
		Возврат СтрШаблон(
			"имя базы «%1» не похоже на тестовое, в такой базе тесты в базу не пишут даже в транзакции",
			ИмяИнформационнойБазы());
	КонецЕсли;

	Возврат "в форме снят флажок «Тесты с записью в базу»";

КонецФункции

Функция ПроведениеРазрешено()

	Возврат ЗаписьРазрешена() И ПараметрыЗапуска.ПроводитьДокументы = Истина;

КонецФункции

Функция ПричинаЗапретаПроведения()

	Если Не ЗаписьРазрешена() Тогда
		Возврат ПричинаЗапретаЗаписи();
	КонецЕсли;

	Возврат "в форме снят флажок «Проводить документы»";

КонецФункции

// Внутри уже открытой транзакции делает отправку почты невозможной: у всех учётных записей
// снимается признак отправки и подменяется сервер исходящей почты. Транзакция потом отменяется.
// Нужно потому, что подписка расширения при записи документов может отправлять письма,
// а отправленное письмо отменой транзакции не вернуть.
//
// Возвращаемое значение:
//  Число - количество изменённых учётных записей.
//
Функция ОтключитьПочтуВТранзакции()

	ПроверитьЧтоЗаписьРазрешена();

	Если Не ТранзакцияАктивна() Тогда
		ВызватьИсключение "Отключать почту допустимо только внутри транзакции.";
	КонецЕсли;

	МетаданныеУчетныхЗаписей = Метаданные.Справочники.Найти("УчетныеЗаписиЭлектроннойПочты");
	Если МетаданныеУчетныхЗаписей = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ЕстьПризнакОтправки = МетаданныеУчетныхЗаписей.Реквизиты.Найти("ИспользоватьДляОтправки") <> Неопределено;
	ЕстьСервер = МетаданныеУчетныхЗаписей.Реквизиты.Найти("СерверИсходящейПочты") <> Неопределено;
	ЕстьПорт = МетаданныеУчетныхЗаписей.Реквизиты.Найти("ПортСервераИсходящейПочты") <> Неопределено;

	Если Не ЕстьПризнакОтправки И Не ЕстьСервер Тогда
		ВызватьИсключение "У справочника УчетныеЗаписиЭлектроннойПочты нет реквизитов ИспользоватьДляОтправки и СерверИсходящейПочты.";
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	УчетныеЗаписи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УчетныеЗаписиЭлектроннойПочты КАК УчетныеЗаписи";
	Если ЕстьПризнакОтправки Тогда
		// Учётные записи, с которых отправка и так выключена, не трогаются.
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	УчетныеЗаписи.ИспользоватьДляОтправки";
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса);

	Количество = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		УчетнаяЗапись = Выборка.Ссылка.ПолучитьОбъект();
		Если УчетнаяЗапись = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЕстьПризнакОтправки Тогда
			УчетнаяЗапись.ИспользоватьДляОтправки = Ложь;
		КонецЕсли;
		Если ЕстьСервер Тогда
			УчетнаяЗапись.СерверИсходящейПочты = "127.0.0.1";
		КонецЕсли;
		Если ЕстьПорт Тогда
			УчетнаяЗапись.ПортСервераИсходящейПочты = 1;
		КонецЕсли;

		УчетнаяЗапись.ОбменДанными.Загрузка = Истина;
		УчетнаяЗапись.Записать();
		Количество = Количество + 1;

	КонецЦикла;

	Возврат Количество;

КонецФункции

// Проверяет, что почту удаётся отключить. Если нет, шаги с проведением пропускаются.
// С параметром БезЗаписейВЖурнал = Истина результат проверки в журнал не пишется.
Функция ПочтаГотоваКПроведению(БезЗаписейВЖурнал = Ложь)

	Если ПараметрыЗапуска.ОтключатьПочту <> Истина Тогда
		Если Не БезЗаписейВЖурнал Тогда
			ЗаписатьВнимание("Флажок «Отключать почту» снят: если при проведении документов расширение отправляет письма, они уйдут адресатам.");
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	Готова = Ложь;

	НачатьТранзакцию();
	Попытка
		Количество = ОтключитьПочтуВТранзакции();
		ОтменитьТранзакцию();
		Готова = Истина;
		Если Не БезЗаписейВЖурнал Тогда
			ЗаписатьИнфо(СтрШаблон(
				"На время каждого проведения почта отключается внутри транзакции (учётных записей: %1), после проведения транзакция отменяется.",
				ЧислоСтрокой(Количество)));
		КонецЕсли;
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Если Не БезЗаписейВЖурнал Тогда
			ЗаписатьПропуск("Не удалось отключить почту внутри транзакции, проведение документов не выполняется."
				+ " Проводить без этой защиты можно, сняв флажок «Отключать почту»." + Символы.ПС + ТекстОшибки);
		КонецЕсли;
	КонецПопытки;

	Возврат Готова;

КонецФункции

Функция ЭтоОшибкаОтправкиПочты(ТекстОшибки)

	ТекстВРег = ВРег(ТекстОшибки);

	Возврат СтрНайти(ТекстВРег, "ПОЧТ") > 0
		Или СтрНайти(ТекстВРег, "SMTP") > 0
		Или СтрНайти(ТекстВРег, "MAIL") > 0;

КонецФункции

Функция ПоследняяСсылка(ИмяТаблицы, ЭтоДокумент)

	Попытка

		Если ЭтоДокумент Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Ссылка КАК Ссылка,
			|	Т.Дата КАК Дата
			|ИЗ
			|	#Таблица# КАК Т
			|
			|УПОРЯДОЧИТЬ ПО
			|	Дата УБЫВ";
		Иначе
			МетаданныеСправочника = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
			ЕстьГруппы = МетаданныеСправочника.Иерархический
				И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
			ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Т.Ссылка КАК Ссылка
			|ИЗ
			|	#Таблица# КАК Т";
			Если ЕстьГруппы Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|ГДЕ
				|	НЕ Т.ЭтоГруппа";
			КонецЕсли;
		КонецЕсли;

		Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "#Таблица#", ИмяТаблицы));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПредставлениеШага(ИмяШага)

	// ** Хлебников С.Ю. 20261117 Шаги пакета, которые не входят в обычный прогон (их вызывают кнопки формы).
	ПредставлениеВнеПрогона = ПредставлениеШагаВнеПрогонаПакета(ИмяШага);
	Если ЗначениеЗаполнено(ПредставлениеВнеПрогона) Тогда
		Возврат ПредставлениеВнеПрогона;
	КонецЕсли;

	Для Каждого ОписаниеШага Из ШагиТестирования() Цикл
		Если ОписаниеШага.Имя = ИмяШага Тогда
			Возврат ОписаниеШага.Представление;
		КонецЕсли;
	КонецЦикла;

	Возврат ИмяШага;

КонецФункции

Процедура ВыполнитьШаг(ИмяШага, ЭлементШага)

	// ** Хлебников С.Ю. 20261117 Здесь только шаги ядра, остальные выполняет пакет.
	Если ИмяШага = "Окружение" Тогда
		ТестОкружение();
	ИначеЕсли ИмяШага = "ПрименимостьРасширений" Тогда
		ТестПрименимостьРасширений();
	ИначеЕсли ИмяШага = "КомпиляцияМодулей" Тогда
		ТестКомпиляцияМодулей(ЭлементШага);
	ИначеЕсли ИмяШага = "ПерепроведениеДокументов" Тогда
		ТестПерепроведениеДокументов(ЭлементШага);
	ИначеЕсли ИмяШага = "ОперацииСДокументами" Тогда
		ТестОперацииСДокументами(ЭлементШага);
	ИначеЕсли ИмяШага = "ОперацииСоСправочниками" Тогда
		ТестОперацииСоСправочниками(ЭлементШага);
	ИначеЕсли ИмяШага = "ОтменаПроведенияДокументов" Тогда
		ТестОтменаПроведенияДокументов(ЭлементШага);
	ИначеЕсли ИмяШага = "Обмены" Тогда // ** Хлебников С.Ю. 20261117
		ТестОбмены();
	ИначеЕсли Не ВыполнитьШагПакета(ИмяШага, ЭлементШага) Тогда
		ЗаписатьОшибку("Неизвестный шаг: " + ИмяШага);
	КонецЕсли;

КонецПроцедуры

Функция ЭтоОшибкаВКодеРасширений(ТекстОшибки)

	// ** Хлебников С.Ю. 20261117 Наши расширения называет пакет.
	Для Каждого ИмяРасширения Из НашиРасширения() Цикл
		Если СтрНайти(ТекстОшибки, ИмяРасширения) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ОписаниеНеудачиПроведения(Результат)

	ЧастиОписания = Новый Массив;

	Если Не ПустаяСтрока(Результат.Сообщения) Тогда
		ЧастиОписания.Добавить("Сообщения пользователю: " + ОбрезатьТекст(Результат.Сообщения, 1500));
	КонецЕсли;
	Если Не ПустаяСтрока(Результат.ТекстОшибки) Тогда
		ЧастиОписания.Добавить("Исключение: " + ОбрезатьТекст(Результат.ТекстОшибки, 2500));
	КонецЕсли;

	ВесьТекст = Результат.Сообщения + " " + Результат.ТекстОшибки;
	Если ПараметрыЗапуска.ОтключатьПочту = Истина И ЭтоОшибкаОтправкиПочты(ВесьТекст) Тогда
		ЧастиОписания.Добавить("Похоже, при записи документа расширение отправляет письмо: отправка заблокирована тестом, поэтому запись не прошла.");
	КонецЕсли;

	Возврат СтрСоединить(ЧастиОписания, Символы.ПС);

КонецФункции

#КонецОбласти

// @@ПАКЕТЫ: МАРШРУТЫ@@

#Область Обмены

// ** Хлебников С.Ю. 20261117 Сообщение обмена для пары объектов по каждому узлу, который называет пакет: типовым кодом обмена
// через универсальный формат, в транзакции, которая отменяется; сообщение никуда не отправляется, номера сообщений
// узла не меняются. Текст сообщения уходит в гейт снимком, гейт сравнивает его с таким же снимком «до» загрузки:
// так видно, что комплект поменял в выгрузке (правила конвертации, перехваты, состав объектов).
Процедура ТестОбмены()

	УзлыСнимков = УзлыДляСнимковОбменаПакета();
	Если УзлыСнимков.Количество() = 0 Тогда
		ЗаписатьПропуск("Обмены: пакет сценариев не назвал узлы обмена для снимков.");
		Возврат;
	КонецЕсли;

	ОбменXDTO = ОбщийМодульЕслиЕсть("ОбменДаннымиXDTOСервер");
	Если ОбменXDTO = Неопределено Тогда
		ЗаписатьПропуск("Обмены: в конфигурации нет общего модуля ОбменДаннымиXDTOСервер.");
		Возврат;
	КонецЕсли;

	Если Не ЗаписьРазрешена() Тогда
		ЗаписатьПропуск("Обмены: сообщения обмена не формируются: " + ПричинаЗапретаЗаписи() + ".");
		Возврат;
	КонецЕсли;

	Для Каждого ОписаниеУзла Из УзлыСнимков Цикл

		Объекты = ОбъектыДляСнимковОбменаПакета(ОписаниеУзла.Узел, ОписаниеУзла.Имя);
		Если Объекты.Количество() = 0 Тогда
			ЗаписатьПропуск("Обмены, " + ОписаниеУзла.Имя + ": объектов для сообщения обмена в базе нет.");
			Продолжить;
		КонецЕсли;

		Для Каждого СсылкаОбъекта Из Объекты Цикл
			ВыгрузитьСнимокОбмена(ОбменXDTO, ОписаниеУзла, СсылкаОбъекта);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Одно сообщение обмена: запись в журнал и снимок для гейта.
//
// Параметры:
//  ОбменXDTO - ОбщийМодуль - ОбменДаннымиXDTOСервер.
//  ОписаниеУзла - Структура - ключи Узел, Имя, см. УзлыДляСнимковОбменаПакета.
//  СсылкаОбъекта - ЛюбаяСсылка - объект для выгрузки.
//
Процедура ВыгрузитьСнимокОбмена(ОбменXDTO, ОписаниеУзла, СсылкаОбъекта)

	ПолноеИмя = СсылкаОбъекта.Метаданные().ПолноеИмя();
	Представление = "Обмены, " + ОписаниеУзла.Имя + ": " + ПолноеИмя + " «" + Строка(СсылкаОбъекта) + "»";

	Результат = ВыгрузитьДокументВТранзакции(ОбменXDTO, ОписаниеУзла.Узел, СсылкаОбъекта);

	Если Не Результат.Успех Тогда
		ЗаписатьВнимание(Представление + ": сообщение обмена сформировать не удалось." + Символы.ПС
			+ ОбрезатьТекст(Результат.ТекстОшибки)
			+ ?(ПустаяСтрока(Результат.Сообщения), "", Символы.ПС + "Сообщения: " + ОбрезатьТекст(Результат.Сообщения, 1500)));
		Возврат;
	КонецЕсли;

	Если Результат.ФлагОшибки Или Результат.НеВыгружено > 0 Тогда
		ЗаписатьОшибку(Представление + ": типовой код обмена сообщил об ошибке выгрузки." + Символы.ПС
			+ ОбрезатьТекст(Результат.СообщениеОбОшибке)
			+ ?(ПустаяСтрока(Результат.Сообщения), "", Символы.ПС + "Сообщения: " + ОбрезатьТекст(Результат.Сообщения, 1500)));
	Иначе
		ЗаписатьОК(Представление + ": сообщение обмена сформировано без ошибок");
	КонецЕсли;

	ЗаписатьИнфо(СтрШаблон("%1: %2 мс, длина XML %3 символов, выгружено - %4",
		Представление,
		ЧислоСтрокой(Результат.ДлительностьМс),
		ЧислоСтрокой(СтрДлина(Результат.ТекстXML)),
		Результат.ВыгруженныеОбъекты));

	ЗаписатьСнимок("обмен|" + ОписаниеУзла.Имя + "|" + ПолноеИмя + "|" + Строка(СсылкаОбъекта.УникальныйИдентификатор()),
		Результат.ТекстXML);

КонецПроцедуры

// Готовит компоненты обмена так же, как типовая обработка КонвертацияОбъектовXDTO перед обменом с узлом.
Функция КомпонентыОбменаСПравилами(ОбменXDTO, Узел, НаправлениеОбмена)

	Компоненты = ОбменXDTO.ИнициализироватьКомпонентыОбмена(НаправлениеОбмена);
	Компоненты.УзелКорреспондента = Узел;
	Компоненты.ВерсияФорматаОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ВерсияФорматаОбмена");

	ИмяПланаОбмена = Узел.Метаданные().Имя;
	Компоненты.XMLСхема = ОбменXDTO.ФорматОбмена(ИмяПланаОбмена, Компоненты.ВерсияФорматаОбмена);

	ОбменXDTO.ПослеИнициализацииКомпонентыОбмена(Компоненты);

	Компоненты.МенеджерОбмена = ОбменXDTO.МенеджерОбменаВерсииФормата(Компоненты.ВерсияФорматаОбмена, Узел);

	Если НаправлениеОбмена = "Отправка" Тогда
		Компоненты.Вставить("ТаблицаПравилаРегистрацииОбъектов", ОбменXDTO.ПравилаРегистрацииОбъектов(Узел));
		Компоненты.Вставить("СвойстваУзлаПланаОбмена", ОбменXDTO.СвойстваУзлаПланаОбмена(Узел));
	КонецЕсли;

	ОбменXDTO.ИнициализироватьТаблицыПравилОбмена(Компоненты);

	Возврат Компоненты;

КонецФункции

// Выгружает один объект типовым кодом обмена в строку XML. Сообщение никуда не отправляется,
// номера сообщений узла не меняются, транзакция отменяется.
Функция ВыгрузитьДокументВТранзакции(ОбменXDTO, Узел, Ссылка)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстXML", "");
	Результат.Вставить("ФлагОшибки", Ложь);
	Результат.Вставить("СообщениеОбОшибке", "");
	Результат.Вставить("ВыгруженныеОбъекты", "");
	Результат.Вставить("НеВыгружено", 0);
	Результат.Вставить("ДлительностьМс", 0);
	Результат.Вставить("Сообщения", "");

	ПроверитьЧтоЗаписьРазрешена();
	ПолучитьСообщенияПользователю(Истина);

	НачатьТранзакцию();
	Попытка

		Компоненты = КомпонентыОбменаСПравилами(ОбменXDTO, Узел, "Отправка");
		// Без квитирования типовой код не блокирует узел и не читает номера сообщений.
		Компоненты.ИспользоватьКвитирование = Ложь;

		ОбменXDTO.ЗаполнитьСтруктуруНастроекXDTO(Компоненты);
		ОбменXDTO.ЗаполнитьПоддерживаемыеОбъектыXDTO(Компоненты);
		ОбменXDTO.ОткрытьФайлВыгрузки(Компоненты);
		Компоненты.МенеджерОбмена.ПередКонвертацией(Компоненты);

		НачалоВыгрузки = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ОбменXDTO.ВыгрузкаОбъектаВыборки(Компоненты, Ссылка.ПолучитьОбъект());
		Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыгрузки;

		Результат.ФлагОшибки = Компоненты.ФлагОшибки = Истина;
		Результат.СообщениеОбОшибке = Строка(Компоненты.СтрокаСообщенияОбОшибке);
		Результат.НеВыгружено = Компоненты.НеВыгруженныеОбъекты.Количество();

		КоличествоПоТипам = Новый Соответствие;
		Для Каждого ВыгруженныйОбъект Из Компоненты.ВыгруженныеОбъекты Цикл
			ИмяТипа = Строка(ТипЗнч(ВыгруженныйОбъект));
			Количество = КоличествоПоТипам.Получить(ИмяТипа);
			КоличествоПоТипам.Вставить(ИмяТипа, ?(Количество = Неопределено, 0, Количество) + 1);
		КонецЦикла;
		ЧастиОписания = Новый Массив;
		Для Каждого ЭлементКоличества Из КоличествоПоТипам Цикл
			ЧастиОписания.Добавить(ЭлементКоличества.Ключ + ": " + ЧислоСтрокой(ЭлементКоличества.Значение));
		КонецЦикла;
		Результат.ВыгруженныеОбъекты = СтрСоединить(ЧастиОписания, "; ");

		Результат.ТекстXML = Компоненты.ФайлОбмена.Закрыть();
		Результат.Успех = Истина;

		ОтменитьТранзакцию();

	Исключение
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;

	Результат.Сообщения = ТекстНакопленныхСообщений();

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОкружениеИРасширения

Процедура ТестОкружение()

	СведенияОСистеме = Новый СистемнаяИнформация;

	ЗаписатьИнфо("Платформа: " + СведенияОСистеме.ВерсияПриложения);
	ЗаписатьИнфо("Конфигурация: " + Метаданные.Имя + ", версия " + Метаданные.Версия);
	ЗаписатьИнфо("Строка соединения: " + СтрокаСоединенияИнформационнойБазы());
	ЗаписатьИнфо("Имя базы: " + ИмяИнформационнойБазы()
		+ ?(БазаПохожаНаТестовую(), " - похоже на тестовую", " - НЕ похоже на тестовую, тесты с записью выполняться не будут"));
	ЗаписатьИнфо("Пользователь: " + ИмяПользователя() + ", полные права: " + ДаНет(Пользователи.ЭтоПолноправныйПользователь()));
	ЗаписатьИнфо("Дата сеанса: " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));
	ЗаписатьИнфо("Безопасный режим: " + Строка(БезопасныйРежим()));
	ЗаписатьИнфо(СтрШаблон(
		"Параметры запуска: запись в базу - %1, проведение документов - %2, отключать почту - %3, документов каждого вида - %4",
		ДаНет(ПараметрыЗапуска.РазрешитьЗапись),
		ДаНет(ПараметрыЗапуска.ПроводитьДокументы),
		ДаНет(ПараметрыЗапуска.ОтключатьПочту),
		ЧислоСтрокой(ПараметрыЗапуска.КоличествоДокументов)));

	Проверить(Пользователи.ЭтоПолноправныйПользователь(), "Обработка запущена под полными правами");

	// Расширения в базе.
	ИменаРасширенийБазы = Новый Соответствие;
	Для Каждого РасширениеБазы Из РасширенияКонфигурации.Получить() Цикл

		СвойстваРасширения = Новый Структура("Имя, Версия, Активно, БезопасныйРежим, Назначение, ОбластьДействия");
		ЗаполнитьЗначенияСвойств(СвойстваРасширения, РасширениеБазы);
		ИменаРасширенийБазы.Вставить(Строка(СвойстваРасширения.Имя), Строка(СвойстваРасширения.Версия));

		ЗаписатьИнфо(СтрШаблон(
			"Расширение в базе: %1, версия «%2», активно: %3, безопасный режим: %4, назначение: %5, область действия: %6",
			Строка(СвойстваРасширения.Имя),
			Строка(СвойстваРасширения.Версия),
			Строка(СвойстваРасширения.Активно),
			Строка(СвойстваРасширения.БезопасныйРежим),
			Строка(СвойстваРасширения.Назначение),
			Строка(СвойстваРасширения.ОбластьДействия)));

	КонецЦикла;

	// Расширения, применённые в этом сеансе.
	ИменаРасширенийСеанса = Новый Соответствие;
	Попытка
		// Через Вычислить: если в этой версии платформы перечисление называется иначе, будет исключение, а не ошибка компиляции.
		ИсточникСеанс = Вычислить("ИсточникРасширенийКонфигурации.СеансАктивные");
		Для Каждого РасширениеСеанса Из РасширенияКонфигурации.Получить(, ИсточникСеанс) Цикл
			СвойстваРасширения = Новый Структура("Имя, Версия");
			ЗаполнитьЗначенияСвойств(СвойстваРасширения, РасширениеСеанса);
			ИменаРасширенийСеанса.Вставить(Строка(СвойстваРасширения.Имя), Строка(СвойстваРасширения.Версия));
		КонецЦикла;
	Исключение
		ИменаРасширенийСеанса = Неопределено;
		ЗаписатьИнфо("Список расширений, применённых в сеансе, получить не удалось: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// ** Хлебников С.Ю. 20261117 Пакет сценариев и его часть окружения: свои расширения, версии, оповещения.
	Пакет = ТекущийПакетСценариев();
	ЗаписатьИнфо("Пакет сценариев: " + Пакет.Представление + " - " + Пакет.Причина);
	ОкружениеПакета(ИменаРасширенийБазы, ИменаРасширенийСеанса);
	// ** Хлебников С.Ю. 20261117 конец

	// Сведения, от которых зависит, уйдут ли наружу письма при проведении документов.
	Попытка
		МодульРегламентныхЗаданий = ОбщегоНазначения.ОбщийМодуль("РегламентныеЗаданияСервер");
		ЗаписатьИнфо("Работа с внешними ресурсами заблокирована (БСП): "
			+ ДаНет(МодульРегламентныхЗаданий.РаботаСВнешнимиРесурсамиЗаблокирована()));
	Исключение
		ЗаписатьИнфо("Состояние блокировки работы с внешними ресурсами получить не удалось.");
	КонецПопытки;

КонецПроцедуры

Процедура ТестПрименимостьРасширений()

	Если ПараметрыЗапуска.ПроверятьПрименимость <> Истина Тогда
		ЗаписатьПропуск("В форме снят флажок платформенной проверки применимости расширений.");
		Возврат;
	КонецЕсли;

	Попытка
		Проблемы = РасширенияКонфигурации.ПроверитьВозможностьПримененияВсех();
	Исключение
		ЗаписатьПропуск("Платформенную проверку применимости вызвать не удалось:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Проблемы = Неопределено Или Проблемы.Количество() = 0 Тогда
		ЗаписатьОК("Платформа не нашла проблем применения расширений.");
		Возврат;
	КонецЕсли;

	ЗаписатьИнфо("Платформа сообщила о проблемах применения расширений: " + ЧислоСтрокой(Проблемы.Количество()));

	Для Каждого Проблема Из Проблемы Цикл

		СвойстваПроблемы = Новый Структура("Расширение, Важность, Описание");
		ЗаполнитьЗначенияСвойств(СвойстваПроблемы, Проблема);

		ИмяРасширения = "";
		Если СвойстваПроблемы.Расширение <> Неопределено Тогда
			СвойстваРасширения = Новый Структура("Имя");
			Попытка
				ЗаполнитьЗначенияСвойств(СвойстваРасширения, СвойстваПроблемы.Расширение);
			Исключение
				СвойстваРасширения.Имя = Строка(СвойстваПроблемы.Расширение);
			КонецПопытки;
			ИмяРасширения = Строка(СвойстваРасширения.Имя);
		КонецЕсли;

		ВажностьСтрокой = Строка(СвойстваПроблемы.Важность);
		ТекстЗаписи = СтрШаблон("%1 [%2]: %3", ИмяРасширения, ВажностьСтрокой, Строка(СвойстваПроблемы.Описание));

		ВажностьВРег = ВРег(ВажностьСтрокой);
		Если СтрНайти(ВажностьВРег, "ШИБК") > 0 Или СтрНайти(ВажностьВРег, "RROR") > 0 Или СтрНайти(ВажностьВРег, "РИТИЧ") > 0 Тогда
			Если НашиРасширения().Найти(ИмяРасширения) <> Неопределено Тогда // ** Хлебников С.Ю. 20261117 наши расширения называет пакет
				ЗаписатьОшибку(ТекстЗаписи);
			Иначе
				ЗаписатьВнимание(ТекстЗаписи);
			КонецЕсли;
		ИначеЕсли СтрНайти(ВажностьВРег, "РЕДУПРЕЖД") > 0 Или СтрНайти(ВажностьВРег, "ARNING") > 0 Тогда
			ЗаписатьВнимание(ТекстЗаписи);
		Иначе
			ЗаписатьИнфо(ТекстЗаписи);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КомпиляцияМодулей

// Элементы шага «Компиляция серверных модулей»: по одному на модуль.
Функция ЭлементыКомпиляцииМодулей()

	ЭлементыШага = Новый Массив;

	ДобавитьЭлементШага(ЭлементыШага, "Начало", "Компиляция модулей: способ проверки");

	Для Каждого ИмяМодуля Из ОбъектыПакета("ОбщиеМодули") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "ОбщийМодуль|" + ИмяМодуля, "ОбщийМодуль." + ИмяМодуля);
	КонецЦикла;

	Для Каждого ПолноеИмя Из ОбъектыПакета("МодулиМенеджеров") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "Менеджер|" + ПолноеИмя, ПолноеИмя + ", модуль менеджера");
	КонецЦикла;

	Для Каждого ПолноеИмя Из ОбъектыПакета("МодулиОбъектов") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "Объект|" + ПолноеИмя, ПолноеИмя + ", модуль объекта");
	КонецЦикла;

	Для Каждого ПолноеИмя Из ОбъектыПакета("МодулиНаборовЗаписей") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "НаборЗаписей|" + ПолноеИмя, ПолноеИмя + ", модуль набора записей");
	КонецЦикла;

	ДобавитьЭлементШага(ЭлементыШага, "Конец", "Компиляция модулей: что не проверяется");

	Возврат ЭлементыШага;

КонецФункции

// Параметры:
//  ЭлементШага - Строка - элемент из ЭлементыКомпиляцииМодулей; пустая строка - все элементы одним вызовом.
//
Процедура ТестКомпиляцияМодулей(ЭлементШага)

	ЧастиЭлемента = СтрРазделить(ЭлементШага, "|", Истина);
	ВидЭлемента = ЧастиЭлемента[0];
	ИмяЭлемента = ?(ЧастиЭлемента.Количество() > 1, ЧастиЭлемента[1], "");

	Если ВидЭлемента = "Начало" Тогда

		ЗаписатьИнфо("Способ проверки: у модуля вызывается заведомо отсутствующий метод. Ответ «метод не обнаружен» означает,"
			+ " что модуль вместе с частью из расширения скомпилирован. Модули объектов и наборов записей проверяются созданием объекта.");

	ИначеЕсли ВидЭлемента = "ОбщийМодуль" Тогда

		ПроверитьКомпиляциюОбщегоМодуля(ИмяЭлемента);

	ИначеЕсли ВидЭлемента = "Менеджер" Тогда

		ПроверитьКомпиляциюМодуляМенеджера(ИмяЭлемента);

	ИначеЕсли ВидЭлемента = "Объект" Тогда

		ПроверитьСозданиеОбъекта(ИмяЭлемента, ", модуль объекта", Ложь);

	ИначеЕсли ВидЭлемента = "НаборЗаписей" Тогда

		ПроверитьСозданиеОбъекта(ИмяЭлемента, ", модуль набора записей", Истина);

	ИначеЕсли ВидЭлемента = "Конец" Тогда

		// ** Хлебников С.Ю. 20261117 что не проверяется, знает пакет
		ПояснениеКомпиляции = ПояснениеКомпиляцииПакета();
		Если ЗначениеЗаполнено(ПояснениеКомпиляции) Тогда
			ЗаписатьИнфо(ПояснениеКомпиляции);
		КонецЕсли;

	Иначе

		// Элемент не задан: все проверки одним вызовом.
		Для Каждого ОписаниеЭлемента Из ЭлементыКомпиляцииМодулей() Цикл
			ТестКомпиляцияМодулей(ОписаниеЭлемента.Элемент);
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКомпиляциюОбщегоМодуля(ИмяМодуля)

	Представление = "ОбщийМодуль." + ИмяМодуля;

	МетаданныеМодуля = Метаданные.ОбщиеМодули.Найти(ИмяМодуля);
	Если МетаданныеМодуля = Неопределено Тогда
		ЗаписатьПропуск(Представление + ": нет в конфигурации");
		Возврат;
	КонецЕсли;

	Если МетаданныеМодуля.Глобальный Тогда
		ЗаписатьИнфо(Представление + ": глобальный, компилируется при старте сеанса");
		Возврат;
	КонецЕсли;

	Если Не МетаданныеМодуля.Сервер Тогда
		ЗаписатьИнфо(Представление + ": клиентский, проверяется в клиентской части");
		Возврат;
	КонецЕсли;

	Попытка
		МодульДляПроверки = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	Исключение
		ЗаписатьОшибку(Представление + ": не удалось получить модуль:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПроверитьКомпиляциюВызовом(Представление, МодульДляПроверки);

КонецПроцедуры

Процедура ПроверитьКомпиляциюМодуляМенеджера(ПолноеИмя)

	Представление = ПолноеИмя + ", модуль менеджера";

	Попытка
		Менеджер = МенеджерПоИмени(ПолноеИмя);
	Исключение
		ЗаписатьОшибку(Представление + ": не удалось получить менеджер:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Менеджер = Неопределено Тогда
		ЗаписатьПропуск(Представление + ": объекта нет в конфигурации");
		Возврат;
	КонецЕсли;

	ПроверитьКомпиляциюВызовом(Представление, Менеджер);

КонецПроцедуры

Процедура ПроверитьКомпиляциюВызовом(Представление, ОбъектСМодулем)

	Попытка
		ОбъектСМодулем.ТестКомпиляции_НетТакогоМетода();
		ЗаписатьВнимание(Представление + ": метод-пустышка неожиданно выполнился.");
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ЭтоОтветНетТакогоМетода(ТекстОшибки) Тогда
			ЗаписатьОК(Представление + ": компилируется");
		Иначе
			ЗаписатьОшибку(Представление + ": ошибка при обращении к модулю:" + Символы.ПС + ОбрезатьТекст(ТекстОшибки));
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

Функция ЭтоОтветНетТакогоМетода(ТекстОшибки)

	Если СтрНайти(ТекстОшибки, "(ТестКомпиляции_НетТакогоМетода)") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстВРег = ВРег(ТекстОшибки);

	Возврат СтрНайти(ТекстВРег, "НЕ ОБНАРУЖЕН") > 0 Или СтрНайти(ТекстВРег, "NOT FOUND") > 0;

КонецФункции

Процедура ПроверитьСозданиеОбъекта(ПолноеИмя, Пояснение, ЭтоНаборЗаписей)

	Представление = ПолноеИмя + Пояснение;

	Попытка

		Менеджер = МенеджерПоИмени(ПолноеИмя);
		Если Менеджер = Неопределено Тогда
			ЗаписатьПропуск(Представление + ": объекта нет в конфигурации");
			Возврат;
		КонецЕсли;

		ИмяКоллекции = СтрРазделить(ПолноеИмя, ".", Ложь)[0];

		Если ЭтоНаборЗаписей Тогда
			СозданныйОбъект = Менеджер.СоздатьНаборЗаписей();
		ИначеЕсли ИмяКоллекции = "Документы" Тогда
			СозданныйОбъект = Менеджер.СоздатьДокумент();
		ИначеЕсли ИмяКоллекции = "Справочники" Тогда
			СозданныйОбъект = Менеджер.СоздатьЭлемент();
		ИначеЕсли ИмяКоллекции = "БизнесПроцессы" Тогда
			СозданныйОбъект = Менеджер.СоздатьБизнесПроцесс();
		ИначеЕсли ИмяКоллекции = "Обработки" Или ИмяКоллекции = "Отчеты" Тогда
			СозданныйОбъект = Менеджер.Создать();
		Иначе
			ЗаписатьПропуск(Представление + ": для такого вида объектов проверка не предусмотрена");
			Возврат;
		КонецЕсли;

		Если СозданныйОбъект = Неопределено Тогда
			ЗаписатьОшибку(Представление + ": объект не создан.");
		Иначе
			ЗаписатьОК(Представление + ": компилируется");
		КонецЕсли;

	Исключение
		ЗаписатьОшибку(Представление + ": ошибка при создании объекта:" + Символы.ПС
			+ ОбрезатьТекст(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Возвращает менеджер объекта по имени вида "Документы.ЗаказКлиента" либо Неопределено, если объекта нет.
Функция МенеджерПоИмени(ПолноеИмя)

	ЧастиИмени = СтрРазделить(ПолноеИмя, ".", Ложь);
	ИмяКоллекции = ЧастиИмени[0];
	ИмяОбъекта = ЧастиИмени[1];

	Если ИмяКоллекции = "Документы" Тогда
		Возврат ?(Метаданные.Документы.Найти(ИмяОбъекта) = Неопределено, Неопределено, Документы[ИмяОбъекта]);
	ИначеЕсли ИмяКоллекции = "Справочники" Тогда
		Возврат ?(Метаданные.Справочники.Найти(ИмяОбъекта) = Неопределено, Неопределено, Справочники[ИмяОбъекта]);
	ИначеЕсли ИмяКоллекции = "Обработки" Тогда
		Возврат ?(Метаданные.Обработки.Найти(ИмяОбъекта) = Неопределено, Неопределено, Обработки[ИмяОбъекта]);
	ИначеЕсли ИмяКоллекции = "Отчеты" Тогда
		Возврат ?(Метаданные.Отчеты.Найти(ИмяОбъекта) = Неопределено, Неопределено, Отчеты[ИмяОбъекта]);
	ИначеЕсли ИмяКоллекции = "РегистрыСведений" Тогда
		Возврат ?(Метаданные.РегистрыСведений.Найти(ИмяОбъекта) = Неопределено, Неопределено, РегистрыСведений[ИмяОбъекта]);
	ИначеЕсли ИмяКоллекции = "РегистрыНакопления" Тогда
		Возврат ?(Метаданные.РегистрыНакопления.Найти(ИмяОбъекта) = Неопределено, Неопределено, РегистрыНакопления[ИмяОбъекта]);
	ИначеЕсли ИмяКоллекции = "БизнесПроцессы" Тогда
		Возврат ?(Метаданные.БизнесПроцессы.Найти(ИмяОбъекта) = Неопределено, Неопределено, БизнесПроцессы[ИмяОбъекта]);
	КонецЕсли;

	ВызватьИсключение "Неизвестный вид объектов: " + ИмяКоллекции;

КонецФункции

#КонецОбласти

#Область ПерепроведениеДокументов

// Элементы шага «Перепроведение документов»: подготовка и по одному на вид документов.
Функция ЭлементыПерепроведенияДокументов()

	ЭлементыШага = Новый Массив;

	ДобавитьЭлементШага(ЭлементыШага, "Начало", "Перепроведение документов: подготовка");

	Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "Документ|" + ИмяДокумента, "Документ." + ИмяДокумента + ", перепроведение");
	КонецЦикла;

	Возврат ЭлементыШага;

КонецФункции

// Параметры:
//  ЭлементШага - Строка - элемент из ЭлементыПерепроведенияДокументов; пустая строка - все элементы одним вызовом.
//
Процедура ТестПерепроведениеДокументов(ЭлементШага)

	ЧастиЭлемента = СтрРазделить(ЭлементШага, "|", Истина);
	ВидЭлемента = ЧастиЭлемента[0];
	ИмяЭлемента = ?(ЧастиЭлемента.Количество() > 1, ЧастиЭлемента[1], "");

	ШагЦеликом = ПустаяСтрока(ЭлементШага);

	// Причины, по которым проведение не выполняется, пишутся в журнал один раз: при подготовке.
	СообщатьОПодготовке = ШагЦеликом Или ВидЭлемента = "Начало";

	Если Не ПроведениеРазрешено() Тогда
		Если СообщатьОПодготовке Тогда
			ЗаписатьПропуск("Перепроведение документов не выполняется: " + ПричинаЗапретаПроведения() + ".");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	КоличествоНаВид = ПараметрыЗапуска.КоличествоДокументов;
	Если ТипЗнч(КоличествоНаВид) <> Тип("Число") Или КоличествоНаВид < 1 Тогда
		Если СообщатьОПодготовке Тогда
			ЗаписатьПропуск("Перепроведение документов не выполняется: количество документов каждого вида равно 0.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	КоличествоНаВид = Мин(Цел(КоличествоНаВид), 50);

	Если Не ПочтаГотоваКПроведению(Не СообщатьОПодготовке) Тогда
		Возврат;
	КонецЕсли;

	Если СообщатьОПодготовке Тогда
		ЗаписатьИнфо("Берутся последние проведённые документы каждого вида, у которого в расширениях есть модуль объекта или менеджера."
			+ " Документ перепроводится без изменений внутри транзакции, затем транзакция отменяется."
			+ " Сравнивается количество движений по регистрам до и после.");
	КонецЕсли;

	Если СообщатьОПодготовке Тогда
		ПодготовкаПерепроведенияПакета(); // ** Хлебников С.Ю. 20261117 то, что относится к базе, пишет пакет
		ЗаписатьИнфо("Документов каждого вида берётся не больше 50. На вид отводится 120 секунд: когда они вышли,"
			+ " остальные документы вида не берутся.");
	КонецЕсли;

	Если ШагЦеликом Тогда
		Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
			ПерепровестиДокументыВида(ИмяДокумента, КоличествоНаВид);
		КонецЦикла;
	ИначеЕсли ВидЭлемента = "Документ" Тогда
		ПерепровестиДокументыВида(ИмяЭлемента, КоличествоНаВид);
	КонецЕсли;

КонецПроцедуры

Процедура ПерепровестиДокументыВида(ИмяДокумента, КоличествоНаВид)

	Если ДокументИсключен(ИмяДокумента) Тогда
		ЗаписатьПропуск("Документ." + ИмяДокумента + ": вид указан в поле «Не проводить документы», перепроведение пропущено");
		Возврат;
	КонецЕсли;

	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		ЗаписатьПропуск("Документ." + ИмяДокумента + ": нет в конфигурации");
		Возврат;
	КонецЕсли;

	Если МетаданныеДокумента.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		ЗаписатьИнфо("Документ." + ИмяДокумента + ": не проводится, пропущен");
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ #Количество#
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата
	|ИЗ
	|	Документ.#Документ# КАК Документы
	|ГДЕ
	|	Документы.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Количество#", ЧислоСтрокой(КоличествоНаВид));
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Документ#", ИмяДокумента);

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		ТаблицаДокументов = Запрос.Выполнить().Выгрузить();
	Исключение
		ЗаписатьОшибку("Документ." + ИмяДокумента + ": не удалось выбрать документы:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если ТаблицаДокументов.Количество() = 0 Тогда
		ЗаписатьИнфо("Документ." + ИмяДокумента + ": проведённых документов нет");
		Возврат;
	КонецЕсли;

	ГраницаДаты = ГраницаДатыДокументовДляЗаписи();

	Если ТаблицаДокументов[0].Дата < ГраницаДаты Тогда
		ЗаписатьПропуск("Документ." + ИмяДокумента + ": " + ПояснениеОСтаромДокументе(ТаблицаДокументов[0].Дата) + ".");
		Возврат;
	КонецЕсли;

	// Один вид документов - один серверный вызов, прервать его нельзя. Поэтому у вида есть лимит времени:
	// когда он вышел, остальные документы вида не берутся.
	ЛимитВремениНаВидМс = 120000;
	НачалоВида = ТекущаяУниверсальнаяДатаВМиллисекундах();

	ПодходитПоДате = 0;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Если СтрокаДокумента.Дата >= ГраницаДаты Тогда
			ПодходитПоДате = ПодходитПоДате + 1;
		КонецЕсли;
	КонецЦикла;

	Перепроведено = 0;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл

		Если СтрокаДокумента.Дата < ГраницаДаты Тогда
			Продолжить;
		КонецЕсли;

		Если Перепроведено > 0
			И ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВида > ЛимитВремениНаВидМс Тогда
			Прервать;
		КонецЕсли;

		ОценитьПерепроведение(ПерепровестиДокументВТранзакции(СтрокаДокумента.Ссылка, МетаданныеДокумента), СтрокаДокумента.Ссылка);
		Перепроведено = Перепроведено + 1;

	КонецЦикла;

	Если Перепроведено < ПодходитПоДате Тогда
		ЗаписатьИнфо(СтрШаблон(
			"Документ.%1: перепроведено %2 из %3 подходящих по дате, остальные не взяты: вид занял больше %4 секунд",
			ИмяДокумента,
			ЧислоСтрокой(Перепроведено),
			ЧислоСтрокой(ПодходитПоДате),
			ЧислоСтрокой(ЛимитВремениНаВидМс / 1000)));
	ИначеЕсли КоличествоНаВид > 1 Тогда
		ЗаписатьИнфо(СтрШаблон(
			"Документ.%1: перепроведено %2 (запрошено %3; последних проведённых не старше границы даты - %4)",
			ИмяДокумента,
			ЧислоСтрокой(Перепроведено),
			ЧислоСтрокой(КоличествоНаВид),
			ЧислоСтрокой(ПодходитПоДате)));
	КонецЕсли;

КонецПроцедуры

Функция ПерепровестиДокументВТранзакции(Ссылка, МетаданныеДокумента)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Сообщения", "");
	Результат.Вставить("ДлительностьМс", 0);
	Результат.Вставить("ДвиженийДо", 0);
	Результат.Вставить("ДвиженийПосле", 0);
	Результат.Вставить("Расхождения", "");
	Результат.Вставить("РасхожденияТолькоПодВыключателем", Ложь);

	ПроверитьЧтоЗаписьРазрешена();
	ПолучитьСообщенияПользователю(Истина);

	НачатьТранзакцию();
	Попытка

		Если ПараметрыЗапуска.ОтключатьПочту = Истина Тогда
			ОтключитьПочтуВТранзакции();
		КонецЕсли;

		ДвиженияДо = КоличествоДвиженийДокумента(Ссылка, МетаданныеДокумента);

		ДокументОбъект = Ссылка.ПолучитьОбъект();

		НачалоПроведения = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Проведено = Ложь;
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Проведено = Истина;
		Исключение
			Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроведения;

		// После неудачной записи читать базу в этой транзакции нельзя, поэтому движения сравниваются только при успехе.
		Если Проведено Тогда

			ДвиженияПосле = КоличествоДвиженийДокумента(Ссылка, МетаданныеДокумента);

			// ** Хлебников С.Ю. 20261117 Регистры, расхождения в которых объясняет пакет (например, выключатель записей
			// «Состояния обеспечения»: у документов из копии рабочей базы этих записей не было).
			РегистрыПодВыключателем = РегистрыСОбъяснимымиРасхождениямиПакета(МетаданныеДокумента.Имя);
			РасхожденийПодВыключателем = 0;

			Расхождения = Новый Массив;
			Для Каждого ЭлементДо Из ДвиженияДо Цикл
				Результат.ДвиженийДо = Результат.ДвиженийДо + ЭлементДо.Значение;
				КоличествоПосле = ДвиженияПосле.Получить(ЭлементДо.Ключ);
				КоличествоПосле = ?(КоличествоПосле = Неопределено, 0, КоличествоПосле);
				Результат.ДвиженийПосле = Результат.ДвиженийПосле + КоличествоПосле;
				Если КоличествоПосле <> ЭлементДо.Значение Тогда
					Расхождения.Добавить(ЭлементДо.Ключ + ": " + ЧислоСтрокой(ЭлементДо.Значение) + " -> " + ЧислоСтрокой(КоличествоПосле));
					Если РегистрыПодВыключателем.Найти(ЭлементДо.Ключ) <> Неопределено Тогда
						РасхожденийПодВыключателем = РасхожденийПодВыключателем + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Результат.Расхождения = СтрСоединить(Расхождения, "; ");

			// Записи «Состояния обеспечения», которые включает настройка: у документов из копии рабочей базы их не было.
			Результат.РасхожденияТолькоПодВыключателем = Расхождения.Количество() > 0
				И РасхожденийПодВыключателем = Расхождения.Количество();

			Результат.Успех = Истина;

		КонецЕсли;

		ОтменитьТранзакцию();

	Исключение
		Результат.ТекстОшибки = "Тест не дошёл до проведения: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;

	Результат.Сообщения = ТекстНакопленныхСообщений();

	Возврат Результат;

КонецФункции

// Возвращает количество записей документа в каждом регистре из его движений.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: полное имя регистра, значение: количество записей.
//
Функция КоличествоДвиженийДокумента(Ссылка, МетаданныеДокумента)

	Результат = Новый Соответствие;

	ШаблонЗапроса =
	"ВЫБРАТЬ
	|	""#Регистр#"" КАК Регистр,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	#Регистр# КАК Т
	|ГДЕ
	|	Т.Регистратор = &Ссылка";

	ТекстыЗапросов = Новый Массив;
	Для Каждого МетаданныеРегистра Из МетаданныеДокумента.Движения Цикл

		ТекстыЗапросов.Добавить(СтрЗаменить(ШаблонЗапроса, "#Регистр#", МетаданныеРегистра.ПолноеИмя()));

		Если ТекстыЗапросов.Количество() = 40 Тогда
			ДополнитьКоличествоДвижений(Результат, ТекстыЗапросов, Ссылка);
			ТекстыЗапросов = Новый Массив;
		КонецЕсли;

	КонецЦикла;

	Если ТекстыЗапросов.Количество() > 0 Тогда
		ДополнитьКоличествоДвижений(Результат, ТекстыЗапросов, Ссылка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ДополнитьКоличествоДвижений(Результат, ТекстыЗапросов, Ссылка)

	Разделитель = Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;

	Запрос = Новый Запрос(СтрСоединить(ТекстыЗапросов, Разделитель));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Регистр, Выборка.Количество);
	КонецЦикла;

КонецПроцедуры

Процедура ОценитьПерепроведение(Результат, Ссылка)

	Представление = Строка(Ссылка) + " (" + ЧислоСтрокой(Результат.ДлительностьМс) + " мс)";

	Если Результат.Успех Тогда

		Если ПустаяСтрока(Результат.Расхождения) Тогда
			ЗаписатьОК(СтрШаблон("%1: перепроведён, движений %2, как и было", Представление, ЧислоСтрокой(Результат.ДвиженийПосле)));
		ИначеЕсли Результат.РасхожденияТолькоПодВыключателем Тогда
			ЗаписатьОК(СтрШаблон(
				"%1: перепроведён; изменилось только число записей «Состояния обеспечения», которые включает настройка (движений было %2, стало %3): %4",
				Представление,
				ЧислоСтрокой(Результат.ДвиженийДо),
				ЧислоСтрокой(Результат.ДвиженийПосле),
				ОбрезатьТекст(Результат.Расхождения, 2000)));
		Иначе
			ЗаписатьВнимание(СтрШаблон("%1: перепроведён, но количество движений изменилось (было %2, стало %3): %4",
				Представление,
				ЧислоСтрокой(Результат.ДвиженийДо),
				ЧислоСтрокой(Результат.ДвиженийПосле),
				ОбрезатьТекст(Результат.Расхождения, 2000)));
		КонецЕсли;

		Если Не ПустаяСтрока(Результат.Сообщения) Тогда
			ЗаписатьИнфо("    сообщения при проведении: " + ОбрезатьТекст(Результат.Сообщения, 1000));
		КонецЕсли;

		Возврат;

	КонецЕсли;

	ОписаниеНеудачи = ОписаниеНеудачиПроведения(Результат);

	Если ЭтоОшибкаВКодеРасширений(Результат.ТекстОшибки)
		И Не (ПараметрыЗапуска.ОтключатьПочту = Истина И ЭтоОшибкаОтправкиПочты(Результат.ТекстОшибки)) Тогда
		// ** Хлебников С.Ю. 20261117 слово о наших расширениях в тексте записи берётся у пакета
		ЗаписатьОшибку(Представление + ": не перепроведён, исключение возникло в коде расширений" + ПометкаНашихРасширений() + "." + Символы.ПС + ОписаниеНеудачи);
	Иначе
		// ** Хлебников С.Ю. 20261117 слово о наших расширениях в тексте записи берётся у пакета
		ЗаписатьВнимание(Представление + ": не перепроведён. В тексте ошибки нет модулей расширений" + ПометкаНашихРасширений() + ": вероятнее всего, отказ типового кода или данных"
			+ " (дата запрета, остатки, статус), но посмотреть нужно." + Символы.ПС + ОписаниеНеудачи);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОперацииСОбъектами

// Возвращает часть элемента шага: элемент записывается как "Вид|Имя".
Функция ЧастьЭлементаШага(ЭлементШага, НомерЧасти)

	ЧастиЭлемента = СтрРазделить(ЭлементШага, "|", Истина);

	Возврат ?(ЧастиЭлемента.Количество() > НомерЧасти, ЧастиЭлемента[НомерЧасти], "");

КонецФункции

// Записывает объект внутри транзакции, которая всегда отменяется.
//
// Параметры:
//  ОбъектДляЗаписи - ДокументОбъект, СправочникОбъект - объект, который записывается.
//  РежимЗаписи     - РежимЗаписиДокумента, Неопределено - для справочников не задаётся.
//
// Возвращаемое значение:
//  Структура - ключи Успех, ТекстОшибки, Сообщения, ДлительностьМс.
//
Функция ЗаписатьОбъектВОтменяемойТранзакции(ОбъектДляЗаписи, РежимЗаписи = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Сообщения", "");
	Результат.Вставить("ДлительностьМс", 0);

	ПроверитьЧтоЗаписьРазрешена();
	ПолучитьСообщенияПользователю(Истина);

	НачатьТранзакцию();
	Попытка

		Если ПараметрыЗапуска.ОтключатьПочту = Истина Тогда
			ОтключитьПочтуВТранзакции();
		КонецЕсли;

		НачалоЗаписи = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			Если РежимЗаписи = Неопределено Тогда
				ОбъектДляЗаписи.Записать();
			Иначе
				ОбъектДляЗаписи.Записать(РежимЗаписи);
			КонецЕсли;
			Результат.Успех = Истина;
		Исключение
			Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Результат.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗаписи;

		ОтменитьТранзакцию();

	Исключение
		Результат.ТекстОшибки = "Тест не дошёл до записи: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;

	Результат.Сообщения = ТекстНакопленныхСообщений();

	Возврат Результат;

КонецФункции

// Оценивает результат операции с записью в базу: исключение в коде наших расширений - ошибка,
// остальные отказы - внимание (как правило, это прикладной отказ типового кода).
Процедура ОценитьОперациюСЗаписью(ОписаниеОперации, Результат)

	Длительность = " (" + ЧислоСтрокой(Результат.ДлительностьМс) + " мс)";

	Если Результат.Успех Тогда
		ЗаписатьОК(ОписаниеОперации + ": выполнено, транзакция отменена" + Длительность);
		Возврат;
	КонецЕсли;

	ОписаниеНеудачи = ОписаниеНеудачиПроведения(Результат);

	Если ЭтоОшибкаВКодеРасширений(Результат.ТекстОшибки)
		И Не (ПараметрыЗапуска.ОтключатьПочту = Истина И ЭтоОшибкаОтправкиПочты(Результат.ТекстОшибки)) Тогда
		// ** Хлебников С.Ю. 20261117 слово о наших расширениях в тексте записи берётся у пакета
		ЗаписатьОшибку(ОписаниеОперации + ": исключение возникло в коде расширений" + ПометкаНашихРасширений() + Длительность + "."
			+ Символы.ПС + ОписаниеНеудачи);
	Иначе
		// ** Хлебников С.Ю. 20261117 слово о наших расширениях в тексте записи берётся у пакета
		ЗаписатьВнимание(ОписаниеОперации + ": не выполнено" + Длительность + ". В тексте ошибки нет модулей расширений" + ПометкаНашихРасширений() + ":"
			+ " вероятнее всего, это прикладной отказ, но посмотреть нужно." + Символы.ПС + ОписаниеНеудачи);
	КонецЕсли;

КонецПроцедуры

// Оценивает исключение операции, которая выполнялась в памяти, без записи в базу.
Процедура ОценитьИсключениеОперации(ОписаниеОперации, ТекстОшибки)

	Если ЭтоОшибкаВКодеРасширений(ТекстОшибки) Тогда
		// ** Хлебников С.Ю. 20261117 слово о наших расширениях в тексте записи берётся у пакета
		ЗаписатьОшибку(ОписаниеОперации + ": исключение возникло в коде расширений" + ПометкаНашихРасширений() + "." + Символы.ПС
			+ ОбрезатьТекст(ТекстОшибки, 2500));
	Иначе
		// ** Хлебников С.Ю. 20261117 слово о наших расширениях в тексте записи берётся у пакета
		ЗаписатьВнимание(ОписаниеОперации + ": исключение, в тексте ошибки нет модулей расширений" + ПометкаНашихРасширений() + "." + Символы.ПС
			+ ОбрезатьТекст(ТекстОшибки, 2500));
	КонецЕсли;

КонецПроцедуры

// Один раз за шаг пишет в журнал, какие операции с записью в базу будут выполняться.
Процедура ЗаписатьУсловияОперацийСЗаписью()

	Если Не ЗаписьРазрешена() Тогда
		ЗаписатьПропуск("Операции с записью в базу не выполняются: " + ПричинаЗапретаЗаписи()
			+ ". Выполняются только операции в памяти.");
		Возврат;
	КонецЕсли;

	Если Не ПочтаГотоваКПроведению() Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Функция ПоследняяПроведеннаяСсылка(ИмяДокумента)

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка,
	|	Т.Дата КАК Дата
	|ИЗ
	|	Документ.#Документ# КАК Т
	|ГДЕ
	|	Т.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";

	Попытка

		Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "#Документ#", ИмяДокумента));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#Область ОперацииСДокументами

// Элементы шага «Операции с документами»: подготовка и по одному на вид документов.
Функция ЭлементыОперацийСДокументами()

	ЭлементыШага = Новый Массив;

	ДобавитьЭлементШага(ЭлементыШага, "Начало", "Операции с документами: подготовка");

	Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "Документ|" + ИмяДокумента, "Документ." + ИмяДокумента + ", операции");
	КонецЦикла;

	Возврат ЭлементыШага;

КонецФункции

// Параметры:
//  ЭлементШага - Строка - элемент из ЭлементыОперацийСДокументами; пустая строка - все элементы одним вызовом.
//
Процедура ТестОперацииСДокументами(ЭлементШага)

	ВидЭлемента = ЧастьЭлементаШага(ЭлементШага, 0);
	ШагЦеликом = ПустаяСтрока(ЭлементШага);

	Если ШагЦеликом Или ВидЭлемента = "Начало" Тогда
		ЗаписатьИнфо("По каждому виду документов, у которого в расширениях есть модуль: новый документ и заполнение по умолчанию,"
			+ " проверка заполнения последнего документа и его копирование - в памяти; запись копии без проведения -"
			+ " в транзакции, которая отменяется. Копия не проводится: проведение нового документа чаще всего упирается"
			+ " в остатки и даты, а не в код. Отмена проведения вынесена в отдельный шаг в конце прогона.");
		ЗаписатьУсловияОперацийСЗаписью();
	КонецЕсли;

	Если ШагЦеликом Тогда
		Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
			ПроверитьОперацииСДокументом(ИмяДокумента);
		КонецЦикла;
	ИначеЕсли ВидЭлемента = "Документ" Тогда
		ПроверитьОперацииСДокументом(ЧастьЭлементаШага(ЭлементШага, 1));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОперацииСДокументом(ИмяДокумента)

	Представление = "Документ." + ИмяДокумента;

	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		ЗаписатьПропуск(Представление + ": нет в конфигурации");
		Возврат;
	КонецЕсли;

	ЗаписьДоступна = ЗаписьРазрешена() И ПочтаГотоваКПроведению(Истина);

	// 1. Новый документ и заполнение по умолчанию, в памяти.
	Попытка
		НовыйДокумент = Документы[ИмяДокумента].СоздатьДокумент();
		НовыйДокумент.Заполнить(Неопределено);
		ЗаписатьОК(Представление + ": новый документ создаётся и заполняется по умолчанию");
	Исключение
		ОценитьИсключениеОперации(Представление + ": новый документ, заполнение по умолчанию",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	НовыйДокумент = Неопределено;

	СсылкаДокумента = ПоследняяСсылка("Документ." + ИмяДокумента, Истина);
	Если СсылкаДокумента = Неопределено Тогда
		ЗаписатьИнфо(Представление + ": документов нет, операции с существующим документом не проверялись");
		Возврат;
	КонецЕсли;

	ПредставлениеДокумента = Представление + ", «" + Строка(СсылкаДокумента) + "»";

	// 2. Проверка заполнения, в памяти.
	Попытка
		ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
		ЗаполненВерно = ДокументОбъект.ПроверитьЗаполнение();
		ЗаписатьОК(ПредставлениеДокумента + ": проверка заполнения выполняется, результат: "
			+ ?(ЗаполненВерно, "замечаний нет", "есть замечания"));
	Исключение
		ОценитьИсключениеОперации(ПредставлениеДокумента + ": проверка заполнения",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДокументОбъект = Неопределено;
	ПолучитьСообщенияПользователю(Истина);

	// 3. Копирование в памяти и запись копии без проведения в транзакции.
	КопияДокумента = Неопределено;
	Попытка
		КопияДокумента = СсылкаДокумента.Скопировать();
		КопияДокумента.Дата = ТекущаяДатаСеанса();
		ЗаписатьОК(ПредставлениеДокумента + ": копируется");
	Исключение
		КопияДокумента = Неопределено;
		ОценитьИсключениеОперации(ПредставлениеДокумента + ": копирование",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если КопияДокумента <> Неопределено И ЗаписьДоступна Тогда
		Если ДокументИсключен(ИмяДокумента) Тогда
			ЗаписатьПропуск(Представление + ": вид указан в поле «Не проводить документы», запись копии пропущена");
		Иначе
			ОценитьОперациюСЗаписью(ПредставлениеДокумента + ": запись копии без проведения",
				ЗаписатьОбъектВОтменяемойТранзакции(КопияДокумента, РежимЗаписиДокумента.Запись));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Элементы шага «Отмена проведения документов»: подготовка и по одному на вид документов.
Функция ЭлементыОтменыПроведенияДокументов()

	ЭлементыШага = Новый Массив;

	ДобавитьЭлементШага(ЭлементыШага, "Начало", "Отмена проведения документов: подготовка");

	Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
		ДобавитьЭлементШага(ЭлементыШага, "Документ|" + ИмяДокумента, "Документ." + ИмяДокумента + ", отмена проведения");
	КонецЦикла;

	Возврат ЭлементыШага;

КонецФункции

// Параметры:
//  ЭлементШага - Строка - элемент из ЭлементыОтменыПроведенияДокументов; пустая строка - все элементы одним вызовом.
//
Процедура ТестОтменаПроведенияДокументов(ЭлементШага)

	ВидЭлемента = ЧастьЭлементаШага(ЭлементШага, 0);
	ШагЦеликом = ПустаяСтрока(ЭлементШага);

	Если ШагЦеликом Или ВидЭлемента = "Начало" Тогда

		ЗаписатьИнфо("По каждому виду документов, у которого в расширениях есть модуль: у последнего проведённого документа"
			+ " отменяется проведение в транзакции, которая отменяется. Типовой код может отклонить отмену"
			+ " (есть последующие документы, закрытый период), это не ошибка расширений.");

		Если Не ПроведениеРазрешено() Тогда
			ЗаписатьПропуск("Отмена проведения не выполняется: " + ПричинаЗапретаПроведения() + ".");
		Иначе
			ПочтаГотоваКПроведению();
		КонецЕсли;

	КонецЕсли;

	Если ШагЦеликом Тогда
		Для Каждого ИмяДокумента Из ОбъектыПакета("ДокументыДляПерепроведения") Цикл
			ПроверитьОтменуПроведенияДокумента(ИмяДокумента);
		КонецЦикла;
	ИначеЕсли ВидЭлемента = "Документ" Тогда
		ПроверитьОтменуПроведенияДокумента(ЧастьЭлементаШага(ЭлементШага, 1));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОтменуПроведенияДокумента(ИмяДокумента)

	Представление = "Документ." + ИмяДокумента;

	Если Не ПроведениеРазрешено() Или Не ПочтаГотоваКПроведению(Истина) Тогда
		Возврат;
	КонецЕсли;

	МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаданныеДокумента = Неопределено Тогда
		ЗаписатьПропуск(Представление + ": нет в конфигурации");
		Возврат;
	КонецЕсли;

	Если МетаданныеДокумента.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		ЗаписатьИнфо(Представление + ": не проводится, пропущен");
		Возврат;
	КонецЕсли;

	Если ДокументИсключен(ИмяДокумента) Тогда
		ЗаписатьПропуск(Представление + ": вид указан в поле «Не проводить документы», отмена проведения пропущена");
		Возврат;
	КонецЕсли;

	СсылкаПроведенного = ПоследняяПроведеннаяСсылка(ИмяДокумента);
	Если СсылкаПроведенного = Неопределено Тогда
		ЗаписатьИнфо(Представление + ": проведённых документов нет");
		Возврат;
	КонецЕсли;

	ДатаПроведенного = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаПроведенного, "Дата");
	Если ДатаПроведенного < ГраницаДатыДокументовДляЗаписи() Тогда
		ЗаписатьПропуск(Представление + ": " + ПояснениеОСтаромДокументе(ДатаПроведенного) + ".");
		Возврат;
	КонецЕсли;

	ПредставлениеПроведенного = Представление + ", «" + Строка(СсылкаПроведенного) + "»";

	Попытка
		ДокументОбъект = СсылкаПроведенного.ПолучитьОбъект();
	Исключение
		ОценитьИсключениеОперации(ПредставлениеПроведенного + ": получение объекта",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ОценитьОперациюСЗаписью(ПредставлениеПроведенного + ": отмена проведения",
		ЗаписатьОбъектВОтменяемойТранзакции(ДокументОбъект, РежимЗаписиДокумента.ОтменаПроведения));

КонецПроцедуры

#КонецОбласти

#Область ОперацииСоСправочниками

// Справочники, у которых в расширениях есть модуль объекта или модуль менеджера.
Функция ИменаСправочниковДляОпераций()

	Результат = Новый Массив;

	ДобавитьИменаСправочников(Результат, ОбъектыПакета("МодулиОбъектов"));
	ДобавитьИменаСправочников(Результат, ОбъектыПакета("МодулиМенеджеров"));

	Возврат Результат;

КонецФункции

Процедура ДобавитьИменаСправочников(ИменаСправочников, ПолныеИмена)

	Приставка = "Справочники.";

	Для Каждого ПолноеИмя Из ПолныеИмена Цикл

		Если Не СтрНачинаетсяС(ПолноеИмя, Приставка) Тогда
			Продолжить;
		КонецЕсли;

		ИмяСправочника = Сред(ПолноеИмя, СтрДлина(Приставка) + 1);
		Если ИменаСправочников.Найти(ИмяСправочника) = Неопределено Тогда
			ИменаСправочников.Добавить(ИмяСправочника);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Элементы шага «Операции со справочниками»: подготовка и по одному на справочник.
Функция ЭлементыОперацийСоСправочниками()

	ЭлементыШага = Новый Массив;

	ДобавитьЭлементШага(ЭлементыШага, "Начало", "Операции со справочниками: подготовка");

	Для Каждого ИмяСправочника Из ИменаСправочниковДляОпераций() Цикл
		ДобавитьЭлементШага(ЭлементыШага, "Справочник|" + ИмяСправочника, "Справочник." + ИмяСправочника + ", операции");
	КонецЦикла;

	Возврат ЭлементыШага;

КонецФункции

// Параметры:
//  ЭлементШага - Строка - элемент из ЭлементыОперацийСоСправочниками; пустая строка - все элементы одним вызовом.
//
Процедура ТестОперацииСоСправочниками(ЭлементШага)

	ВидЭлемента = ЧастьЭлементаШага(ЭлементШага, 0);
	ШагЦеликом = ПустаяСтрока(ЭлементШага);

	Если ШагЦеликом Или ВидЭлемента = "Начало" Тогда
		ЗаписатьИнфо("По каждому справочнику, у которого в расширениях есть модуль: новый элемент и заполнение по умолчанию,"
			+ " проверка заполнения существующего элемента и его копирование - в памяти; запись элемента без изменений"
			+ " и запись копии - в транзакции, которая отменяется. Копию типовой код может отклонить"
			+ " (уникальность кода или наименования), это не ошибка расширений.");
		ЗаписатьУсловияОперацийСЗаписью();
	КонецЕсли;

	Если ШагЦеликом Тогда
		Для Каждого ИмяСправочника Из ИменаСправочниковДляОпераций() Цикл
			ПроверитьОперацииСоСправочником(ИмяСправочника);
		КонецЦикла;
	ИначеЕсли ВидЭлемента = "Справочник" Тогда
		ПроверитьОперацииСоСправочником(ЧастьЭлементаШага(ЭлементШага, 1));
	КонецЕсли;

КонецПроцедуры

// Возвращает элемент справочника для проверки: не группа, не предопределённый, не помеченный на удаление.
Функция ЭлементСправочникаДляПроверки(ИмяСправочника, МетаданныеСправочника)

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.#Справочник# КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|	И НЕ Т.Предопределенный";

	ЕстьГруппы = МетаданныеСправочника.Иерархический
		И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	Если ЕстьГруппы Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И НЕ Т.ЭтоГруппа";
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "#Справочник#", ИмяСправочника));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;

	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьОперацииСоСправочником(ИмяСправочника)

	Представление = "Справочник." + ИмяСправочника;

	МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаданныеСправочника = Неопределено Тогда
		ЗаписатьПропуск(Представление + ": нет в конфигурации");
		Возврат;
	КонецЕсли;

	ЗаписьДоступна = ЗаписьРазрешена() И ПочтаГотоваКПроведению(Истина);

	// 1. Новый элемент и заполнение по умолчанию, в памяти.
	Попытка
		НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
		НовыйЭлемент.Заполнить(Неопределено);
		ЗаписатьОК(Представление + ": новый элемент создаётся и заполняется по умолчанию");
	Исключение
		ОценитьИсключениеОперации(Представление + ": новый элемент, заполнение по умолчанию",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	НовыйЭлемент = Неопределено;

	СсылкаЭлемента = ЭлементСправочникаДляПроверки(ИмяСправочника, МетаданныеСправочника);
	Если СсылкаЭлемента = Неопределено Тогда
		ЗаписатьИнфо(Представление + ": подходящих элементов нет, операции с существующим элементом не проверялись");
		Возврат;
	КонецЕсли;

	ПредставлениеЭлемента = Представление + ", «" + Строка(СсылкаЭлемента) + "»";

	// 2. Проверка заполнения, в памяти.
	Попытка
		ЭлементОбъект = СсылкаЭлемента.ПолучитьОбъект();
		ЗаполненВерно = ЭлементОбъект.ПроверитьЗаполнение();
		ЗаписатьОК(ПредставлениеЭлемента + ": проверка заполнения выполняется, результат: "
			+ ?(ЗаполненВерно, "замечаний нет", "есть замечания"));
	Исключение
		ОценитьИсключениеОперации(ПредставлениеЭлемента + ": проверка заполнения",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЭлементОбъект = Неопределено;
	ПолучитьСообщенияПользователю(Истина);

	// 3. Запись элемента без изменений, в транзакции.
	Если ЗаписьДоступна Тогда

		ЭлементОбъект = Неопределено;
		Попытка
			ЭлементОбъект = СсылкаЭлемента.ПолучитьОбъект();
		Исключение
			ЭлементОбъект = Неопределено;
			ОценитьИсключениеОперации(ПредставлениеЭлемента + ": получение объекта",
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		Если ЭлементОбъект <> Неопределено Тогда
			ОценитьОперациюСЗаписью(ПредставлениеЭлемента + ": запись без изменений",
				ЗаписатьОбъектВОтменяемойТранзакции(ЭлементОбъект));
		КонецЕсли;
		ЭлементОбъект = Неопределено;

	КонецЕсли;

	// 4. Копирование в памяти и запись копии в транзакции.
	КопияЭлемента = Неопределено;
	Попытка
		КопияЭлемента = СсылкаЭлемента.Скопировать();
		ЗаписатьОК(ПредставлениеЭлемента + ": копируется");
	Исключение
		КопияЭлемента = Неопределено;
		ОценитьИсключениеОперации(ПредставлениеЭлемента + ": копирование",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если КопияЭлемента <> Неопределено И ЗаписьДоступна Тогда
		ОценитьОперациюСЗаписью(ПредставлениеЭлемента + ": запись копии",
			ЗаписатьОбъектВОтменяемойТранзакции(КопияЭлемента));
	КонецЕсли;

КонецПроцедуры

