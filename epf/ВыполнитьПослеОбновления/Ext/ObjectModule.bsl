Процедура ЗаписатьВЖурнал(Пометка, Знач ТекстЗаписи)

	// Отступ продолжения равен ширине времени и пометки.
	ОтступПродолжения = "                    ";

	ЧастиТекста = СтрРазделить(Строка(ТекстЗаписи), Символы.ПС, Истина);
	Для Индекс = 0 По ЧастиТекста.ВГраница() Цикл

		ЧастьТекста = СтрЗаменить(ЧастиТекста[Индекс], Символы.ВК, "");
		Если Индекс = 0 Тогда
			СтрокиЖурнала.Добавить(Формат(ТекущаяДатаСеанса(), "ДФ=HH:mm:ss") + " " + Пометка + " " + ЧастьТекста);
		Иначе
			СтрокиЖурнала.Добавить(ОтступПродолжения + ЧастьТекста);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьОК(ТекстЗаписи)

	СчетчикиЖурнала.ОК = СчетчикиЖурнала.ОК + 1;
