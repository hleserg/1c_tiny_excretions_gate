	СчетчикиЖурнала.Пропусков = СчетчикиЖурнала.Пропусков + 1;
	ЗаписатьВЖурнал("[ПРОПУСК] ", ТекстЗаписи);

КонецПроцедуры

// ** Хлебников С.Ю. 20261117
// Снимок для сравнения «до» и «после» загрузки: текст (сообщение обмена, движения, печатная форма), который гейт
// сохраняет и сравнивает с таким же снимком прогона «до» или эталона. Снимки берутся только при автозапуске
// гейтом (в параметрах шага Снимки = Истина); в журнал не пишутся. Блок для части журнала:
//  @@snap <ключ>, строки текста с «|» в начале, @@snap-end.
//
// Параметры:
//  Ключ - Строка - постоянный ключ снимка: по нему гейт находит пару «до» и «после».
//  Текст - Строка - содержимое снимка.
//
Процедура ЗаписатьСнимок(Ключ, Текст)

	Если Не ПараметрыЗапуска.Свойство("Снимки") Или ПараметрыЗапуска.Снимки <> Истина Тогда
		Возврат;
	КонецЕсли;

	СтрокиБлока = Новый Массив;
	СтрокиБлока.Добавить("@@snap " + СтрЗаменить(СтрЗаменить(Ключ, Символы.ПС, " "), Символы.ВК, ""));
	Для Каждого СтрокаТекста Из СтрРазделить(СтрЗаменить(Строка(Текст), Символы.ВК, ""), Символы.ПС, Истина) Цикл
		СтрокиБлока.Добавить("|" + СтрокаТекста);
	КонецЦикла;
	СтрокиБлока.Добавить("@@snap-end");
	СнимкиШага.Добавить(СтрСоединить(СтрокиБлока, Символы.ПС));

КонецПроцедуры

Процедура ЗаписатьИнфо(ТекстЗаписи)

	ЗаписатьВЖурнал("[ИНФО]    ", ТекстЗаписи);

КонецПроцедуры

Процедура Проверить(Условие, ОписаниеПроверки, ПодробностиПриОшибке = "")

	Если Условие = Истина Тогда
		ЗаписатьОК(ОписаниеПроверки);
	ИначеЕсли ПустаяСтрока(ПодробностиПриОшибке) Тогда
		ЗаписатьОшибку(ОписаниеПроверки + " - НЕ ВЫПОЛНЕНО");
	Иначе
		ЗаписатьОшибку(ОписаниеПроверки + " - НЕ ВЫПОЛНЕНО" + Символы.ПС + ПодробностиПриОшибке);
	КонецЕсли;

КонецПроцедуры

