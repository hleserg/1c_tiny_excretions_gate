		+ ".card.wait{opacity:.55}.card.wait .nm{color:#7d869e;font-weight:400}"
		+ ".card.run{background:#18203a;border-color:#5a56e0;box-shadow:0 0 0 1px rgba(90,86,224,.35),"
		+ "0 6px 18px rgba(90,86,224,.18)}"
		+ ".card.run .dot{background:#8f8cf5;animation:pulse 1.4s ease-in-out infinite}"
		+ "@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(143,140,245,.7)}"
		+ "50%{box-shadow:0 0 0 6px rgba(143,140,245,0)}}"
		+ ".card.ok .dot{background:#3ec7a0}.card.ok .fill{background:#2fb57a}"
		+ ".card.prev .dot{background:#4f8f7a}.card.prev .fill{background:#2f6a5a}"
		+ ".card.part .dot{background:#5a56e0}"
		+ ".card.warn{border-color:#4d3d1c}.card.warn .dot{background:#f0b54a}.card.warn .fill{background:#d9a03c}"
		+ ".card.bad{border-color:#6a2636;background:#1d1219}.card.bad .dot{background:#ff6b7f}"
		+ ".card.bad .fill{background:#d9475b}"
		+ ".foot{margin-top:12px;color:#59627a;font-size:11px}"
		+ "@media (max-width:760px){.card{width:calc(50% - 10px)}}";

	// Анимации не начинаются заново при каждом обновлении: задержка ставится по общим часам страницы.
	// Время на экране тикает само между обновлениями: data-base - секунды на момент обновления.
	Скрипт = "var ciAt=new Date().getTime();"
		+ "function ciSync(){var a=document.querySelectorAll('.anim'),t=new Date().getTime();"
		+ "for(var i=0;i<a.length;i++){a[i].style.animationDelay=(-(t%2200)/1000)+'s';}}"
		+ "function ciFmt(s){s=Math.max(0,Math.floor(s));var h=Math.floor(s/3600),m=Math.floor(s%3600/60),c=s%60;"
		+ "return (h>0?h+':'+(m<10?'0':''):'')+m+':'+(c<10?'0':'')+c;}"
		+ "function ciTick(){var e=document.querySelectorAll('.tick'),d=(new Date().getTime()-ciAt)/1000;"
		+ "for(var i=0;i<e.length;i++){if(e[i].getAttribute('data-run')=='1'){"
		+ "e[i].innerHTML=ciFmt(parseInt(e[i].getAttribute('data-base'),10)+d);}}}"
		+ "function ciUpdate(h){document.getElementById('dyn').innerHTML=h;ciAt=new Date().getTime();"
		+ "ciSync();return 1;}"
		+ "window.onload=function(){ciSync();setInterval(ciTick,1000);};";

	Возврат "<!DOCTYPE html><html><head><meta charset=""utf-8"">"
		+ "<meta http-equiv=""X-UA-Compatible"" content=""IE=edge"">"
		+ "<style>" + Стили + "</style><script>" + Скрипт + "</script></head><body><div class=""wrap"" id=""dyn"">"
		+ ТекстЭкрана + "</div></body></html>";

КонецФункции

&НаКлиенте
Функция ИмяБазыДляПанели()

	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	Для Каждого Часть Из СтрРазделить(СтрокаСоединения, ";", Ложь) Цикл
		Если СтрНачинаетсяС(НРег(СокрЛП(Часть)), "ref=") Тогда
			Возврат СтрЗаменить(Сред(СокрЛП(Часть), 5), """", "");
		КонецЕсли;
	КонецЦикла;
	Возврат "база";

КонецФункции

&НаКлиенте
Функция ТекстДлительности(Знач Секунды)

	Секунды = Макс(0, Цел(Секунды));
	Часов = Цел(Секунды / 3600);
	Минут = Цел((Секунды - Часов * 3600) / 60);
	Секунд = Секунды - Часов * 3600 - Минут * 60;

	Текст = Формат(Минут, "ЧН=0; ЧГ=0") + ":" + Формат(Секунд, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	Если Часов > 0 Тогда
		Текст = Формат(Часов, "ЧГ=0") + ":" + Формат(Минут, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0") + ":"
			+ Формат(Секунд, "ЧЦ=2; ЧН=00; ЧВН=; ЧГ=0");
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаКлиенте
Функция ЧислоДляCSS(Значение)

	Возврат Формат(Окр(Значение, 1), "ЧРД=.; ЧН=0; ЧГ=0");

КонецФункции

&НаКлиенте
Функция ТекстДляHTML(Знач Текст)

	Текст = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Возврат СтрЗаменить(Текст, """", "&quot;");

КонецФункции

