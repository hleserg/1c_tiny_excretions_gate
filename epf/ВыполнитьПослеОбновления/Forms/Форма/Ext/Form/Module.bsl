// ** 20261113 Запускается после обновления расширений конфигурации, под полными правами.
// ** Хлебников С.Ю. 20261117 Шапка без подробностей конкретной базы: команды пакета описаны в его FormCommands.bsl.
//
// 1. Команда «Выполнить тестирование» проверяет всё, что добавлено в расширения, и собирает журнал.
//    Серверные тесты лежат в модуле объекта обработки и вызываются по шагам; здесь, на клиенте,
//    проверяются клиентские общие модули и формы. Тесты пишут в базу только внутри транзакции,
//    которая всегда отменяется, и только в базе, имя которой похоже на тестовое.
//
// 2. Команды пакета сценариев этой базы (например, настройки в регистре
//    или статья в базу знаний). Сборщик вставляет их на место метки @@ПАКЕТЫ: КОМАНДЫ@@; команды формы, которых нет
//    ни в одном пакете сборки, получают заглушку с предупреждением.
//
// 3. Автозапуск: если обработка открыта с параметром запуска /C"selfcheck;out=<папка>;...",
//    она сама выполняет тестирование, пишет журнал по частям в папку и завершает работу 1С. Так её запускает
//    гейт расширений. Без этого параметра форма работает кнопками. См. область АвтоматическийЗапуск.
//    Режимы regepf и unregepf записывают внешнюю обработку в справочник и снимают её оттуда,
//    см. область ВнешниеОбработкиСправочника.

#Область ОписаниеПеременных

// Состояние прогона тестирования: очередь заданий, номер текущего задания, части журнала, итоги.
// Неопределено, пока тестирование не выполняется.
&НаКлиенте
Перем ПрогонТестирования;

// Состояние дозаписи расхода в регистр заказанной номенклатуры: адрес списка документов, счётчики, части журнала,
// признак остановки. Неопределено, пока дозапись не выполняется.
&НаКлиенте
Перем СостояниеДозаписи;

// Состояние автозапуска: папка для файлов, номер очередной части журнала, отпечаток состояния базы.
// Неопределено, если обработка открыта вручную.
&НаКлиенте
Перем Автозапуск;

// ** Хлебников С.Ю. 20261117 Состояние экрана автозапуска: карточки шагов, счётчики, текущее задание.
// Неопределено, если обработка открыта вручную. См. область ПанельАвтозапуска.
&НаКлиенте
Перем ПанельАвтозапускаСостояние;
// ** Хлебников С.Ю. 20261117 конец

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Версия сборки подставляется при сборке обработки: ГГГГММДД.ЧЧММСС.
	ЭтотОбъект.Заголовок = "Выполнить после обновления, сборка 00000000.000000";

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	БазаТестовая = ОбработкаОбъект.БазаПохожаНаТестовую();

	// ** Хлебников С.Ю. 20261117 Экран автозапуска виден только при автозапуске, см. ПоказатьПанельАвтозапуска.
	Элементы.ПанельАвтозапуска.Видимость = Ложь;

	РазрешитьЗапись = БазаТестовая;
	ПроводитьДокументы = БазаТестовая;
	ОтключатьПочту = Истина;
	ПроверятьФормы = Истина;
	ПроверятьПрименимость = Истина;
	КоличествоДокументов = 1;

	// ** Хлебников С.Ю. 20261117 То, что форма делает для пакета этой базы.
	ПриСозданииНаСервереПакета();
	ДобавитьКомандыПакета(); // ** Хлебников С.Ю. 20261117 кнопки пакета - кодом, в форме ядра их нет

	// Журнал прошлого прогона сохраняется в хранилище настроек пользователя: если сеанс пришлось прервать,
	// журнал не теряется. Сохраняется только в тестовой базе.
	Попытка
		СостояниеПрогона = ХранилищеОбщихНастроек.Загрузить(КлючСостоянияПрогона(), "СостояниеПрогона");
	Исключение
		СостояниеПрогона = Неопределено;
	КонецПопытки;

	Если ТипЗнч(СостояниеПрогона) = Тип("Структура") Тогда
		ВосстановитьСостояниеПрогона(СостояниеПрогона);
	КонецЕсли;

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Кнопки пакета создаются кодом: в форме ядра нет команд конкретной базы.
// Пакет называет команду, заголовок и обработчик (процедуру из своих команд формы, см. docs/packages.md);
// кнопки встают перед полем названия статьи базы знаний.
&НаСервере
Процедура ДобавитьКомандыПакета()

	Для Каждого ОписаниеКоманды Из КомандыФормыПакета() Цикл
		КомандаПакета = Команды.Добавить(ОписаниеКоманды.Имя);
		КомандаПакета.Заголовок = ОписаниеКоманды.Заголовок;
		КомандаПакета.Действие = ОписаниеКоманды.Действие;
		КнопкаПакета = Элементы.Вставить(ОписаниеКоманды.Имя, Тип("КнопкаФормы"), ЭтотОбъект, Элементы.НазваниеСтатьиБазыЗнаний);
		КнопкаПакета.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		КнопкаПакета.ИмяКоманды = ОписаниеКоманды.Имя;
	КонецЦикла;

КонецПроцедуры
// ** Хлебников С.Ю. 20261117 конец


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Автозапуск: параметр запуска /C"selfcheck;out=<папка>;...". См. область АвтоматическийЗапуск.
	ПараметрыАвтозапуска = ПараметрыАвтозапускаИзСтроки(ПараметрЗапуска);
	Если ПараметрыАвтозапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// ** Хлебников С.Ю. 20261117 Режим kbarticle: только запись статьи, без тестирования
	Если ПараметрыАвтозапуска.Режим = "kbarticle" Тогда
		НачатьЗаписьСтатьиАвтозапуском(ПараметрыАвтозапуска);
		Возврат;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	// ** Хлебников С.Ю. 20261117 Режимы regepf и unregepf: внешняя обработка в справочнике, см. область ВнешниеОбработкиСправочника
	Если ПараметрыАвтозапуска.Режим = "regepf" Или ПараметрыАвтозапуска.Режим = "unregepf" Тогда
		НачатьРаботуСОбработкойАвтозапуском(ПараметрыАвтозапуска);
		Возврат;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	НачатьАвтозапуск(ПараметрыАвтозапуска);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьПередОбновлением(Команда)

	Если ПрогонТестирования <> Неопределено Тогда
		ПоказатьПредупреждение(, "Тестирование уже выполняется. Дождитесь окончания.");
		Возврат;
	КонецЕсли;

	ЧастиЖурнала = Новый Массив;
	ЧастиЖурнала.Добавить("Проверка перед обновлением (только чтение), сборка обработки 00000000.000000, "
		+ Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

	ИменаШагов = Новый Массив;
	ИменаШагов.Добавить("Окружение");
	ИменаШагов.Добавить("ПередОбновлением");

	Для Каждого ИмяШага Из ИменаШагов Цикл
		Попытка
			РезультатШага = ВыполнитьШагНаСервере(ИмяШага, "", Неопределено);
			ЧастиЖурнала.Добавить(РезультатШага.Текст);
		Исключение
			ЧастиЖурнала.Добавить("[ОШИБКА] Шаг «" + ИмяШага + "» не выполнен:" + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	ЖурналТестирования = СтрСоединить(ЧастиЖурнала, Символы.ПС);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТестирование(Команда)

	Если СостояниеДозаписи <> Неопределено Тогда
		ПоказатьПредупреждение(, "Идёт дозапись расхода заказанной номенклатуры. Дождитесь окончания.");
		Возврат;
	КонецЕсли;

	Если ПрогонТестирования <> Неопределено Тогда
		ПоказатьПредупреждение(, "Тестирование уже выполняется. Дождитесь окончания.");
		Возврат;
	КонецЕсли;

	ЧастиЖурнала = Новый Массив;
	Итоги = Новый Структура("ОК, Ошибок, Внимание, Пропусков", 0, 0, 0, 0);

	ЧастиЖурнала.Добавить("Самопроверка после обновления расширений, сборка обработки 00000000.000000. Начало: "
		+ Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

	Очередь = Новый Массив;

	// 1. Серверные задания: шаги тестирования, часть из них разбита по объектам.
	Попытка
		ЗаданияСервера = ЗаданияТестированияНаСервере();
	Исключение
		ДобавитьЗаписьЖурнала(ЧастиЖурнала, Итоги, "ОШИБКА",
			"Не удалось получить список заданий, тестирование не выполнено:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЖурналТестирования = СтрСоединить(ЧастиЖурнала, Символы.ПС);
		Возврат;
	КонецПопытки;

	// Задания с проведением реальных документов выполняются последними, после клиентских проверок:
	// серверный вызов нельзя прервать, и долгое проведение не должно задерживать остальное.
	ЗаданияВКонце = Новый Массив;
	Для Каждого ЗаданиеСервера Из ЗаданияСервера Цикл
		Если ЗаданиеСервера.ВКонце Тогда
			ЗаданияВКонце.Добавить(ЗаданиеСервера);
		Иначе
			Очередь.Добавить(ЗаданиеСервера);
		КонецЕсли;
	КонецЦикла;

	// 2. Клиентские общие модули, по одному заданию на модуль.
	ШагКлиентскихМодулей = "Компиляция клиентских общих модулей расширений";
	Попытка
		ИменаМодулей = КлиентскиеОбщиеМодулиНаСервере();
		Для Индекс = 0 По ИменаМодулей.ВГраница() Цикл
			Задание = НовоеЗадание("КлиентскийМодуль", ШагКлиентскихМодулей,
				"ОбщийМодуль." + ИменаМодулей[Индекс] + " (клиент)", Индекс = 0);
			Задание.Элемент = ИменаМодулей[Индекс];
			Очередь.Добавить(Задание);
		КонецЦикла;
	Исключение
		Очередь.Добавить(НовоеЗаданиеЗапись(ШагКлиентскихМодулей, Истина, "ОШИБКА",
			"Не удалось получить список клиентских модулей:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	// 3. Формы, по одному заданию на форму.
	ШагФорм = "Формы расширений";
	Если Не ПроверятьФормы Тогда
		Очередь.Добавить(НовоеЗаданиеЗапись(ШагФорм, Истина, "ПРОПУСК", "В форме снят флажок проверки форм."));
	Иначе
		Попытка
			ОписанияФорм = ФормыДляПроверкиНаСервере();
			Очередь.Добавить(НовоеЗаданиеЗапись(ШагФорм, Истина, "ИНФО",
				"Способ проверки: форма создаётся на клиенте и не открывается. При создании компилируется модуль формы"
			+ " вместе с частью из расширения и выполняется ПриСозданииНаСервере. Формам документов и элементов справочников"
			+ " передаётся последний объект, остальным параметры не передаются: вспомогательная форма без параметров может"
			+ " не создаться по своей логике, такие случаи помечены как «внимание»."
			+ " Сообщения, которыми формы объясняют отказ, обработка с экрана убирает: в журнал они попасть не могут."));
			Для Каждого ОписаниеФормы Из ОписанияФорм Цикл
				Задание = НовоеЗадание("Форма", ШагФорм, ОписаниеФормы.ПолноеИмя, Ложь);
				Задание.Вставить("ОписаниеФормы", ОписаниеФормы);
				Очередь.Добавить(Задание);
			КонецЦикла;
		Исключение
			Очередь.Добавить(НовоеЗаданиеЗапись(ШагФорм, Истина, "ОШИБКА",
				"Не удалось получить список форм:" + Символы.ПС
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;

	Для Каждого ЗаданиеСервера Из ЗаданияВКонце Цикл
		Очередь.Добавить(ЗаданиеСервера);
	КонецЦикла;

	// Журнал сохраняется в хранилище настроек только в тестовой базе: в рабочей обработка в базу не пишет ничего.
	СохранятьЖурнал = Ложь;
	Попытка
		СохранятьЖурнал = БазаТестоваяНаСервере();
	Исключение
		СохранятьЖурнал = Ложь;
	КонецПопытки;

	// Тесты с проведением берут документы не старше даты из поля «Документы не старше», а если оно пустое -
	// не старше начала месяца самого нового проведённого документа базы.
	ГраницаДатыДокументов = Неопределено;
	Если ЗначениеЗаполнено(ДокументыНеСтарше) Тогда
		ГраницаДатыДокументов = НачалоДня(ДокументыНеСтарше);
		ЧастиЖурнала.Добавить("Тесты с проведением берут документы не старше "
			+ Формат(ГраницаДатыДокументов, "ДФ=dd.MM.yyyy") + ": дата задана в поле «Документы не старше».");
	Иначе
		Попытка
			ГраницаДатыДокументов = ГраницаДатыДокументовНаСервере();
			ЧастиЖурнала.Добавить("Тесты с проведением берут документы не старше "
				+ Формат(ГраницаДатыДокументов, "ДФ=dd.MM.yyyy") + ": это начало месяца самого нового проведённого документа базы.");
		Исключение
			ГраницаДатыДокументов = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Прогон = Новый Структура;
	Прогон.Вставить("ГраницаДатыДокументов", ГраницаДатыДокументов);
	Прогон.Вставить("СохранятьЖурнал", СохранятьЖурнал);
	Прогон.Вставить("Очередь", Очередь);
	Прогон.Вставить("Номер", 0);
	Прогон.Вставить("ЗаданиеВРаботе", Ложь);
	Прогон.Вставить("ЧастиЖурнала", ЧастиЖурнала);
	Прогон.Вставить("Снимки", Новый Массив); // ** Хлебников С.Ю. 20261117 снимки для гейта, см. ЗаписатьЧастьЖурналаАвтозапуска
	Прогон.Вставить("Итоги", Итоги);
	Прогон.Вставить("ИтогиШага", Новый Структура("ОК, Ошибок, Внимание, Пропусков", 0, 0, 0, 0));
	Прогон.Вставить("НачалоШага", ТекущаяУниверсальнаяДатаВМиллисекундах());

	ПрогонТестирования = Прогон;
	ЖурналТестирования = СтрСоединить(ЧастиЖурнала, Символы.ПС);

	// Задания выполняются по одному в обработчике ожидания, см. Подключаемый_ВыполнитьОчередноеЗадание.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьОчередноеЗадание", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЖурнал(Команда)

	Если ПустаяСтрока(ЖурналТестирования) Тогда
		ПоказатьПредупреждение(, "Журнал пуст: тестирование ещё не выполнялось.");
		Возврат;
	КонецЕсли;

	ДокументЖурнала = Новый ТекстовыйДокумент;
	ДокументЖурнала.УстановитьТекст(ЖурналТестирования);
	ДокументЖурнала.Показать("Журнал самопроверки", "самопроверка_после_обновления.txt");

КонецПроцедуры

// @@ПАКЕТЫ: КОМАНДЫ@@

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// @@ПАКЕТЫ: ФОРМА@@

#Область Тестирование

// Выполняет одно задание из очереди и заказывает следующий вызов.
//
// Задания выполняются по одному, каждое своим вызовом: обращение к модулю, который не компилируется,
// платформа прерывает целиком, и перехватить такую ошибку нельзя ни на сервере, ни на клиенте.
// Прерванным оказывается одно задание, следующий вызов отмечает его в журнале и продолжает прогон.
&НаКлиенте
Процедура Подключаемый_ВыполнитьОчередноеЗадание()

	Прогон = ПрогонТестирования;
	Если Прогон = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Сообщения, которые показала платформа после прошлого задания, с экрана убираются. Это отказы форм,
	// созданных без параметров («не выбран…», «запуск возможен только из…»): к проверке они не относятся,
	// а прочитать их текст на клиенте и положить в журнал нельзя. Сообщения серверных шагов сюда не попадают:
	// шаги забирают их сами и пишут в журнал.
	ОчиститьСообщения();

	Очередь = Прогон.Очередь;

	// Прошлое задание не дошло до конца: платформа прервала вызов.
	Если Прогон.ЗаданиеВРаботе Тогда

		ПрерванноеЗадание = Очередь[Прогон.Номер];

		Если ПрерванноеЗадание.Вид = "Сервер" И ПустаяСтрока(ПрерванноеЗадание.Элемент) Тогда
			ДобавитьЗаголовокШага(Прогон, ПрерванноеЗадание.ПредставлениеШага);
		КонецЕсли;

		ЗаписатьВЖурналПрогона(Прогон, "ОШИБКА", ПрерванноеЗадание.Представление
			+ ": вызов прерван платформой, результата нет. Так бывает, когда модуль не компилируется:"
			+ " текст ошибки платформа показала в отдельном окне, перехватить его нельзя.");

		ЗавершитьЗадание(Прогон, ПрерванноеЗадание, Истина);

	КонецЕсли;

	Если Прогон.Номер > Очередь.ВГраница() Тогда
		ЗавершитьПрогон(Прогон);
		Возврат;
	КонецЕсли;

	// Автозапуск: сначала на диск пишется часть журнала с именем задания, которое сейчас начнётся.
	// Само задание выполняется следующим вызовом, после записи. См. ОбъявитьЗаданиеАвтозапуска.
	Если Автозапуск <> Неопределено Тогда
		Если Не Автозапуск.ЗаданиеОбъявлено Тогда
			ОбъявитьЗаданиеАвтозапуска(Прогон);
			Возврат;
		КонецЕсли;
		Автозапуск.ЗаданиеОбъявлено = Ложь;
	КонецЕсли;

	// Следующий вызов заказывается до выполнения задания: если платформа прервёт задание, прогон продолжится сам.
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьОчередноеЗадание", 0.1, Истина);

	Задание = Очередь[Прогон.Номер];

	Если Прогон.СохранятьЖурнал И (Задание.СохранятьЖурнал Или Прогон.Номер % 20 = 0) Тогда
		СохранитьСостояниеПрогона(Прогон, Задание.Представление, Задание.Элемент);
	КонецЕсли;

	Прогон.ЗаданиеВРаботе = Истина;

	Состояние("Самопроверка: " + Задание.ПредставлениеШага,
		Цел((Прогон.Номер + 1) * 100 / Очередь.Количество()), Задание.Представление);

	Если Задание.НачалоШага Тогда
		ДобавитьЗаголовокШага(Прогон, Задание.ПредставлениеШага);
	КонецЕсли;

	Если Задание.Вид = "Сервер" Тогда
		ВыполнитьСерверноеЗадание(Прогон, Задание);
	ИначеЕсли Задание.Вид = "КлиентскийМодуль" Тогда
		ПроверитьКлиентскийМодуль(Прогон, Задание);
	ИначеЕсли Задание.Вид = "Форма" Тогда
		ПроверитьФормуРасширения(Прогон, Задание);
	ИначеЕсли Задание.Вид = "Запись" Тогда
		ЗаписатьВЖурналПрогона(Прогон, Задание.ВидЗаписи, Задание.ТекстЗаписи);
	КонецЕсли;

	ЗавершитьЗадание(Прогон, Задание, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗадание(Прогон, Задание, ОбновитьЖурналВФорме)

	Если Задание.КонецШага Тогда
		ИтогиШага = Прогон.ИтогиШага;
		Прогон.ЧастиЖурнала.Добавить("--- шаг занял "
			+ ЧислоСтрокой(ТекущаяУниверсальнаяДатаВМиллисекундах() - Прогон.НачалоШага)
			+ " мс; ОК: " + ЧислоСтрокой(ИтогиШага.ОК)
			+ ", ошибок: " + ЧислоСтрокой(ИтогиШага.Ошибок)
			+ ", внимание: " + ЧислоСтрокой(ИтогиШага.Внимание)
			+ ", пропусков: " + ЧислоСтрокой(ИтогиШага.Пропусков));
	КонецЕсли;

	Прогон.ЗаданиеВРаботе = Ложь;
	Прогон.Номер = Прогон.Номер + 1;

	// ** Хлебников С.Ю. 20261117 Экран автозапуска: итоги задания - в карточку шага.
	Если ПанельАвтозапускаСостояние <> Неопределено Тогда
		ПанельАвтозапускаКонецЗадания(Прогон, Задание);
	КонецЕсли;

	// Журнал в реквизит формы кладётся не на каждом задании: текст большой, а заданий несколько сотен.
	ШагЦеликом = Задание.Вид = "Сервер" И ПустаяСтрока(Задание.Элемент);
	Если ОбновитьЖурналВФорме Или Задание.КонецШага Или ШагЦеликом Или Прогон.Номер % 10 = 0 Тогда
		ЖурналТестирования = СтрСоединить(Прогон.ЧастиЖурнала, Символы.ПС);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПрогон(Прогон)

	Итоги = Прогон.Итоги;

	Прогон.ЧастиЖурнала.Добавить("");
	Прогон.ЧастиЖурнала.Добавить("=== ИТОГО: ОК - " + ЧислоСтрокой(Итоги.ОК)
		+ ", ошибок - " + ЧислоСтрокой(Итоги.Ошибок)
		+ ", внимание - " + ЧислоСтрокой(Итоги.Внимание)
		+ ", пропусков - " + ЧислоСтрокой(Итоги.Пропусков) + " ===");
	Прогон.ЧастиЖурнала.Добавить("Окончание: " + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm:ss'"));

	ЖурналТестирования = СтрСоединить(Прогон.ЧастиЖурнала, Символы.ПС);

	Если Прогон.СохранятьЖурнал Тогда
		СохранитьСостояниеПрогона(Прогон, "", "");
	КонецЕсли;

	ПрогонТестирования = Неопределено;

	Состояние("Самопроверка завершена: ошибок - " + ЧислоСтрокой(Итоги.Ошибок)
		+ ", внимание - " + ЧислоСтрокой(Итоги.Внимание));

	// Автозапуск: дописать остаток журнала, записать итог и завершить работу 1С.
	Если Автозапуск <> Неопределено Тогда
		ЗавершитьАвтозапускПослеПрогона(Прогон);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция НовоеЗадание(ВидЗадания, ПредставлениеШага, ПредставлениеЗадания, НачалоШага)

	Задание = Новый Структура;
	Задание.Вставить("Вид", ВидЗадания);
	Задание.Вставить("Шаг", "");
	Задание.Вставить("ПредставлениеШага", ПредставлениеШага);
	Задание.Вставить("Элемент", "");
	Задание.Вставить("Представление", ПредставлениеЗадания);
	Задание.Вставить("НачалоШага", НачалоШага);
	Задание.Вставить("КонецШага", Ложь);
	Задание.Вставить("ВКонце", Ложь);
	Задание.Вставить("СохранятьЖурнал", Ложь);

	Возврат Задание;

КонецФункции

&НаКлиенте
Функция НовоеЗаданиеЗапись(ПредставлениеШага, НачалоШага, ВидЗаписи, ТекстЗаписи)

	Задание = НовоеЗадание("Запись", ПредставлениеШага, ПредставлениеШага, НачалоШага);
	Задание.Вставить("ВидЗаписи", ВидЗаписи);
	Задание.Вставить("ТекстЗаписи", ТекстЗаписи);

	Возврат Задание;

КонецФункции

&НаКлиенте
Процедура ДобавитьЗаголовокШага(Прогон, ПредставлениеШага)

	Прогон.ЧастиЖурнала.Добавить("");
	Прогон.ЧастиЖурнала.Добавить("=== " + ПредставлениеШага + " ===");

	Прогон.ИтогиШага = Новый Структура("ОК, Ошибок, Внимание, Пропусков", 0, 0, 0, 0);
	Прогон.НачалоШага = ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВЖурналПрогона(Прогон, ВидЗаписи, ТекстЗаписи)

	ДобавитьЗаписьЖурнала(Прогон.ЧастиЖурнала, Прогон.Итоги, ВидЗаписи, ТекстЗаписи);

	ИтогиШага = Прогон.ИтогиШага;
	Если ВидЗаписи = "ОК" Тогда
		ИтогиШага.ОК = ИтогиШага.ОК + 1;
	ИначеЕсли ВидЗаписи = "ОШИБКА" Тогда
		ИтогиШага.Ошибок = ИтогиШага.Ошибок + 1;
	ИначеЕсли ВидЗаписи = "ВНИМАНИЕ" Тогда
		ИтогиШага.Внимание = ИтогиШага.Внимание + 1;
	ИначеЕсли ВидЗаписи = "ПРОПУСК" Тогда
		ИтогиШага.Пропусков = ИтогиШага.Пропусков + 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьСерверноеЗадание(Прогон, Задание)

	Попытка
		РезультатШага = ВыполнитьШагНаСервере(Задание.Шаг, Задание.Элемент, Прогон.ГраницаДатыДокументов,
			Автозапуск <> Неопределено, // ** Хлебников С.Ю. 20261117 снимки - только при автозапуске
			ПараметрыШагаОбменов(Задание.Шаг)); // ** Хлебников С.Ю. 20261117 набор и режим шага «Обмены»
	Исключение
		Если ПустаяСтрока(Задание.Элемент) Тогда
			ДобавитьЗаголовокШага(Прогон, Задание.ПредставлениеШага);
		КонецЕсли;
		ЗаписатьВЖурналПрогона(Прогон, "ОШИБКА",
			Задание.Представление + ": серверный вызов завершился исключением:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Не ПустаяСтрока(РезультатШага.Текст) Тогда
		Прогон.ЧастиЖурнала.Добавить(РезультатШага.Текст);
	КонецЕсли;

	// ** Хлебников С.Ю. 20261117 Снимки для гейта идут в часть журнала отдельно от строк журнала: на экран и в сохраняемое состояние
	// прогона журнала они не попадают.
	Если Автозапуск <> Неопределено И Прогон.Свойство("Снимки") И РезультатШага.Свойство("Снимки") Тогда
		Для Каждого БлокСнимка Из РезультатШага.Снимки Цикл
			Прогон.Снимки.Добавить(БлокСнимка);
		КонецЦикла;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	Итоги = Прогон.Итоги;
	Итоги.ОК = Итоги.ОК + РезультатШага.ОК;
	Итоги.Ошибок = Итоги.Ошибок + РезультатШага.Ошибок;
	Итоги.Внимание = Итоги.Внимание + РезультатШага.Внимание;
	Итоги.Пропусков = Итоги.Пропусков + РезультатШага.Пропусков;

	ИтогиШага = Прогон.ИтогиШага;
	ИтогиШага.ОК = ИтогиШага.ОК + РезультатШага.ОК;
	ИтогиШага.Ошибок = ИтогиШага.Ошибок + РезультатШага.Ошибок;
	ИтогиШага.Внимание = ИтогиШага.Внимание + РезультатШага.Внимание;
	ИтогиШага.Пропусков = ИтогиШага.Пропусков + РезультатШага.Пропусков;

КонецПроцедуры

// Сохраняет журнал прогона и задание, которое сейчас начнёт выполняться, в хранилище настроек пользователя.
&НаКлиенте
Процедура СохранитьСостояниеПрогона(Прогон, ПредставлениеЗадания, ЭлементЗадания)

	Попытка
		СохранитьСостояниеПрогонаНаСервере(СтрСоединить(Прогон.ЧастиЖурнала, Символы.ПС),
			ПредставлениеЗадания, ЭлементЗадания, НеПроводитьДокументы);
	Исключение
		// Сохранение журнала вспомогательное: его отказ тестирование не останавливает.
		Прогон.СохранятьЖурнал = Ложь;
		ЗаписатьВЖурналПрогона(Прогон, "ВНИМАНИЕ",
			"Не удалось сохранить журнал в хранилище настроек, дальше журнал не сохраняется:" + Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьСостояниеПрогонаНаСервере(ТекстЖурнала, ПредставлениеЗадания, ЭлементЗадания, ИсключенныеДокументы)

	СостояниеПрогона = Новый Структура;
	СостояниеПрогона.Вставить("Журнал", ТекстЖурнала);
	СостояниеПрогона.Вставить("ПрерванноеЗадание", ПредставлениеЗадания);
	СостояниеПрогона.Вставить("ЭлементПрерванногоЗадания", ЭлементЗадания);
	СостояниеПрогона.Вставить("НеПроводитьДокументы", ИсключенныеДокументы);
	СостояниеПрогона.Вставить("Сохранено", ТекущаяДатаСеанса());

	ХранилищеОбщихНастроек.Сохранить(КлючСостоянияПрогона(), "СостояниеПрогона", СостояниеПрогона);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючСостоянияПрогона()

	// ** Хлебников С.Ю. 20261117 ключ без префикса базы: прогон, прерванный при прежней сборке, не восстановится один раз
	Возврат "ВыполнитьПослеОбновления.Самопроверка";

КонецФункции

// Показывает в форме журнал прошлого прогона. Если прошлый прогон прервался на проведении документа,
// вид этого документа добавляется в поле «Не проводить документы».
&НаСервере
Процедура ВосстановитьСостояниеПрогона(СостояниеПрогона)

	СохраненныйЖурнал = "";
	Если СостояниеПрогона.Свойство("Журнал") Тогда
		СохраненныйЖурнал = Строка(СостояниеПрогона.Журнал);
	КонецЕсли;

	Если СостояниеПрогона.Свойство("НеПроводитьДокументы") Тогда
		НеПроводитьДокументы = Строка(СостояниеПрогона.НеПроводитьДокументы);
	КонецЕсли;

	ПрерванноеЗадание = "";
	Если СостояниеПрогона.Свойство("ПрерванноеЗадание") Тогда
		ПрерванноеЗадание = Строка(СостояниеПрогона.ПрерванноеЗадание);
	КонецЕсли;

	ЭлементПрерванногоЗадания = "";
	Если СостояниеПрогона.Свойство("ЭлементПрерванногоЗадания") Тогда
		ЭлементПрерванногоЗадания = Строка(СостояниеПрогона.ЭлементПрерванногоЗадания);
	КонецЕсли;

	ДатаСохранения = "";
	Если СостояниеПрогона.Свойство("Сохранено") Тогда
		ДатаСохранения = Формат(СостояниеПрогона.Сохранено, "ДФ='dd.MM.yyyy HH:mm:ss'");
	КонецЕсли;

	Если ПустаяСтрока(СохраненныйЖурнал) Тогда
		Возврат;
	КонецЕсли;

	Примечание = "Журнал прошлого прогона, сохранён " + ДатаСохранения + ".";

	Если Не ПустаяСтрока(ПрерванноеЗадание) Тогда

		Примечание = Примечание + " Прогон не завершился: журнал сохранён перед заданием «" + ПрерванноеЗадание + "».";

		ПрефиксДокумента = "Документ|";
		Если СтрНачинаетсяС(ЭлементПрерванногоЗадания, ПрефиксДокумента) Тогда

			ИмяДокумента = Сред(ЭлементПрерванногоЗадания, СтрДлина(ПрефиксДокумента) + 1);

			Если СтрНайти(ВРег(НеПроводитьДокументы), ВРег(ИмяДокумента)) = 0 Тогда
				НеПроводитьДокументы = НеПроводитьДокументы + ?(ПустаяСтрока(НеПроводитьДокументы), "", ", ") + ИмяДокумента;
			КонецЕсли;

			Примечание = Примечание + " Вид документов " + ИмяДокумента + " добавлен в поле «Не проводить документы»:"
				+ " если задание тогда не зависло, а было прервано по другой причине, уберите его из поля.";

		КонецЕсли;

	КонецЕсли;

	ЖурналТестирования = Примечание + Символы.ПС + Символы.ПС + СохраненныйЖурнал;

КонецПроцедуры

&НаСервере
Функция ГраницаДатыДокументовНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Возврат ОбработкаОбъект.ГраницаДатыДокументов();

КонецФункции

&НаСервере
Функция БазаТестоваяНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Возврат ОбработкаОбъект.БазаПохожаНаТестовую();

КонецФункции

&НаСервере
Функция ЗаданияТестированияНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Возврат ОбработкаОбъект.ЗаданияТестирования();

КонецФункции

&НаСервере
Функция ВыполнитьШагНаСервере(ИмяШага, ЭлементШага, ГраницаДатыДокументов, СниматьСнимки = Ложь,
	ПараметрыОбменов = Неопределено) // ** Хлебников С.Ю. 20261117 параметры шага «Обмены», см. ПараметрыШагаОбменов

	ПараметрыШага = Новый Структура;
	ПараметрыШага.Вставить("РазрешитьЗапись", РазрешитьЗапись);
	ПараметрыШага.Вставить("ПроводитьДокументы", ПроводитьДокументы);
	ПараметрыШага.Вставить("ОтключатьПочту", ОтключатьПочту);
	ПараметрыШага.Вставить("ПроверятьПрименимость", ПроверятьПрименимость);
	ПараметрыШага.Вставить("КоличествоДокументов", КоличествоДокументов);
	ПараметрыШага.Вставить("Элемент", ЭлементШага);
	ПараметрыШага.Вставить("НеПроводитьДокументы", НеПроводитьДокументы);
	ПараметрыШага.Вставить("ГраницаДатыДокументов", ГраницаДатыДокументов);
	ПараметрыШага.Вставить("ГраницаЗаданаВручную", ЗначениеЗаполнено(ДокументыНеСтарше));
	ПараметрыШага.Вставить("Снимки", СниматьСнимки); // ** Хлебников С.Ю. 20261117
	// ** Хлебников С.Ю. 20261117 набор объектов прогона «до» и режим шага «Обмены»
	Если ТипЗнч(ПараметрыОбменов) = Тип("Структура") Тогда
		Для Каждого ПараметрОбменов Из ПараметрыОбменов Цикл
			ПараметрыШага.Вставить(ПараметрОбменов.Ключ, ПараметрОбменов.Значение);
		КонецЦикла;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Возврат ОбработкаОбъект.ВыполнитьШагТестирования(ИмяШага, ПараметрыШага);

КонецФункции

&НаСервере
Функция КлиентскиеОбщиеМодулиНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Возврат ОбработкаОбъект.КлиентскиеОбщиеМодули();

КонецФункции

&НаСервере
Функция ФормыДляПроверкиНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	Возврат ОбработкаОбъект.ФормыДляПроверки();

КонецФункции

&НаКлиенте
Процедура ПроверитьКлиентскийМодуль(Прогон, Задание)

	Попытка
		МодульДляПроверки = ОбщегоНазначенияКлиент.ОбщийМодуль(Задание.Элемент);
		МодульДляПроверки.ТестКомпиляции_НетТакогоМетода();
		ЗаписатьВЖурналПрогона(Прогон, "ВНИМАНИЕ", Задание.Представление + ": метод-пустышка неожиданно выполнился.");
	Исключение
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ЭтоОтветНетТакогоМетода(ТекстОшибки) Тогда
			ЗаписатьВЖурналПрогона(Прогон, "ОК", Задание.Представление + ": компилируется");
		Иначе
			ЗаписатьВЖурналПрогона(Прогон, "ОШИБКА",
				Задание.Представление + ": ошибка при обращении к модулю:" + Символы.ПС + ТекстОшибки);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФормуРасширения(Прогон, Задание)

	ОписаниеФормы = Задание.ОписаниеФормы;

	Если Не ОписаниеФормы.Существует Тогда
		ЗаписатьВЖурналПрогона(Прогон, "ПРОПУСК", ОписаниеФормы.ПолноеИмя + ": нет в конфигурации");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	Пояснение = "";
	Если ЗначениеЗаполнено(ОписаниеФормы.Ключ) Тогда
		ПараметрыФормы.Вставить("Ключ", ОписаниеФормы.Ключ);
		Пояснение = ", объект «" + Строка(ОписаниеФормы.Ключ) + "»";
	КонецЕсли;

	НачалоСоздания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка

		// ** Хлебников С.Ю. 20261117 ПолучитьФорму намеренно: форма создаётся без открытия, чтобы скомпилировать её модуль.
		ПроверяемаяФорма = ПолучитьФорму(ОписаниеФормы.ПолноеИмя, ПараметрыФормы, , Новый УникальныйИдентификатор); // BSLLS:GetFormMethod-off
		Длительность = " (" + ЧислоСтрокой(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСоздания) + " мс)";

		Если ПроверяемаяФорма = Неопределено Тогда
			ЗаписатьВЖурналПрогона(Прогон, "ВНИМАНИЕ",
				ОписаниеФормы.ПолноеИмя + Пояснение + ": форма не создана, в ПриСозданииНаСервере установлен отказ" + Длительность);
		Иначе
			ЗаписатьВЖурналПрогона(Прогон, "ОК", ОписаниеФормы.ПолноеИмя + Пояснение + ": создаётся" + Длительность);
		КонецЕсли;

		ПроверяемаяФорма = Неопределено;

	Исключение

		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Длительность = " (" + ЧислоСтрокой(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоСоздания) + " мс)";

		Если ОписаниеФормы.Основная Тогда
			ЗаписатьВЖурналПрогона(Прогон, "ОШИБКА",
				ОписаниеФормы.ПолноеИмя + Пояснение + ": ошибка при создании формы" + Длительность + Символы.ПС + ТекстОшибки);
		ИначеЕсли ЭтоОшибкаТекстаЗапроса(ТекстОшибки) И ЕстьПрефиксНашихОбъектов(ТекстОшибки, ОписаниеФормы.ПрефиксыНаших) Тогда // ** Хлебников С.Ю. 20261117 префиксы - от пакета
			// Таблицы, поля или значения из текста запроса нет в базе: параметры формы тут ни при чём.
			ЗаписатьВЖурналПрогона(Прогон, "ОШИБКА",
				ОписаниеФормы.ПолноеИмя + Пояснение + ": при создании формы не выполнился запрос из кода расширения,"
				+ " в тексте запроса есть то, чего нет в базе. От параметров формы это, скорее всего, не зависит" + Длительность
				+ Символы.ПС + ТекстОшибки);
		Иначе
			ЗаписатьВЖурналПрогона(Прогон, "ВНИМАНИЕ",
				ОписаниеФормы.ПолноеИмя + Пояснение + ": вспомогательная форма без параметров не создалась" + Длительность
				+ Символы.ПС + ТекстОшибки);
		КонецЕсли;

	КонецПопытки;

КонецПроцедуры

// ** Хлебников С.Ю. 20261117
// Возвращает Истина, если в тексте ошибки есть имя нашего объекта (начинается с одного из префиксов пакета).
//
// Параметры:
//  ТекстОшибки - Строка
//  Префиксы - Массив из Строка - см. ФормыДляПроверки модуля объекта.
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция ЕстьПрефиксНашихОбъектов(ТекстОшибки, Префиксы)

	Для Каждого Префикс Из Префиксы Цикл
		Если СтрНайти(ТекстОшибки, Префикс) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Возвращает Истина, если текст ошибки говорит о том, что в тексте запроса упомянуты таблица, поле
// или значение, которых нет в базе.
&НаКлиенте
Функция ЭтоОшибкаТекстаЗапроса(ТекстОшибки)

	Возврат СтрНайти(ТекстОшибки, "Таблица не найдена") > 0
		Или СтрНайти(ТекстОшибки, "Поле не найдено") > 0
		Или СтрНайти(ТекстОшибки, "Неверные параметры") > 0;

КонецФункции

&НаКлиенте
Процедура ДобавитьЗаписьЖурнала(ЧастиЖурнала, Итоги, ВидЗаписи, ТекстЗаписи)

	Если ВидЗаписи = "ОК" Тогда
		Итоги.ОК = Итоги.ОК + 1;
		Пометка = "[ОК]      ";
	ИначеЕсли ВидЗаписи = "ОШИБКА" Тогда
		Итоги.Ошибок = Итоги.Ошибок + 1;
		Пометка = "[ОШИБКА]  ";
	ИначеЕсли ВидЗаписи = "ВНИМАНИЕ" Тогда
		Итоги.Внимание = Итоги.Внимание + 1;
		Пометка = "[ВНИМАНИЕ]";
	ИначеЕсли ВидЗаписи = "ПРОПУСК" Тогда
		Итоги.Пропусков = Итоги.Пропусков + 1;
		Пометка = "[ПРОПУСК] ";
	Иначе
		Пометка = "[ИНФО]    ";
	КонецЕсли;

	// Отступ продолжения равен ширине времени и пометки.
	ОтступПродолжения = "                    ";
	ТекстБезВК = СтрЗаменить(ТекстЗаписи, Символы.ВК, "");

	ЧастиЖурнала.Добавить(Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ=HH:mm:ss") + " " + Пометка + " "
		+ СтрЗаменить(ТекстБезВК, Символы.ПС, Символы.ПС + ОтступПродолжения));

КонецПроцедуры

&НаКлиенте
Функция ЭтоОтветНетТакогоМетода(ТекстОшибки)

	Если СтрНайти(ТекстОшибки, "(ТестКомпиляции_НетТакогоМетода)") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекстВРег = ВРег(ТекстОшибки);

	Возврат СтрНайти(ТекстВРег, "НЕ ОБНАРУЖЕН") > 0 Или СтрНайти(ТекстВРег, "NOT FOUND") > 0;

КонецФункции

&НаКлиенте
Функция ЧислоСтрокой(Значение)

	Возврат Формат(Значение, "ЧН=0; ЧГ=0");

КонецФункции

#КонецОбласти

#Область АвтоматическийЗапуск

// Автозапуск нужен гейту расширений: он открывает обработку ключом /Execute с параметром запуска,
// следит за файлами в папке и сам сравнивает прогоны. Кнопки формы не нажимаются, вопросы не задаются.
//
// Параметр запуска /C, части через точку с запятой:
//  selfcheck           - признак автозапуска, обязателен;
//  out=<папка>         - существующая папка для файлов, обязательна;
//  docs=<число>        - поле «Документов каждого вида», от 1 до 50;
//  forms=0             - не проверять формы;
//  post=0              - не проводить документы;
//  write=0             - не выполнять тесты с записью в базу;
//  skip=<имена>        - виды документов через запятую, добавляются в поле «Не проводить документы»;
//  notolder=<ГГГГММДД> - поле «Документы не старше»;
//  known=<отпечаток>   - отпечаток состояния базы из прошлого прогона: если он не изменился,
//                        тестирование не выполняется, в итог пишется status=same;
//  start=<номер>       - начать с задания с этим номером, нумерация с нуля. Так гейт продолжает прогон,
//                        если прошлый сеанс пришлось остановить.
// ** Хлебников С.Ю. 20261117 Части для шага «Обмены»:
//  exch=<файл>         - набор объектов прогона «до» (строки «<узел><TAB><полное имя><TAB><УИД>»): шаг выгружает
//                        ровно эти объекты, чтобы «до» и «после» сравнивались на одном наборе;
//  exchmode=light      - только объекты, которые назвал пакет, без очереди узла и срезов (по умолчанию full);
//  exchq=<на вид>/<всего> - сколько объектов очереди узла брать, по умолчанию 5/50.
// ** Хлебников С.Ю. 20261117 конец
//
// Файлы в папке, кодировка UTF-8:
//  started.txt - отметка: обработка открылась и разобрала параметр запуска;
//  info.txt    - сведения о сеансе и расширениях, отпечаток состояния базы;
//  pNNNNNN.txt - части журнала. Часть пишется перед каждым заданием: в заголовке (строки с «@@») имя задания,
//                которое сейчас начнётся, после строки «@@journal» - строки журнала, накопленные после прошлой
//                части. Задание начинается только после записи части: если сеанс зависнет или будет остановлен,
//                по последней части видно, на каком задании;
//  result.txt  - итог, пишется последним. После него обработка завершает работу 1С.
//
// Запись и проведение параметром запуска можно только выключить. Включает их сама обработка и только в базе,
// имя которой похоже на тестовое.
// ** Хлебников С.Ю. 20261117 В другой базе (рабочей) автозапуск выполняется только на чтение: в параметре запуска
// должны быть write=0 и post=0, иначе отказ. Так скрипт обновления проверяет рабочую базу после загрузки расширений.

// Разбирает параметр запуска.
//
// Параметры:
//  СтрокаЗапуска - Строка - значение параметра запуска /C.
//
// Возвращаемое значение:
//  Структура, Неопределено - параметры автозапуска; Неопределено, если запуск обычный.
//
&НаКлиенте
Функция ПараметрыАвтозапускаИзСтроки(Знач СтрокаЗапуска)

	ЭтоАвтозапуск = Ложь;

	ПараметрыАвтозапуска = Новый Структура;
	ПараметрыАвтозапуска.Вставить("Каталог", "");
	ПараметрыАвтозапуска.Вставить("ЧислоДокументов", Неопределено);
	ПараметрыАвтозапуска.Вставить("СФормами", Истина);
	ПараметрыАвтозапуска.Вставить("СПроведением", Истина);
	ПараметрыАвтозапуска.Вставить("СЗаписью", Истина);
	ПараметрыАвтозапуска.Вставить("ИсключенныеДокументы", "");
	ПараметрыАвтозапуска.Вставить("ГраницаДокументов", Неопределено);
	ПараметрыАвтозапуска.Вставить("ИзвестныйОтпечаток", "");
	ПараметрыАвтозапуска.Вставить("НачатьСЗадания", 0);
	// ** Хлебников С.Ю. 20261117 Режим kbarticle: записать статью базы знаний из файла (скрипт обновления)
	ПараметрыАвтозапуска.Вставить("Режим", "selfcheck");
	ПараметрыАвтозапуска.Вставить("ФайлСтатьи", "");
	ПараметрыАвтозапуска.Вставить("НазваниеСтатьи", "");
	ПараметрыАвтозапуска.Вставить("ИмяОбработки", ""); // ** Хлебников С.Ю. 20261117 regepf, unregepf
	ПараметрыАвтозапуска.Вставить("СсылкаОбработки", ""); // ** Хлебников С.Ю. 20261117 unregepf
	// ** Хлебников С.Ю. 20261117 шаг «Обмены»: exch=, exchmode=, exchq=
	ПараметрыАвтозапуска.Вставить("ФайлОбъектовОбмена", "");
	ПараметрыАвтозапуска.Вставить("РежимОбменов", "");
	ПараметрыАвтозапуска.Вставить("ОбменыНаВид", 0);
	ПараметрыАвтозапуска.Вставить("ОбменыВсего", 0);
	// ** Хлебников С.Ю. 20261117 конец
	// ** Хлебников С.Ю. 20261117 конец

	Для Каждого ЧастьСтрокиЗапуска Из СтрРазделить(Строка(СтрокаЗапуска), ";", Ложь) Цикл

		Часть = СокрЛП(ЧастьСтрокиЗапуска);
		ЧастьНРег = НРег(Часть);

		Если ЧастьНРег = "selfcheck" Тогда
			ЭтоАвтозапуск = Истина;
		// ** Хлебников С.Ю. 20261117 Режим kbarticle и его части file= и title=
		ИначеЕсли ЧастьНРег = "kbarticle" Тогда
			ЭтоАвтозапуск = Истина;
			ПараметрыАвтозапуска.Режим = "kbarticle";
		// ** Хлебников С.Ю. 20261117 Режимы regepf, unregepf и часть name=
		ИначеЕсли ЧастьНРег = "regepf" Или ЧастьНРег = "unregepf" Тогда
			ЭтоАвтозапуск = Истина;
			ПараметрыАвтозапуска.Режим = ЧастьНРег;
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "name=") Тогда
			ПараметрыАвтозапуска.ИмяОбработки = СокрЛП(Сред(Часть, 6));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "ref=") Тогда
			ПараметрыАвтозапуска.СсылкаОбработки = СокрЛП(Сред(Часть, 5));
		// ** Хлебников С.Ю. 20261117 конец
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "file=") Тогда
			ПараметрыАвтозапуска.ФайлСтатьи = СокрЛП(Сред(Часть, 6));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "title=") Тогда
			ПараметрыАвтозапуска.НазваниеСтатьи = СокрЛП(Сред(Часть, 7));
		// ** Хлебников С.Ю. 20261117 конец
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "out=") Тогда
			ПараметрыАвтозапуска.Каталог = СокрЛП(Сред(Часть, 5));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "docs=") Тогда
			ПараметрыАвтозапуска.ЧислоДокументов = ЧислоИзПараметраЗапуска(Сред(Часть, 6), Неопределено);
		ИначеЕсли ЧастьНРег = "forms=0" Тогда
			ПараметрыАвтозапуска.СФормами = Ложь;
		ИначеЕсли ЧастьНРег = "post=0" Тогда
			ПараметрыАвтозапуска.СПроведением = Ложь;
		ИначеЕсли ЧастьНРег = "write=0" Тогда
			ПараметрыАвтозапуска.СЗаписью = Ложь;
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "skip=") Тогда
			ПараметрыАвтозапуска.ИсключенныеДокументы = СокрЛП(Сред(Часть, 6));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "notolder=") Тогда
			ПараметрыАвтозапуска.ГраницаДокументов = ДатаИзПараметраЗапуска(Сред(Часть, 10));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "known=") Тогда
			ПараметрыАвтозапуска.ИзвестныйОтпечаток = НРег(СокрЛП(Сред(Часть, 7)));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "start=") Тогда
			ПараметрыАвтозапуска.НачатьСЗадания = Макс(0, ЧислоИзПараметраЗапуска(Сред(Часть, 7), 0));
		// ** Хлебников С.Ю. 20261117 шаг «Обмены»
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "exch=") Тогда
			ПараметрыАвтозапуска.ФайлОбъектовОбмена = СокрЛП(Сред(Часть, 6));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "exchmode=") Тогда
			ПараметрыАвтозапуска.РежимОбменов = НРег(СокрЛП(Сред(Часть, 10)));
		ИначеЕсли СтрНачинаетсяС(ЧастьНРег, "exchq=") Тогда
			ЛимитыОчереди = СтрРазделить(Сред(Часть, 7), "/", Ложь);
			Если ЛимитыОчереди.Количество() > 0 Тогда
				ПараметрыАвтозапуска.ОбменыНаВид = Макс(0, ЧислоИзПараметраЗапуска(ЛимитыОчереди[0], 0));
			КонецЕсли;
			Если ЛимитыОчереди.Количество() > 1 Тогда
				ПараметрыАвтозапуска.ОбменыВсего = Макс(0, ЧислоИзПараметраЗапуска(ЛимитыОчереди[1], 0));
			КонецЕсли;
		// ** Хлебников С.Ю. 20261117 конец
		КонецЕсли;

	КонецЦикла;

	Если Не ЭтоАвтозапуск Или ПустаяСтрока(ПараметрыАвтозапуска.Каталог) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Прав(ПараметрыАвтозапуска.Каталог, 1) <> "\" Тогда
		ПараметрыАвтозапуска.Каталог = ПараметрыАвтозапуска.Каталог + "\";
	КонецЕсли;

	Возврат ПараметрыАвтозапуска;

КонецФункции

&НаКлиенте
Функция ЧислоИзПараметраЗапуска(Знач ТекстЧисла, ЗначениеПоУмолчанию)

	Попытка
		Возврат Число(СокрЛП(ТекстЧисла));
	Исключение
		// В параметре не число: остаётся значение по умолчанию.
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ДатаИзПараметраЗапуска(Знач ТекстДаты)

	Попытка
		Возврат Дата(Лев(СокрЛП(ТекстДаты), 8));
	Исключение
		// В параметре не дата вида ГГГГММДД: поле «Документы не старше» не меняется.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Готовит форму к автозапуску и записывает отметку запуска.
//
// Параметры:
//  ПараметрыАвтозапуска - Структура - см. ПараметрыАвтозапускаИзСтроки.
//
&НаКлиенте
Процедура НачатьАвтозапуск(ПараметрыАвтозапуска)

	Автозапуск = ПараметрыАвтозапуска;
	Автозапуск.Вставить("НомерЧасти", 0);
	Автозапуск.Вставить("ЗаписаноЧастейЖурнала", 0);
	Автозапуск.Вставить("ЗаданиеОбъявлено", Ложь);
	Автозапуск.Вставить("ОшибокЗаписи", 0);
	Автозапуск.Вставить("Отпечаток", "");
	Автозапуск.Вставить("Решение", "");
	Автозапуск.Вставить("Пояснение", "");
	Автозапуск.Вставить("Итоги", Неопределено);
	Автозапуск.Вставить("ОбъектыОбмена", ""); // ** Хлебников С.Ю. 20261117 текст файла exch=
	Автозапуск.Вставить("ОшибкаОбъектовОбмена", ""); // ** Хлебников С.Ю. 20261117

	// Параметры запуска кладутся в поля формы: тестирование читает их оттуда, как при запуске кнопкой.
	// Запись и проведение параметром можно только выключить.
	Если Автозапуск.ЧислоДокументов <> Неопределено Тогда
		КоличествоДокументов = Мин(Макс(Цел(Автозапуск.ЧислоДокументов), 1), 50);
	КонецЕсли;

	РазрешитьЗапись = РазрешитьЗапись И Автозапуск.СЗаписью;
	ПроводитьДокументы = ПроводитьДокументы И Автозапуск.СПроведением;
	ПроверятьФормы = ПроверятьФормы И Автозапуск.СФормами;

	Если Автозапуск.ГраницаДокументов <> Неопределено Тогда
		ДокументыНеСтарше = Автозапуск.ГраницаДокументов;
	КонецЕсли;

	Для Каждого ИмяИзПараметра Из СтрРазделить(Автозапуск.ИсключенныеДокументы, ",", Ложь) Цикл
		ИмяВидаДокументов = СокрЛП(ИмяИзПараметра);
		Если Не ПустаяСтрока(ИмяВидаДокументов)
			И СтрНайти(ВРег(НеПроводитьДокументы), ВРег(ИмяВидаДокументов)) = 0 Тогда
			НеПроводитьДокументы = НеПроводитьДокументы + ?(ПустаяСтрока(НеПроводитьДокументы), "", ", ")
				+ ИмяВидаДокументов;
		КонецЕсли;
	КонецЦикла;

	// ** Хлебников С.Ю. 20261117 Вместо кнопок и полей формы - экран автозапуска.
	ПоказатьПанельАвтозапуска();

	ПоказатьСостояниеАвтозапуска("запуск, файлы пишу в " + Автозапуск.Каталог);

	// Отметка «обработка открылась и разобрала параметр запуска». Если она не записалась, писать некуда:
	// обработка завершает работу 1С, см. ПослеЗаписиОтметкиАвтозапуска.
	ЗаписатьФайлАвтозапуска("started.txt", "started=" + ВерсияСборкиФормы(), "ПослеЗаписиОтметкиАвтозапуска");

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Запись статьи базы знаний без человека. Скрипт обновления рабочей базы
// готовит HTML-файл с описанием изменений расширений и открывает обработку с параметром
// /C"kbarticle;out=<папка>;file=<файл HTML>;title=<название статьи>". Статья пишется тем же кодом, что у кнопки
// «Создать статью базы знаний» (СоздатьСтатьюБазыЗнанийНаСервере), итог - в result.txt, потом 1С закрывается.
//
// Параметры:
//  ПараметрыАвтозапуска - Структура - см. ПараметрыАвтозапускаИзСтроки.
//
&НаКлиенте
Процедура НачатьЗаписьСтатьиАвтозапуском(ПараметрыАвтозапуска)

	Автозапуск = ПараметрыАвтозапуска;
	Автозапуск.Вставить("НомерЧасти", 0);
	Автозапуск.Вставить("ОшибокЗаписи", 0);
	Автозапуск.Вставить("Отпечаток", "");
	Автозапуск.Вставить("Итоги", Неопределено);

	ПоказатьСостояниеАвтозапуска("запись статьи базы знаний, файлы пишу в " + Автозапуск.Каталог);
	ЗаписатьФайлАвтозапуска("started.txt", "started=" + ВерсияСборкиФормы(), "ПослеОтметкиЗаписиСтатьи");

КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиЗаписиСтатьи(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Ложь Тогда
		// Папка недоступна: сообщить о результате некуда.
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Автозапуск.ФайлСтатьи) Или ПустаяСтрока(Автозапуск.НазваниеСтатьи) Тогда
		ЗавершитьАвтозапуск("failed", "В параметре запуска нет file= или title=.");
		Возврат;
	КонецЕсли;

	ДокументСтатьи = Новый ТекстовыйДокумент;
	ПараметрыЧтения = Новый Структура("ДокументСтатьи", ДокументСтатьи);
	Оповещение = Новый ОписаниеОповещения("ПослеЧтенияФайлаСтатьи", ЭтотОбъект, ПараметрыЧтения,
		"ПриОшибкеЧтенияФайлаСтатьи", ЭтотОбъект);

	Попытка
		ДокументСтатьи.НачатьЧтение(Оповещение, Автозапуск.ФайлСтатьи, КодировкаТекста.UTF8);
	Исключение
		// Чтение не началось, обработчики платформа не вызовет.
		ЗавершитьАвтозапуск("failed", "Не удалось прочитать файл статьи " + Автозапуск.ФайлСтатьи + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияФайлаСтатьи(ДополнительныеПараметры) Экспорт

	НазваниеСтатьиБазыЗнаний = Автозапуск.НазваниеСтатьи;
	ТекстСтатьиБазыЗнаний = ДополнительныеПараметры.ДокументСтатьи.ПолучитьТекст();

	Если ПустаяСтрока(ТекстСтатьиБазыЗнаний) Тогда
		ЗавершитьАвтозапуск("failed", "Файл статьи пустой: " + Автозапуск.ФайлСтатьи);
		Возврат;
	КонецЕсли;

	Попытка
		ТекстРезультата = ЗаписатьСтатьюБазыЗнанийПакета(); // ** Хлебников С.Ю. 20261117 статью пишет пакет
	Исключение
		ЗавершитьАвтозапуск("failed", "Статья не записана: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ЗавершитьАвтозапуск("done", ТекстРезультата);

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеЧтенияФайлаСтатьи(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой платформа не показывает: при автозапуске его некому закрыть.
	СтандартнаяОбработка = Ложь;
	ЗавершитьАвтозапуск("failed", "Не удалось прочитать файл статьи " + Автозапуск.ФайлСтатьи + ": "
		+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры
// ** Хлебников С.Ю. 20261117 конец

&НаКлиенте
Процедура ПослеЗаписиОтметкиАвтозапуска(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Ложь Тогда
		// Папка недоступна: сообщить о результате некуда.
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	// ** Хлебников С.Ю. 20261117 Набор объектов обмена прогона «до» (exch=) читается до заданий: на сервере файла гейта нет.
	Если Не ПустаяСтрока(Автозапуск.ФайлОбъектовОбмена) Тогда
		ПрочитатьФайлОбъектовОбмена();
		Возврат;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	// Пауза нужна, чтобы успела отработать отложенная часть запуска программы.
	ПодключитьОбработчикОжидания("Подключаемый_ПодготовитьАвтозапуск", 3, Истина);

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Читает файл exch= на клиенте. Не прочитался - шаг «Обмены» запишет предупреждение
// и соберёт объекты сам; прогон продолжается.
&НаКлиенте
Процедура ПрочитатьФайлОбъектовОбмена()

	ДокументНабора = Новый ТекстовыйДокумент;
	ПараметрыЧтения = Новый Структура("ДокументНабора", ДокументНабора);
	Оповещение = Новый ОписаниеОповещения("ПослеЧтенияФайлаОбъектовОбмена", ЭтотОбъект, ПараметрыЧтения,
		"ПриОшибкеЧтенияФайлаОбъектовОбмена", ЭтотОбъект);

	Попытка
		ДокументНабора.НачатьЧтение(Оповещение, Автозапуск.ФайлОбъектовОбмена, КодировкаТекста.UTF8);
	Исключение
		// Чтение не началось, обработчики платформа не вызовет.
		Автозапуск.ОшибкаОбъектовОбмена = "файл " + Автозапуск.ФайлОбъектовОбмена + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПодключитьОбработчикОжидания("Подключаемый_ПодготовитьАвтозапуск", 3, Истина);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияФайлаОбъектовОбмена(ДополнительныеПараметры) Экспорт

	Автозапуск.ОбъектыОбмена = ДополнительныеПараметры.ДокументНабора.ПолучитьТекст();
	ПодключитьОбработчикОжидания("Подключаемый_ПодготовитьАвтозапуск", 3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеЧтенияФайлаОбъектовОбмена(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой платформа не показывает: при автозапуске его некому закрыть.
	СтандартнаяОбработка = Ложь;
	Автозапуск.ОшибкаОбъектовОбмена = "файл " + Автозапуск.ФайлОбъектовОбмена + ": "
		+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	ПодключитьОбработчикОжидания("Подключаемый_ПодготовитьАвтозапуск", 3, Истина);

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Параметры шага «Обмены» из параметра запуска: для других шагов и без автозапуска - Неопределено.
//
// Возвращаемое значение:
//  Структура, Неопределено - ключи ОбъектыОбмена, ОшибкаОбъектовОбмена, РежимОбменов, ОбменыНаВид, ОбменыВсего.
//
&НаКлиенте
Функция ПараметрыШагаОбменов(ИмяШага)

	Если ИмяШага <> "Обмены" Или Автозапуск = Неопределено Или Не Автозапуск.Свойство("ОбъектыОбмена") Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПараметрыОбменов = Новый Структура;
	ПараметрыОбменов.Вставить("ОбъектыОбмена", Автозапуск.ОбъектыОбмена);
	ПараметрыОбменов.Вставить("ОшибкаОбъектовОбмена", Автозапуск.ОшибкаОбъектовОбмена);
	ПараметрыОбменов.Вставить("РежимОбменов", Автозапуск.РежимОбменов);
	ПараметрыОбменов.Вставить("ОбменыНаВид", Автозапуск.ОбменыНаВид);
	ПараметрыОбменов.Вставить("ОбменыВсего", Автозапуск.ОбменыВсего);
	Возврат ПараметрыОбменов;

КонецФункции
// ** Хлебников С.Ю. 20261117 конец

// Собирает сведения о базе и решает, выполнять ли тестирование. Решение исполняется после записи info.txt,
// см. ПослеЗаписиСведенийАвтозапуска.
&НаКлиенте
Процедура Подключаемый_ПодготовитьАвтозапуск()

	ПоказатьСостояниеАвтозапуска("собираю сведения о базе");

	Попытка
		Сведения = СведенияДляАвтозапускаНаСервере();
	Исключение
		ЗавершитьАвтозапуск("failed", "Не удалось получить сведения о базе: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Автозапуск.Отпечаток = Сведения.Отпечаток;

	// ** Хлебников С.Ю. 20261117 В рабочей базе автозапуск только на чтение. Запись там запрещена и в модуле
	// объекта (ЗаписьРазрешена), здесь дополнительно требуется, чтобы её выключил сам параметр запуска.
	Если Не Сведения.БазаТестовая И (Автозапуск.СЗаписью Или Автозапуск.СПроведением) Тогда
		Автозапуск.Решение = "refused";
		Автозапуск.Пояснение = "Имя базы не похоже на тестовое: в такой базе автозапуск выполняется"
			+ " только на чтение, с write=0 и post=0 в параметре запуска.";
	// ** Хлебников С.Ю. 20261117 конец
	ИначеЕсли Сведения.ОтпечатокНадежный И Не ПустаяСтрока(Автозапуск.ИзвестныйОтпечаток)
		И Автозапуск.ИзвестныйОтпечаток = Сведения.Отпечаток Тогда
		Автозапуск.Решение = "same";
		Автозапуск.Пояснение = "Состояние базы то же, что в прошлом прогоне: тестирование не выполнялось.";
	Иначе
		Автозапуск.Решение = "run";
	КонецЕсли;

	ЗаписатьФайлАвтозапуска("info.txt", Сведения.Текст, "ПослеЗаписиСведенийАвтозапуска");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиСведенийАвтозапуска(Результат, ДополнительныеПараметры) Экспорт

	Если Автозапуск.Решение <> "run" Тогда
		ЗавершитьАвтозапуск(Автозапуск.Решение, Автозапуск.Пояснение);
		Возврат;
	КонецЕсли;

	ПоказатьСостояниеАвтозапуска("готовлю список заданий");

	// Тот же код, что у кнопки «Выполнить тестирование»: собирает очередь заданий и заказывает первое.
	ВыполнитьТестирование(Неопределено);

	Прогон = ПрогонТестирования;
	Если Прогон = Неопределено Тогда
		// Очередь собрать не удалось, причина записана в журнал.
		ЗавершитьАвтозапуск("failed", ЖурналТестирования);
		Возврат;
	КонецЕсли;

	Если Автозапуск.НачатьСЗадания > 0 Тогда
		Прогон.Номер = Мин(Автозапуск.НачатьСЗадания, Прогон.Очередь.Количество());
		ЗаписатьВЖурналПрогона(Прогон, "ИНФО", "Автозапуск продолжает прогон с задания "
			+ ЧислоСтрокой(Прогон.Номер + 1) + " из " + ЧислоСтрокой(Прогон.Очередь.Количество())
			+ ": прошлый сеанс был остановлен, задания до этого номера выполнялись в нём.");
	КонецЕсли;

	// ** Хлебников С.Ю. 20261117 Карточки шагов на экране автозапуска - по очереди прогона.
	ЗаполнитьПанельАвтозапуска(Прогон);

КонецПроцедуры

// Пишет на диск часть журнала с именем задания, которое сейчас начнётся. Задание выполняется после записи:
// его заказывает ПослеЗаписиЧастиПередЗаданием.
//
// Параметры:
//  Прогон - Структура - состояние прогона, см. ВыполнитьТестирование.
//
&НаКлиенте
Процедура ОбъявитьЗаданиеАвтозапуска(Прогон)

	Задание = Прогон.Очередь[Прогон.Номер];
	ВсегоЗаданий = Прогон.Очередь.Количество();
	ПредставлениеЗадания = ТекстВОднуСтроку(Задание.Представление);

	// ** Хлебников С.Ю. 20261117 Экран автозапуска: шаг задания становится текущим.
	ПанельАвтозапускаНачалоЗадания(Прогон, Задание);

	ПоказатьСостояниеАвтозапуска("задание " + ЧислоСтрокой(Прогон.Номер + 1) + " из " + ЧислоСтрокой(ВсегоЗаданий)
		+ ": " + ПредставлениеЗадания);

	СтрокиЗаголовкаЧасти = Новый Массив;
	СтрокиЗаголовкаЧасти.Добавить("@@n=" + ЧислоСтрокой(Прогон.Номер));
	СтрокиЗаголовкаЧасти.Добавить("@@total=" + ЧислоСтрокой(ВсегоЗаданий));
	СтрокиЗаголовкаЧасти.Добавить("@@key=" + КлючЗаданияАвтозапуска(Задание));
	СтрокиЗаголовкаЧасти.Добавить("@@title=" + ПредставлениеЗадания);

	// ** Хлебников С.Ю. 20261117 Шаги самопроверки для экрана ci.exe: по строке на шаг - сделано, всего, ОК,
	// ошибок, внимание, пропусков и имя; @@step - текущий шаг. Гейт рисует по ним второй трубопровод.
	Если ПанельАвтозапускаСостояние <> Неопределено Тогда
		СтрокиЗаголовкаЧасти.Добавить("@@step=" + ТекстВОднуСтроку(Задание.ПредставлениеШага));
		Для Каждого Блок Из ПанельАвтозапускаСостояние.Блоки Цикл
			СтрокиЗаголовкаЧасти.Добавить("@@block=" + ЧислоСтрокой(Блок.Выполнено) + "/" + ЧислоСтрокой(Блок.Всего)
				+ "/" + ЧислоСтрокой(Блок.ОК) + "/" + ЧислоСтрокой(Блок.Ошибок) + "/" + ЧислоСтрокой(Блок.Внимание)
				+ "/" + ЧислоСтрокой(Блок.Пропусков) + "|" + ТекстВОднуСтроку(Блок.Имя));
		КонецЦикла;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	ЗаписатьЧастьЖурналаАвтозапуска(Прогон, СтрокиЗаголовкаЧасти, "ПослеЗаписиЧастиПередЗаданием");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиЧастиПередЗаданием(Результат, ДополнительныеПараметры) Экспорт

	Если Автозапуск = Неопределено Или ПрогонТестирования = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Часть журнала на диске (или записать её не удалось, это учтено в счётчике ошибок записи): можно выполнять.
	Автозапуск.ЗаданиеОбъявлено = Истина;
	ПодключитьОбработчикОжидания("Подключаемый_ВыполнитьОчередноеЗадание", 0.1, Истина);

КонецПроцедуры

// Записывает очередную часть журнала: заголовок и строки журнала, накопленные после прошлой части.
//
// Параметры:
//  Прогон - Структура - состояние прогона, см. ВыполнитьТестирование.
//  СтрокиЗаголовкаЧасти - Массив из Строка - строки заголовка вида «@@имя=значение».
//  ИмяОбработчикаЗавершения - Строка - экспортная процедура формы, которая вызывается после записи.
//
&НаКлиенте
Процедура ЗаписатьЧастьЖурналаАвтозапуска(Прогон, СтрокиЗаголовкаЧасти, Знач ИмяОбработчикаЗавершения)

	Автозапуск.НомерЧасти = Автозапуск.НомерЧасти + 1;

	СтрокиЧасти = Новый Массив;
	СтрокиЧасти.Добавить("@@piece=" + ЧислоСтрокой(Автозапуск.НомерЧасти));
	СтрокиЧасти.Добавить("@@time=" + Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
	Для Каждого СтрокаЗаголовкаЧасти Из СтрокиЗаголовкаЧасти Цикл
		СтрокиЧасти.Добавить(СтрокаЗаголовкаЧасти);
	КонецЦикла;
	СтрокиЧасти.Добавить("@@journal");

	ЧастиЖурнала = Прогон.ЧастиЖурнала;
	Для Индекс = Автозапуск.ЗаписаноЧастейЖурнала По ЧастиЖурнала.ВГраница() Цикл
		СтрокиЧасти.Добавить(ЧастиЖурнала[Индекс]);
	КонецЦикла;
	Автозапуск.ЗаписаноЧастейЖурнала = ЧастиЖурнала.Количество();

	// ** Хлебников С.Ю. 20261117 Снимки шагов после строк журнала: «@@snapshots», дальше блоки «@@snap <ключ>» ... «@@snap-end».
	Если Прогон.Свойство("Снимки") И Прогон.Снимки.Количество() > 0 Тогда
		СтрокиЧасти.Добавить("@@snapshots");
		Для Каждого БлокСнимка Из Прогон.Снимки Цикл
			СтрокиЧасти.Добавить(БлокСнимка);
		КонецЦикла;
		Прогон.Снимки.Очистить();
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	ИмяФайлаЧасти = "p" + Формат(Автозапуск.НомерЧасти, "ЧЦ=6; ЧВН=; ЧГ=0") + ".txt";
	ЗаписатьФайлАвтозапуска(ИмяФайлаЧасти, СтрСоединить(СтрокиЧасти, Символы.ПС), ИмяОбработчикаЗавершения);

КонецПроцедуры

// Дописывает остаток журнала после последнего задания. Итог пишется после записи этой части.
//
// Параметры:
//  Прогон - Структура - состояние прогона, см. ВыполнитьТестирование.
//
&НаКлиенте
Процедура ЗавершитьАвтозапускПослеПрогона(Прогон)

	Автозапуск.Итоги = Прогон.Итоги;

	СтрокиЗаголовкаЧасти = Новый Массив;
	СтрокиЗаголовкаЧасти.Добавить("@@done=1");

	ЗаписатьЧастьЖурналаАвтозапуска(Прогон, СтрокиЗаголовкаЧасти, "ПослеЗаписиПоследнейЧастиЖурнала");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиПоследнейЧастиЖурнала(Результат, ДополнительныеПараметры) Экспорт

	ЗавершитьАвтозапуск("done", "");

КонецПроцедуры

// Записывает итог автозапуска. После записи обработка завершает работу 1С.
//
// Параметры:
//  СтатусИтога - Строка - done: тестирование выполнено; same: состояние базы не изменилось, тестирование
//                не выполнялось; refused: база не похожа на тестовую; failed: тестирование начать не удалось.
//  Пояснение - Строка - текст для строки message.
//
&НаКлиенте
Процедура ЗавершитьАвтозапуск(Знач СтатусИтога, Знач Пояснение)

	// ** Хлебников С.Ю. 20261117 Экран автозапуска показывает итог.
	Если ПанельАвтозапускаСостояние <> Неопределено Тогда
		ПанельАвтозапускаСостояние.Итог = СтатусИтога;
		Если Автозапуск.Итоги <> Неопределено Тогда
			ПанельАвтозапускаСостояние.Итоги = Автозапуск.Итоги;
		КонецЕсли;
	КонецЕсли;

	ПоказатьСостояниеАвтозапуска("пишу итог (" + СтатусИтога + ") и завершаю работу");

	СтрокиИтога = Новый Массив;
	СтрокиИтога.Добавить("status=" + СтатусИтога);
	СтрокиИтога.Добавить("version=" + ВерсияСборкиФормы());
	СтрокиИтога.Добавить("fingerprint=" + Автозапуск.Отпечаток);
	СтрокиИтога.Добавить("pieces=" + ЧислоСтрокой(Автозапуск.НомерЧасти));
	СтрокиИтога.Добавить("writeerrors=" + ЧислоСтрокой(Автозапуск.ОшибокЗаписи));

	Итоги = Автозапуск.Итоги;
	Если Итоги <> Неопределено Тогда
		СтрокиИтога.Добавить("ok=" + ЧислоСтрокой(Итоги.ОК));
		СтрокиИтога.Добавить("errors=" + ЧислоСтрокой(Итоги.Ошибок));
		СтрокиИтога.Добавить("warnings=" + ЧислоСтрокой(Итоги.Внимание));
		СтрокиИтога.Добавить("skipped=" + ЧислоСтрокой(Итоги.Пропусков));
	КонецЕсли;

	Если Не ПустаяСтрока(Пояснение) Тогда
		СтрокиИтога.Добавить("message=" + ТекстВОднуСтроку(Пояснение));
	КонецЕсли;

	// ** Хлебников С.Ю. 20261117 Режимы regepf и unregepf добавляют в итог свои строки
	Если Автозапуск.Свойство("СтрокиИтогаОбработки") Тогда
		Для Каждого СтрокаИтогаОбработки Из Автозапуск.СтрокиИтогаОбработки Цикл
			СтрокиИтога.Добавить(СтрокаИтогаОбработки);
		КонецЦикла;
	КонецЕсли;
	// ** Хлебников С.Ю. 20261117 конец

	ЗаписатьФайлАвтозапуска("result.txt", СтрСоединить(СтрокиИтога, Символы.ПС), "ПослеЗаписиИтогаАвтозапуска");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиИтогаАвтозапуска(Результат, ДополнительныеПараметры) Экспорт

	// ** Хлебников С.Ю. 20261117 Итог на экране держится две секунды, потом работа 1С завершается.
	Если ПанельАвтозапускаСостояние <> Неопределено Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ЗавершитьРаботуПослеИтога", 2, Истина);
		Возврат;
	КонецЕсли;

	// Без вопроса пользователю и без обработчиков завершения работы.
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// ** Хлебников С.Ю. 20261117 Завершение работы 1С после показа итога на экране автозапуска.
&НаКлиенте
Процедура Подключаемый_ЗавершитьРаботуПослеИтога() Экспорт

	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// Записывает текстовый файл в папку автозапуска, без модальных и синхронных вызовов.
// Обработчик завершения вызывается всегда: после записи, а если запись не удалась - с результатом Ложь.
//
// Параметры:
//  ИмяФайла - Строка - имя файла в папке.
//  ТекстФайла - Строка - содержимое.
//  ИмяОбработчикаЗавершения - Строка - экспортная процедура формы.
//
&НаКлиенте
Процедура ЗаписатьФайлАвтозапуска(Знач ИмяФайла, Знач ТекстФайла, Знач ИмяОбработчикаЗавершения)

	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("ПутьКФайлу", Автозапуск.Каталог + ИмяФайла);
	ПараметрыЗаписи.Вставить("ИмяОбработчикаЗавершения", ИмяОбработчикаЗавершения);

	Оповещение = Новый ОписаниеОповещения(ИмяОбработчикаЗавершения, ЭтотОбъект, ПараметрыЗаписи,
		"ПриОшибкеЗаписиФайлаАвтозапуска", ЭтотОбъект);

	Попытка
		ДокументФайла = Новый ТекстовыйДокумент;
		ДокументФайла.УстановитьТекст(ТекстФайла);
		ДокументФайла.НачатьЗапись(Оповещение, ПараметрыЗаписи.ПутьКФайлу, "UTF-8");
	Исключение
		// Запись не началась, обработчики платформа не вызовет: продолжение вызывается отсюда.
		Автозапуск.ОшибокЗаписи = Автозапуск.ОшибокЗаписи + 1;
		ПродолжениеБезЗаписи = Новый ОписаниеОповещения(ИмяОбработчикаЗавершения, ЭтотОбъект, ПараметрыЗаписи);
		ВыполнитьОбработкуОповещения(ПродолжениеБезЗаписи, Ложь);
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеЗаписиФайлаАвтозапуска(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой платформа не показывает: при автозапуске его некому закрыть.
	СтандартнаяОбработка = Ложь;

	Если Автозапуск = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Автозапуск.ОшибокЗаписи = Автозапуск.ОшибокЗаписи + 1;

	ПродолжениеБезЗаписи = Новый ОписаниеОповещения(ДополнительныеПараметры.ИмяОбработчикаЗавершения, ЭтотОбъект,
		ДополнительныеПараметры);
	ВыполнитьОбработкуОповещения(ПродолжениеБезЗаписи, Ложь);

КонецПроцедуры

// Показывает состояние автозапуска в заголовке окна: гейт снимает окна клиента, если прогон остановился.
//
// Параметры:
//  ТекстСостояния - Строка - что обработка делает сейчас.
//
&НаКлиенте
Процедура ПоказатьСостояниеАвтозапуска(Знач ТекстСостояния)

	ЭтотОбъект.АвтоЗаголовок = Ложь;
	ЭтотОбъект.Заголовок = "Самопроверка (автозапуск), сборка " + ВерсияСборкиФормы() + ": " + ТекстСостояния;

	// ** Хлебников С.Ю. 20261117 То же состояние - на экране автозапуска.
	Если ПанельАвтозапускаСостояние <> Неопределено Тогда
		ПанельАвтозапускаСостояние.Состояние = ТекстСостояния;
		ОбновитьПанельАвтозапуска();
	КонецЕсли;

КонецПроцедуры

// Возвращает ключ задания для сравнения прогонов: имя шага и проверяемый объект.
//
// Параметры:
//  Задание - Структура - задание из очереди, см. НовоеЗадание.
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция КлючЗаданияАвтозапуска(Задание)

	ИмяГруппы = ?(ПустаяСтрока(Задание.Шаг), Задание.Вид, Задание.Шаг);

	Если Не ПустаяСтрока(Задание.Элемент) Тогда
		Возврат ИмяГруппы + "/" + ТекстВОднуСтроку(Задание.Элемент);
	ИначеЕсли Задание.Вид = "Сервер" Тогда
		Возврат ИмяГруппы;
	Иначе
		Возврат ИмяГруппы + "/" + ТекстВОднуСтроку(Задание.Представление);
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ТекстВОднуСтроку(Знач ИсходныйТекст)

	Возврат СтрЗаменить(СтрЗаменить(Строка(ИсходныйТекст), Символы.ВК, ""), Символы.ПС, " ");

КонецФункции

&НаКлиенте
Функция ВерсияСборкиФормы()

	// Версия сборки подставляется при сборке обработки: ГГГГММДД.ЧЧММСС.
	Возврат "00000000.000000";

КонецФункции

// Собирает сведения о сеансе для файла info.txt и отпечаток состояния базы.
//
// Отпечаток - хеш всего, от чего зависит результат тестирования, кроме самих данных: версия обработки,
// версия конфигурации, параметры запуска, граница даты документов, пакет сценариев, расширения базы и их хеш-суммы.
// Пока отпечаток не изменился, гейт не выполняет тестирование «до загрузки» заново.
//
// Возвращаемое значение:
//  Структура - ключи Текст (Строка), Отпечаток (Строка), ОтпечатокНадежный (Булево: хеш-суммы всех расширений
//              получены и хеш посчитан), БазаТестовая (Булево).
//
&НаСервере
Функция СведенияДляАвтозапускаНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");

	ВерсияОбработки = ОбработкаОбъект.ВерсияСборки();
	ВерсияКонфигурации = Метаданные.Имя + " " + Метаданные.Версия;
	БазаТестовая = ОбработкаОбъект.БазаПохожаНаТестовую();

	Если ЗначениеЗаполнено(ДокументыНеСтарше) Тогда
		ГраницаДокументов = НачалоДня(ДокументыНеСтарше);
	Иначе
		Попытка
			ГраницаДокументов = ОбработкаОбъект.ГраницаДатыДокументов();
		Исключение
			// Тестирование без границы тоже выполняется, см. ВыполнитьТестирование: в отпечаток идёт пустая дата.
			ГраницаДокументов = Дата(1, 1, 1);
		КонецПопытки;
	КонецЕсли;

	ПараметрыТекстом = СтрШаблон("docs=%1;write=%2;post=%3;mail=%4;apply=%5;forms=%6;skip=%7;notolder=%8",
		Формат(КоличествоДокументов, "ЧН=0; ЧГ=0"),
		Формат(РазрешитьЗапись, "БЛ=0; БИ=1"),
		Формат(ПроводитьДокументы, "БЛ=0; БИ=1"),
		Формат(ОтключатьПочту, "БЛ=0; БИ=1"),
		Формат(ПроверятьПрименимость, "БЛ=0; БИ=1"),
		Формат(ПроверятьФормы, "БЛ=0; БИ=1"),
		ВРег(СтрЗаменить(НеПроводитьДокументы, " ", "")),
		Формат(ДокументыНеСтарше, "ДФ=yyyyMMdd"));

	// Расширения базы. Хеш-сумма меняется при любой перезагрузке расширения, даже если версию в нём не подняли.
	ОтпечатокНадежный = Истина;
	ОписанияРасширений = Новый СписокЗначений;
	Для Каждого РасширениеБазы Из РасширенияКонфигурации.Получить() Цикл

		СвойстваРасширения = Новый Структура("Имя, Версия, Активно, ХешСумма");
		ЗаполнитьЗначенияСвойств(СвойстваРасширения, РасширениеБазы);

		ХешРасширения = "";
		Если ТипЗнч(СвойстваРасширения.ХешСумма) = Тип("ДвоичныеДанные") Тогда
			ХешРасширения = Base64Строка(СвойстваРасширения.ХешСумма);
			ХешРасширения = СтрЗаменить(СтрЗаменить(ХешРасширения, Символы.ВК, ""), Символы.ПС, "");
		Иначе
			ОтпечатокНадежный = Ложь;
		КонецЕсли;

		ОписанияРасширений.Добавить(СтрШаблон("%1|%2|%3|%4",
			Строка(СвойстваРасширения.Имя),
			Строка(СвойстваРасширения.Версия),
			?(СвойстваРасширения.Активно = Истина, "active", "disabled"),
			ХешРасширения));

	КонецЦикла;
	ОписанияРасширений.СортироватьПоЗначению();

	ЧастиОтпечатка = Новый Массив;
	ЧастиОтпечатка.Добавить(ВерсияОбработки);
	ЧастиОтпечатка.Добавить(ВерсияКонфигурации);
	ЧастиОтпечатка.Добавить(ПараметрыТекстом);
	ЧастиОтпечатка.Добавить(Формат(ГраницаДокументов, "ДФ=yyyyMMdd"));
	// ** Хлебников С.Ю. 20261117 Пакет сценариев: от него зависит, какие шаги идут.
	ПакетСценариевБазы = ОбработкаОбъект.ТекущийПакетСценариев();
	ЧастиОтпечатка.Добавить("pack=" + ПакетСценариевБазы.Имя);
	Для Каждого ОписаниеРасширения Из ОписанияРасширений Цикл
		ЧастиОтпечатка.Добавить(ОписаниеРасширения.Значение);
	КонецЦикла;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(ЧастиОтпечатка, Символы.ПС));
	Отпечаток = НРег(СтрЗаменить(Строка(Хеширование.ХешСумма), " ", ""));

	// Хеш SHA-256 в виде текста - 64 знака. Если платформа вернула что-то другое, полагаться на отпечаток нельзя.
	Если СтрДлина(Отпечаток) <> 64 Тогда
		ОтпечатокНадежный = Ложь;
	КонецЕсли;

	СтрокиСведений = Новый Массив;
	СтрокиСведений.Добавить("selfcheck=" + ВерсияОбработки);
	СтрокиСведений.Добавить("time=" + Формат(ТекущаяДатаСеанса(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
	СтрокиСведений.Добавить("base=" + ОбработкаОбъект.ИмяИнформационнойБазы());
	СтрокиСведений.Добавить("user=" + ИмяПользователя());
	СтрокиСведений.Добавить("config=" + ВерсияКонфигурации);
	СтрокиСведений.Добавить("testbase=" + Формат(БазаТестовая, "БЛ=0; БИ=1"));
	СтрокиСведений.Добавить("params=" + ПараметрыТекстом);
	СтрокиСведений.Добавить("docsboundary=" + Формат(ГраницаДокументов, "ДФ=yyyyMMdd"));
	// ** Хлебников С.Ю. 20261117 Пакет сценариев и почему выбран.
	СтрокиСведений.Добавить("pack=" + ПакетСценариевБазы.Имя);
	СтрокиСведений.Добавить("packname=" + ПакетСценариевБазы.Представление);
	СтрокиСведений.Добавить("packreason=" + ПакетСценариевБазы.Причина);
	Для Каждого ОписаниеРасширения Из ОписанияРасширений Цикл
		СтрокиСведений.Добавить("ext=" + ОписаниеРасширения.Значение);
	КонецЦикла;
	СтрокиСведений.Добавить("fingerprint=" + Отпечаток);
	СтрокиСведений.Добавить("fingerprintreliable=" + Формат(ОтпечатокНадежный, "БЛ=0; БИ=1"));

	Сведения = Новый Структура;
	Сведения.Вставить("Текст", СтрСоединить(СтрокиСведений, Символы.ПС));
	Сведения.Вставить("Отпечаток", Отпечаток);
	Сведения.Вставить("ОтпечатокНадежный", ОтпечатокНадежный);
	Сведения.Вставить("БазаТестовая", БазаТестовая);

	Возврат Сведения;

КонецФункции

#КонецОбласти

// ** Хлебников С.Ю. 20261117 Внешние обработки в справочнике «Дополнительные отчёты и обработки» без человека.
// Так гейт кладёт обработку в temp, а скрипт обновления - в рабочую. Параметр запуска /C:
//  regepf;out=<папка>;file=<файл base64>;name=<имя файла обработки, например Печать.epf>
//   - новая обработка регистрируется, а если в справочнике уже есть элемент с тем же именем объекта, он
//     обновляется. Регистрирует БСП: ДополнительныеОтчетыИОбработки.ЗарегистрироватьОбработку, как при загрузке
//     из файла в форме элемента. Перед записью прежняя версия кладётся в old.b64. После записи - проверка:
//     обработка подключается так, как её подключает БСП, создаётся объект, создаются формы (без открытия).
//  unregepf;out=<папка>;name=<имя объекта>;ref=<уникальный идентификатор элемента>
//   - снять обработку, которую добавил гейт: публикация «Отключена» и пометка удаления. Элемент ищется по ссылке
//     и имени объекта вместе, чтобы не снять чужой.
// Файлы обработок - в base64, текстом: так чтение и запись на клиенте идут асинхронно, без синхронных вызовов.
// Итог - result.txt (status, message и строки обработки: objname, title, objversion, oldversion, isnew, ref,
// kind, commands, check, checkerror, forms, formerror).
#Область ВнешниеОбработкиСправочника

// Начинает режим regepf или unregepf: отметка запуска, дальше - ПослеОтметкиРаботыСОбработкой.
//
// Параметры:
//  ПараметрыАвтозапуска - Структура - см. ПараметрыАвтозапускаИзСтроки.
//
&НаКлиенте
Процедура НачатьРаботуСОбработкойАвтозапуском(ПараметрыАвтозапуска)

	Автозапуск = ПараметрыАвтозапуска;
	Автозапуск.Вставить("НомерЧасти", 0);
	Автозапуск.Вставить("ОшибокЗаписи", 0);
	Автозапуск.Вставить("Отпечаток", "");
	Автозапуск.Вставить("Итоги", Неопределено);
	Автозапуск.Вставить("СтрокиИтогаОбработки", Новый Массив);
	Автозапуск.Вставить("ИтогОбработки", Неопределено);

	ПоказатьСостояниеАвтозапуска(Автозапуск.Режим + " " + Автозапуск.ИмяОбработки + ", файлы пишу в " + Автозапуск.Каталог);
	ЗаписатьФайлАвтозапуска("started.txt", "started=" + ВерсияСборкиФормы(), "ПослеОтметкиРаботыСОбработкой");

КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиРаботыСОбработкой(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Ложь Тогда
		// Папка недоступна: сообщить о результате некуда.
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Автозапуск.ИмяОбработки) Тогда
		ЗавершитьАвтозапуск("failed", "В параметре запуска нет name=.");
		Возврат;
	КонецЕсли;

	Если Автозапуск.Режим = "unregepf" Тогда
		Попытка
			ИтогОбработки = СнятьОбработкуНаСервере(Автозапуск.ИмяОбработки, Автозапуск.СсылкаОбработки);
		Исключение
			ЗавершитьАвтозапуск("failed", "Обработка не снята: "
				+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
		ДобавитьСтрокиИтогаОбработки(ИтогОбработки);
		ЗавершитьАвтозапуск(ИтогОбработки.Статус, ИтогОбработки.Сообщение);
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(Автозапуск.ФайлСтатьи) Тогда
		ЗавершитьАвтозапуск("failed", "В параметре запуска нет file=.");
		Возврат;
	КонецЕсли;

	ПоказатьСостояниеАвтозапуска("читаю файл обработки " + Автозапуск.ИмяОбработки);
	ДокументФайла = Новый ТекстовыйДокумент;
	ПараметрыЧтения = Новый Структура("ДокументФайла", ДокументФайла);
	Оповещение = Новый ОписаниеОповещения("ПослеЧтенияФайлаОбработки", ЭтотОбъект, ПараметрыЧтения,
		"ПриОшибкеЧтенияФайлаОбработки", ЭтотОбъект);

	Попытка
		ДокументФайла.НачатьЧтение(Оповещение, Автозапуск.ФайлСтатьи, КодировкаТекста.ANSI);
	Исключение
		// Чтение не началось, обработчики платформа не вызовет.
		ЗавершитьАвтозапуск("failed", "Не удалось прочитать файл " + Автозапуск.ФайлСтатьи + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЧтенияФайлаОбработки(ДополнительныеПараметры) Экспорт

	ТекстФайла = СокрЛП(ДополнительныеПараметры.ДокументФайла.ПолучитьТекст());
	Если ПустаяСтрока(ТекстФайла) Тогда
		ЗавершитьАвтозапуск("failed", "Файл обработки пустой: " + Автозапуск.ФайлСтатьи);
		Возврат;
	КонецЕсли;
	Автозапуск.Вставить("ТекстФайлаОбработки", ТекстФайла);

	// Сначала - что сейчас в справочнике: прежняя версия ложится на диск до того, как её заменит новая.
	ПоказатьСостояниеАвтозапуска("смотрю, есть ли " + Автозапуск.ИмяОбработки + " в справочнике");
	Попытка
		Текущая = ТекущаяОбработкаНаСервере(ТекстФайла, Автозапуск.ИмяОбработки);
	Исключение
		ЗавершитьАвтозапуск("failed", "Обработка не подключилась, в справочник не записана: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если ПустаяСтрока(Текущая.СтараяBase64) Тогда
		ЗарегистрироватьОбработкуАвтозапуском();
		Возврат;
	КонецЕсли;

	ЗаписатьФайлАвтозапуска("old.b64", Текущая.СтараяBase64, "ПослеЗаписиПрежнейОбработки");

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписиПрежнейОбработки(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Ложь Тогда
		// Без копии прежней версии обработку не заменяем: откатывать было бы не к чему.
		ЗавершитьАвтозапуск("failed", "Прежняя версия обработки не сохранилась в old.b64: новая не записана.");
		Возврат;
	КонецЕсли;

	Автозапуск.СтрокиИтогаОбработки.Добавить("oldsaved=1");
	ЗарегистрироватьОбработкуАвтозапуском();

КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьОбработкуАвтозапуском()

	ПоказатьСостояниеАвтозапуска("записываю " + Автозапуск.ИмяОбработки + " в справочник");
	Попытка
		ИтогОбработки = ЗарегистрироватьОбработкуНаСервере(Автозапуск.ТекстФайлаОбработки, Автозапуск.ИмяОбработки);
	Исключение
		ЗавершитьАвтозапуск("failed", "Обработка не записана: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ДобавитьСтрокиИтогаОбработки(ИтогОбработки);
	Если ИтогОбработки.Статус <> "done" Тогда
		ЗавершитьАвтозапуск(ИтогОбработки.Статус, ИтогОбработки.Сообщение);
		Возврат;
	КонецЕсли;

	// Формы - на клиенте: создаются без открытия. При создании компилируется модуль формы и выполняется
	// ПриСозданииНаСервере. Сообщения, которыми формы объясняют отказ, с экрана убираются.
	ПоказатьСостояниеАвтозапуска("проверяю формы " + ИтогОбработки.ИмяОбъекта);
	Для Каждого ПолноеИмяФормы Из ИтогОбработки.Формы Цикл
		Попытка
			// ** Хлебников С.Ю. 20261117 ПолучитьФорму намеренно: форма обработки создаётся без открытия.
			ПолучитьФорму(ПолноеИмяФормы, , , Новый УникальныйИдентификатор); // BSLLS:GetFormMethod-off
		Исключение
			Автозапуск.СтрокиИтогаОбработки.Добавить("formerror=" + ТекстВОднуСтроку(ПолноеИмяФормы + ": "
				+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;
	ОчиститьСообщения();

	ЗавершитьАвтозапуск("done", ИтогОбработки.Сообщение);

КонецПроцедуры

&НаКлиенте
Процедура ПриОшибкеЧтенияФайлаОбработки(ИнформацияОбОшибке, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт

	// Окно с ошибкой платформа не показывает: при автозапуске его некому закрыть.
	СтандартнаяОбработка = Ложь;
	ЗавершитьАвтозапуск("failed", "Не удалось прочитать файл " + Автозапуск.ФайлСтатьи + ": "
		+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке));

КонецПроцедуры

// Переносит итог обработки в строки result.txt.
//
// Параметры:
//  ИтогОбработки - Структура - см. НовыйИтогОбработки.
//
&НаКлиенте
Процедура ДобавитьСтрокиИтогаОбработки(ИтогОбработки)

	Строки = Автозапуск.СтрокиИтогаОбработки;
	Строки.Добавить("objname=" + ИтогОбработки.ИмяОбъекта);
	Строки.Добавить("title=" + ТекстВОднуСтроку(ИтогОбработки.Наименование));
	Строки.Добавить("objversion=" + ТекстВОднуСтроку(ИтогОбработки.Версия));
	Строки.Добавить("oldversion=" + ТекстВОднуСтроку(ИтогОбработки.СтараяВерсия));
	Строки.Добавить("isnew=" + ?(ИтогОбработки.Новая, "1", "0"));
	Строки.Добавить("ref=" + ИтогОбработки.Ссылка);
	Строки.Добавить("kind=" + ТекстВОднуСтроку(ИтогОбработки.Вид));
	Строки.Добавить("commands=" + ЧислоСтрокой(ИтогОбработки.Команд));
	Строки.Добавить("forms=" + ЧислоСтрокой(ИтогОбработки.Формы.Количество()));
	Строки.Добавить("check=" + ИтогОбработки.Проверка);
	Если Не ПустаяСтрока(ИтогОбработки.ОшибкаПроверки) Тогда
		Строки.Добавить("checkerror=" + ТекстВОднуСтроку(ИтогОбработки.ОшибкаПроверки));
	КонецЕсли;

КонецПроцедуры

// Возвращает пустой итог работы с обработкой.
//
// Возвращаемое значение:
//  Структура - Статус (done, failed), Сообщение, ИмяОбъекта, Наименование, Версия, СтараяВерсия, СтараяBase64,
//              Новая, Ссылка (уникальный идентификатор строкой), Вид, Команд, Проверка (ok, error, пусто),
//              ОшибкаПроверки, Формы (Массив полных имён форм).
//
&НаСервереБезКонтекста
Функция НовыйИтогОбработки()

	ИтогОбработки = Новый Структура;
	ИтогОбработки.Вставить("Статус", "failed");
	ИтогОбработки.Вставить("Сообщение", "");
	ИтогОбработки.Вставить("ИмяОбъекта", "");
	ИтогОбработки.Вставить("Наименование", "");
	ИтогОбработки.Вставить("Версия", "");
	ИтогОбработки.Вставить("СтараяВерсия", "");
	ИтогОбработки.Вставить("СтараяBase64", "");
	ИтогОбработки.Вставить("Новая", Ложь);
	ИтогОбработки.Вставить("Ссылка", "");
	ИтогОбработки.Вставить("Вид", "");
	ИтогОбработки.Вставить("Команд", 0);
	ИтогОбработки.Вставить("Проверка", "");
	ИтогОбработки.Вставить("ОшибкаПроверки", "");
	ИтогОбработки.Вставить("Формы", Новый Массив);
	Возврат ИтогОбработки;

КонецФункции

// Что сейчас в справочнике под тем же именем объекта, что у обработки из файла.
//
// Параметры:
//  ТекстBase64 - Строка - файл обработки в base64.
//  ИмяФайла - Строка - имя файла: по расширению .erf - отчёт, иначе обработка.
//
// Возвращаемое значение:
//  Структура - см. НовыйИтогОбработки; заполнены ИмяОбъекта, Новая, СтараяВерсия, СтараяBase64.
//
&НаСервереБезКонтекста
Функция ТекущаяОбработкаНаСервере(Знач ТекстBase64, Знач ИмяФайла)

	УстановитьПривилегированныйРежим(Истина);

	ИтогОбработки = НовыйИтогОбработки();
	ДвоичныеДанные = ДвоичныеДанныеОбработкиИзBase64(ТекстBase64);
	ИтогОбработки.ИмяОбъекта = ИмяОбъектаВнешнейОбработки(ДвоичныеДанные, ЭтоФайлОтчета(ИмяФайла));

	Ссылка = ЭлементСправочникаОбработок(ИтогОбработки.ИмяОбъекта);
	ИтогОбработки.Новая = Не ЗначениеЗаполнено(Ссылка);
	Если Не ИтогОбработки.Новая Тогда
		ИтогОбработки.СтараяВерсия = Строка(Ссылка.Версия);
		ПрежниеДанные = Ссылка.ХранилищеОбработки.Получить();
		Если ТипЗнч(ПрежниеДанные) = Тип("ДвоичныеДанные") Тогда
			ИтогОбработки.СтараяBase64 = Base64Строка(ПрежниеДанные);
		КонецЕсли;
	КонецЕсли;

	ИтогОбработки.Статус = "done";
	Возврат ИтогОбработки;

КонецФункции

// Регистрирует обработку из файла в справочнике: новый элемент или обновление элемента с тем же именем объекта.
// Порядок - как в БСП при загрузке обработки из файла и при пакетной регистрации: ЗарегистрироватьОбработку
// заполняет наименование, версию, вид, назначение, команды и разрешения, потом - хранилище и имя объекта.
// После записи - проверка подключения и список форм для проверки на клиенте.
//
// Параметры:
//  ТекстBase64 - Строка - файл обработки в base64.
//  ИмяФайла - Строка - имя файла обработки.
//
// Возвращаемое значение:
//  Структура - см. НовыйИтогОбработки.
//
&НаСервереБезКонтекста
Функция ЗарегистрироватьОбработкуНаСервере(Знач ТекстBase64, Знач ИмяФайла)

	УстановитьПривилегированныйРежим(Истина);

	ИтогОбработки = НовыйИтогОбработки();
	ДвоичныеДанные = ДвоичныеДанныеОбработкиИзBase64(ТекстBase64);
	ЭтоОтчет = ЭтоФайлОтчета(ИмяФайла);
	ИмяОбъекта = ИмяОбъектаВнешнейОбработки(ДвоичныеДанные, ЭтоОтчет);
	ИтогОбработки.ИмяОбъекта = ИмяОбъекта;
	АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);

	НачатьТранзакцию();
	Попытка

		Ссылка = ЭлементСправочникаОбработок(ИмяОбъекта);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ДополнительныеОтчетыИОбработки");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
			Блокировка.Заблокировать();
			ОбъектОбработки = Ссылка.ПолучитьОбъект();
			ИтогОбработки.СтараяВерсия = Строка(ОбъектОбработки.Версия);
		Иначе
			ОбъектОбработки = Справочники.ДополнительныеОтчетыИОбработки.СоздатьЭлемент();
			ОбъектОбработки.ИспользоватьДляФормыОбъекта = Истина;
			ОбъектОбработки.ИспользоватьДляФормыСписка = Истина;
			ОбъектОбработки.Публикация = Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется;
			ИтогОбработки.Новая = Истина;
		КонецЕсли;

		ПараметрыРегистрации = Новый Структура;
		ПараметрыРегистрации.Вставить("АдресДанныхОбработки", АдресДанных);
		ПараметрыРегистрации.Вставить("ЭтоОтчет", ЭтоОтчет);
		ПараметрыРегистрации.Вставить("ОтключатьКонфликтующие", Ложь);
		ПараметрыРегистрации.Вставить("ИмяФайла", ИмяФайла);
		ПараметрыРегистрации.Вставить("ОтключатьПубликацию", Ложь);

		// Другие используемые элементы с тем же именем объекта БСП не даст записать: они отключаются,
		// как при пакетной регистрации.
		Конфликтующие = КонфликтующиеОбработки(ИмяОбъекта, ОбъектОбработки.Ссылка);
		Если Конфликтующие.Количество() > 0 Тогда
			ПараметрыРегистрации.ОтключатьКонфликтующие = Истина;
			ПараметрыРегистрации.Вставить("Конфликтующие", Конфликтующие);
		КонецЕсли;

		РезультатРегистрации = ДополнительныеОтчетыИОбработки.ЗарегистрироватьОбработку(ОбъектОбработки,
			ПараметрыРегистрации);
		Если Не РезультатРегистрации.Успех Тогда
			ВызватьИсключение РезультатРегистрации.ТекстОшибки;
		КонецЕсли;

		ОбъектОбработки.ХранилищеОбработки = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		ОбъектОбработки.ИмяОбъекта = ИмяОбъекта;
		ОбъектОбработки.ИмяФайла = ИмяФайла;

		// Новая глобальная обработка - во все разделы, как при пакетной регистрации БСП.
		Если ИтогОбработки.Новая И ДополнительныеОтчетыИОбработки.ПроверитьГлобальнаяОбработка(ОбъектОбработки.Вид) Тогда
			Для Каждого ОписаниеРаздела Из ДополнительныеОтчетыИОбработки.ПодключенныеОбъектыМетаданных(ОбъектОбработки.Вид) Цикл
				Если ОбъектОбработки.Разделы.Найти(ОписаниеРаздела.Ссылка, "Раздел") = Неопределено Тогда
					ОбъектОбработки.Разделы.Добавить().Раздел = ОписаниеРаздела.Ссылка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		ОбъектОбработки.Записать();
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ИтогОбработки.Сообщение = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат ИтогОбработки;
	КонецПопытки;

	ИтогОбработки.Статус = "done";
	ИтогОбработки.Ссылка = Строка(ОбъектОбработки.Ссылка.УникальныйИдентификатор());
	ИтогОбработки.Наименование = ОбъектОбработки.Наименование;
	ИтогОбработки.Версия = Строка(ОбъектОбработки.Версия);
	ИтогОбработки.Вид = Строка(ОбъектОбработки.Вид);
	ИтогОбработки.Команд = ОбъектОбработки.Команды.Количество();
	ИтогОбработки.Сообщение = ?(ИтогОбработки.Новая, "Обработка добавлена в справочник: ",
		"Обработка обновлена в справочнике: ") + ОбъектОбработки.Наименование + " " + ИтогОбработки.Версия;

	// Проверка: обработка подключается так, как её подключает БСП, объект создаётся; формы - на клиенте.
	Попытка
		ИмяПодключенной = ДополнительныеОтчетыИОбработки.ПодключитьВнешнююОбработку(ОбъектОбработки.Ссылка);
		ВнешнийОбъект = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ОбъектОбработки.Ссылка);
		ПрефиксФормы = ?(ЭтоОтчет, "ВнешнийОтчет.", "ВнешняяОбработка.") + ИмяПодключенной + ".Форма.";
		Для Каждого ОписаниеФормы Из ВнешнийОбъект.Метаданные().Формы Цикл
			ИтогОбработки.Формы.Добавить(ПрефиксФормы + ОписаниеФормы.Имя);
		КонецЦикла;
		ИтогОбработки.Проверка = "ok";
	Исключение
		ИтогОбработки.Проверка = "error";
		ИтогОбработки.ОшибкаПроверки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат ИтогОбработки;

КонецФункции

// Снимает обработку, добавленную гейтом: публикация «Отключена» и пометка удаления.
//
// Параметры:
//  ИмяОбъекта - Строка - имя объекта обработки.
//  СтрокаСсылки - Строка - уникальный идентификатор элемента справочника.
//
// Возвращаемое значение:
//  Структура - см. НовыйИтогОбработки.
//
&НаСервереБезКонтекста
Функция СнятьОбработкуНаСервере(Знач ИмяОбъекта, Знач СтрокаСсылки)

	УстановитьПривилегированныйРежим(Истина);

	ИтогОбработки = НовыйИтогОбработки();
	ИтогОбработки.ИмяОбъекта = ИмяОбъекта;
	Если ПустаяСтрока(СтрокаСсылки) Тогда
		ИтогОбработки.Сообщение = "В параметре запуска нет ref=: без ссылки обработка не снимается.";
		Возврат ИтогОбработки;
	КонецЕсли;

	Ссылка = Справочники.ДополнительныеОтчетыИОбработки.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаСсылки));
	ОбъектОбработки = Ссылка.ПолучитьОбъект();
	Если ОбъектОбработки = Неопределено Тогда
		ИтогОбработки.Статус = "done";
		ИтогОбработки.Сообщение = "Элемента уже нет в справочнике.";
		Возврат ИтогОбработки;
	КонецЕсли;
	Если ОбъектОбработки.ИмяОбъекта <> ИмяОбъекта Тогда
		ИтогОбработки.Сообщение = "У элемента другое имя объекта (" + ОбъектОбработки.ИмяОбъекта + "): не снимаю.";
		Возврат ИтогОбработки;
	КонецЕсли;

	ОбъектОбработки.Публикация = Перечисления.ВариантыПубликацииДополнительныхОтчетовИОбработок.Отключена;
	ОбъектОбработки.Записать();
	ОбъектОбработки.УстановитьПометкуУдаления(Истина);

	ИтогОбработки.Статус = "done";
	ИтогОбработки.Ссылка = СтрокаСсылки;
	ИтогОбработки.Наименование = ОбъектОбработки.Наименование;
	ИтогОбработки.Сообщение = "Обработка снята: публикация «Отключена», элемент помечен на удаление.";
	Возврат ИтогОбработки;

КонецФункции

&НаСервереБезКонтекста
Функция ДвоичныеДанныеОбработкиИзBase64(Знач ТекстBase64)

	ДвоичныеДанные = Base64Значение(ТекстBase64);
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		ВызватьИсключение "В файле обработки не base64 или он пустой.";
	КонецЕсли;
	Возврат ДвоичныеДанные;

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоФайлОтчета(Знач ИмяФайла)

	Возврат НРег(Прав(СокрЛП(ИмяФайла), 4)) = ".erf";

КонецФункции

// Имя объекта метаданных обработки (отчёта) из файла: обработка подключается так же, как её подключает БСП.
&НаСервереБезКонтекста
Функция ИмяОбъектаВнешнейОбработки(ДвоичныеДанные, ЭтоОтчет)

	АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
	Если ЭтоОтчет Тогда
		ИмяПодключенного = ВнешниеОтчеты.Подключить(АдресДанных, , Истина, ОбщегоНазначения.ОписаниеЗащитыБезПредупреждений());
		Возврат ВнешниеОтчеты.Создать(ИмяПодключенного).Метаданные().Имя;
	КонецЕсли;
	ИмяПодключенного = ВнешниеОбработки.Подключить(АдресДанных, , Истина, ОбщегоНазначения.ОписаниеЗащитыБезПредупреждений());
	Возврат ВнешниеОбработки.Создать(ИмяПодключенного).Метаданные().Имя;

КонецФункции

// Элемент справочника с этим именем объекта, не помеченный на удаление; используемый - первым.
&НаСервереБезКонтекста
Функция ЭлементСправочникаОбработок(ИмяОбъекта)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обработки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = &ИмяОбъекта
	|	И НЕ Обработки.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Обработки.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();

КонецФункции

// Другие используемые элементы с тем же именем объекта.
&НаСервереБезКонтекста
Функция КонфликтующиеОбработки(ИмяОбъекта, СвояСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Обработки.Ссылка КАК Ссылка,
	|	Обработки.Представление КАК Представление
	|ИЗ
	|	Справочник.ДополнительныеОтчетыИОбработки КАК Обработки
	|ГДЕ
	|	Обработки.ИмяОбъекта = &ИмяОбъекта
	|	И Обработки.Публикация = ЗНАЧЕНИЕ(Перечисление.ВариантыПубликацииДополнительныхОтчетовИОбработок.Используется)
	|	И НЕ Обработки.ПометкаУдаления
	|	И Обработки.Ссылка <> &СвояСсылка";
	Запрос.УстановитьПараметр("ИмяОбъекта", ИмяОбъекта);
	Запрос.УстановитьПараметр("СвояСсылка", СвояСсылка);

	Конфликтующие = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Конфликтующие.Добавить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;
	Возврат Конфликтующие;

КонецФункции

#КонецОбласти
// ** Хлебников С.Ю. 20261117 конец

// ** Хлебников С.Ю. 20261117 Экран автозапуска. При автозапуске интерактивная часть формы скрывается, вместо неё
// поле HTML-документа ПанельАвтозапуска: шапка с общей полосой хода, счётчики, текущее задание и карточки шагов
// с полосой по заданиям шага. Данные - из очереди прогона, см. ВыполнитьТестирование, сам прогон не меняется.
// Страница обновляется вызовом функции ciUpdate внутри страницы; если вызвать её не удалось, документ
// записывается в поле заново, не чаще раза в три секунды.
#Область ПанельАвтозапуска

// Скрывает кнопки и поля формы и показывает экран автозапуска.
&НаКлиенте
Процедура ПоказатьПанельАвтозапуска()

	Панель = Новый Структура;
	Панель.Вставить("Блоки", Новый Массив);
	Панель.Вставить("ПоШагу", Новый Соответствие);
	Панель.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Панель.Вставить("НачалоЗадания", 0);
	Панель.Вставить("ПолнаяОтрисовка", 0);
	Панель.Вставить("Снимок", Неопределено);
	Панель.Вставить("Состояние", "");
	Панель.Вставить("ТекущийШаг", "");
	Панель.Вставить("ТекущееЗадание", "");
	Панель.Вставить("Всего", 0);
	Панель.Вставить("Выполнено", 0);
	Панель.Вставить("Итоги", Новый Структура("ОК, Ошибок, Внимание, Пропусков", 0, 0, 0, 0));
	Панель.Вставить("Режим", "");
	Панель.Вставить("Итог", "");
	ПанельАвтозапускаСостояние = Панель;

	Для Каждого ЭлементФормы Из ЭтотОбъект.ПодчиненныеЭлементы Цикл
		ЭлементФормы.Видимость = (ЭлементФормы.Имя = "ПанельАвтозапуска");
	КонецЦикла;
	Попытка
		ЭтотОбъект.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет;
	// ** Хлебников С.Ю. 20261117 пустой блок намеренно, см. комментарий ниже
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		// В старых версиях платформы свойство только для чтения: панель команд остаётся, она пустая.
	КонецПопытки;

	ОбновитьПанельАвтозапуска();

КонецПроцедуры

// Строит карточки шагов по очереди прогона: шаг - это задания с одним представлением шага, в порядке очереди.
//
// Параметры:
//  Прогон - Структура - состояние прогона, см. ВыполнитьТестирование.
//
&НаКлиенте
Процедура ЗаполнитьПанельАвтозапуска(Прогон)

	Панель = ПанельАвтозапускаСостояние;
	Если Панель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Панель.Блоки = Новый Массив;
	Панель.ПоШагу = Новый Соответствие;
	Панель.Всего = Прогон.Очередь.Количество();
	Панель.Выполнено = Прогон.Номер;
	Панель.Режим = ?(РазрешитьЗапись, "запись в транзакции, всё отменяется", "только чтение");

	Для Индекс = 0 По Прогон.Очередь.ВГраница() Цикл
		Задание = Прогон.Очередь[Индекс];
		Блок = Панель.ПоШагу.Получить(Задание.ПредставлениеШага);
		Если Блок = Неопределено Тогда
			Блок = Новый Структура("Имя, Всего, Выполнено, ОК, Ошибок, Внимание, Пропусков, ВПрошломСеансе,"
				+ " Начало, Конец", Задание.ПредставлениеШага, 0, 0, 0, 0, 0, 0, 0, 0, 0);
			Панель.Блоки.Добавить(Блок);
			Панель.ПоШагу.Вставить(Задание.ПредставлениеШага, Блок);
		КонецЕсли;
		Блок.Всего = Блок.Всего + 1;
		// Задания до номера, с которого гейт продолжает прогон, выполнялись в прошлом сеансе.
		Если Индекс < Прогон.Номер Тогда
			Блок.Выполнено = Блок.Выполнено + 1;
			Блок.ВПрошломСеансе = Блок.ВПрошломСеансе + 1;
		КонецЕсли;
	КонецЦикла;

	ОбновитьПанельАвтозапуска();

КонецПроцедуры

// Отмечает начало задания: шаг становится текущим, запоминаются итоги прогона до задания.
&НаКлиенте
Процедура ПанельАвтозапускаНачалоЗадания(Прогон, Задание)

	Панель = ПанельАвтозапускаСостояние;
	Если Панель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итоги = Прогон.Итоги;
	Панель.Снимок = Новый Структура("ОК, Ошибок, Внимание, Пропусков", Итоги.ОК, Итоги.Ошибок, Итоги.Внимание,
		Итоги.Пропусков);
	Панель.ТекущийШаг = Задание.ПредставлениеШага;
	Панель.ТекущееЗадание = ТекстВОднуСтроку(Задание.Представление);
	Панель.НачалоЗадания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Блок = Панель.ПоШагу.Получить(Задание.ПредставлениеШага);
	Если Блок <> Неопределено И Блок.Начало = 0 Тогда
		Блок.Начало = Панель.НачалоЗадания;
	КонецЕсли;

	ОбновитьПанельАвтозапуска();

КонецПроцедуры

// Отмечает конец задания: в карточку шага добавляется то, что задание дописало в итоги прогона.
&НаКлиенте
Процедура ПанельАвтозапускаКонецЗадания(Прогон, Задание)

	Панель = ПанельАвтозапускаСостояние;
	Если Панель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Итоги = Прогон.Итоги;
	Снимок = Панель.Снимок;
	Если Снимок = Неопределено Тогда
		Снимок = Новый Структура("ОК, Ошибок, Внимание, Пропусков", Итоги.ОК, Итоги.Ошибок, Итоги.Внимание,
			Итоги.Пропусков);
	КонецЕсли;

	Блок = Панель.ПоШагу.Получить(Задание.ПредставлениеШага);
	Если Блок <> Неопределено Тогда
		Блок.Выполнено = Мин(Блок.Всего, Блок.Выполнено + 1);
		Блок.ОК = Блок.ОК + (Итоги.ОК - Снимок.ОК);
		Блок.Ошибок = Блок.Ошибок + (Итоги.Ошибок - Снимок.Ошибок);
		Блок.Внимание = Блок.Внимание + (Итоги.Внимание - Снимок.Внимание);
		Блок.Пропусков = Блок.Пропусков + (Итоги.Пропусков - Снимок.Пропусков);
		Если Блок.Выполнено >= Блок.Всего Тогда
			Блок.Конец = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонецЕсли;
	КонецЕсли;

	Панель.Снимок = Неопределено;
	Панель.Выполнено = Прогон.Номер;
	Панель.Итоги = Новый Структура("ОК, Ошибок, Внимание, Пропусков", Итоги.ОК, Итоги.Ошибок, Итоги.Внимание,
		Итоги.Пропусков);

	ОбновитьПанельАвтозапуска();

КонецПроцедуры

// Перерисовывает экран автозапуска.
&НаКлиенте
Процедура ОбновитьПанельАвтозапуска()

	Панель = ПанельАвтозапускаСостояние;
	Если Панель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстЭкрана = ТекстЭкранаАвтозапуска(Панель);

	// Сначала - обновление внутри уже загруженной страницы: так не сбиваются анимации и не мигает экран.
	Если Панель.ПолнаяОтрисовка > 0 Тогда
		Попытка
			ДокументСтраницы = Элементы.ПанельАвтозапуска.Документ;
			Попытка
				ОкноСтраницы = ДокументСтраницы.defaultView;
			Исключение
				ОкноСтраницы = ДокументСтраницы.parentWindow;
			КонецПопытки;
			ОкноСтраницы.ciUpdate(ТекстЭкрана);
			Возврат;
		// ** Хлебников С.Ю. 20261117 пустой блок намеренно, см. комментарий ниже
		Исключение // BSLLS:MissingCodeTryCatchEx-off
			// Страница ещё грузится или обработчик страницы недоступен: ниже документ записывается заново.
		КонецПопытки;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Панель.ПолнаяОтрисовка = 0 Или Сейчас - Панель.ПолнаяОтрисовка >= 3000 Тогда
		ПанельАвтозапускаHTML = СтраницаАвтозапуска(ТекстЭкрана);
		Панель.ПолнаяОтрисовка = Сейчас;
	КонецЕсли;

КонецПроцедуры

// Возвращает изменяемую часть экрана: шапку, счётчики, текущее задание и карточки шагов.
//
// Параметры:
//  Панель - Структура - см. ПоказатьПанельАвтозапуска.
//
// Возвращаемое значение:
//  Строка - HTML.
//
&НаКлиенте
Функция ТекстЭкранаАвтозапуска(Панель)

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПрошлоСекунд = Цел((Сейчас - Панель.Начало) / 1000);
	Доля = 0;
	Если Панель.Всего > 0 Тогда
		Доля = Мин(1, Панель.Выполнено / Панель.Всего);
	КонецЕсли;
	Процент = Цел(Доля * 100);

	ИдётПрогон = ПустаяСтрока(Панель.Итог) И Панель.Всего > 0;
	КлассШапки = "run";
	Если Не ПустаяСтрока(Панель.Итог) Тогда
		КлассШапки = ?(Панель.Итоги.Ошибок > 0 Или Панель.Итог = "failed" Или Панель.Итог = "refused", "bad",
			?(Панель.Итоги.Внимание > 0, "warn", "ok"));
	КонецЕсли;

	Части = Новый Массив;

	// Шапка: название, база и режим, время и процент.
	Подзаголовок = ИмяБазыДляПанели() + " · сборка " + ВерсияСборкиФормы();
	Если Не ПустаяСтрока(Панель.Режим) Тогда
		Подзаголовок = Подзаголовок + " · " + Панель.Режим;
	КонецЕсли;
	Части.Добавить("<div class=""top " + КлассШапки + """><div class=""logo""><span class=""beat anim""></span></div>"
		+ "<div class=""ttl""><div class=""h1"">Самопроверка после обновления</div><div class=""sub"">"
		+ ТекстДляHTML(Подзаголовок) + "</div></div><div class=""big""><div class=""pct"">"
		+ ЧислоСтрокой(Процент) + "<small>%</small></div><div class=""sub""><span class=""tick"" data-base="""
		+ Формат(ПрошлоСекунд, "ЧН=0; ЧГ=0") + """ data-run=""" + ?(ИдётПрогон Или ПустаяСтрока(Панель.Итог), "1", "0")
		+ """>" + ТекстДлительности(ПрошлоСекунд) + "</span>" + ОценкаОстатка(Панель, ПрошлоСекунд)
		+ "</div></div></div>");

	// Общая полоса хода.
	КлассПолосы = ?(ИдётПрогон, "fill flow anim", "fill");
	Части.Добавить("<div class=""track main""><i class=""" + КлассПолосы + """ style=""width:"
		+ ЧислоДляCSS(Доля * 100) + "%""></i></div>");
	Части.Добавить("<div class=""meta"">" + ?(Панель.Всего > 0, "задание " + ЧислоСтрокой(Мин(Панель.Выполнено + 1,
		Панель.Всего)) + " из " + ЧислоСтрокой(Панель.Всего) + " · шагов " + ЧислоСтрокой(Панель.Блоки.Количество()),
		"готовлю прогон") + "</div>");

	// Счётчики по всему прогону.
	Итоги = Панель.Итоги;
	Части.Добавить("<div class=""tiles"">"
		+ ПлиткаСчетчика("ok", "ОК", Итоги.ОК)
		+ ПлиткаСчетчика("bad", "Ошибки", Итоги.Ошибок)
		+ ПлиткаСчетчика("warn", "Внимание", Итоги.Внимание)
		+ ПлиткаСчетчика("skip", "Пропуски", Итоги.Пропусков) + "</div>");

	// Что сейчас: текущее задание или итог.
	Если Не ПустаяСтрока(Панель.Итог) Тогда
		Части.Добавить("<div class=""now done " + КлассШапки + """><b>" + ТекстДляHTML(ТекстИтогаПанели(Панель.Итог))
			+ "</b><span>" + ТекстДляHTML(Панель.Состояние) + "</span></div>");
	ИначеЕсли Не ПустаяСтрока(Панель.ТекущееЗадание) Тогда
		ЗаданиеСекунд = Цел((Сейчас - Панель.НачалоЗадания) / 1000);
		Части.Добавить("<div class=""now""><i class=""spin anim""></i><b>" + ТекстДляHTML(Панель.ТекущийШаг)
			+ "</b><span>" + ТекстДляHTML(Панель.ТекущееЗадание) + "</span><em class=""tick"" data-base="""
			+ Формат(ЗаданиеСекунд, "ЧН=0; ЧГ=0") + """ data-run=""1"">" + ТекстДлительности(ЗаданиеСекунд)
			+ "</em></div>");
	Иначе
		Части.Добавить("<div class=""now""><i class=""spin anim""></i><b>Подготовка</b><span>"
			+ ТекстДляHTML(Панель.Состояние) + "</span></div>");
	КонецЕсли;

	// Карточки шагов.
	Части.Добавить("<div class=""cards"">");
	Для Каждого Блок Из Панель.Блоки Цикл
		Части.Добавить(КарточкаШага(Блок, Блок.Имя = Панель.ТекущийШаг И ИдётПрогон, Сейчас));
	КонецЦикла;
	Части.Добавить("</div>");

	Части.Добавить("<div class=""foot"">Окно закроется само, когда прогон закончится. Журнал и итог - в папке "
		+ ТекстДляHTML(?(Автозапуск = Неопределено, "", Автозапуск.Каталог)) + "</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

&НаКлиенте
Функция КарточкаШага(Блок, ЭтоТекущий, Сейчас)

	Доля = ?(Блок.Всего > 0, Блок.Выполнено / Блок.Всего, 0);

	Если ЭтоТекущий Тогда
		КлассКарточки = "run";
	ИначеЕсли Блок.Ошибок > 0 Тогда
		КлассКарточки = "bad";
	ИначеЕсли Блок.Внимание > 0 Тогда
		КлассКарточки = "warn";
	ИначеЕсли Блок.Выполнено >= Блок.Всего И Блок.ВПрошломСеансе >= Блок.Всего Тогда
		КлассКарточки = "prev";
	ИначеЕсли Блок.Выполнено >= Блок.Всего Тогда
		КлассКарточки = "ok";
	ИначеЕсли Блок.Выполнено > 0 Тогда
		КлассКарточки = "part";
	Иначе
		КлассКарточки = "wait";
	КонецЕсли;

	Метки = "";
	Если Блок.ОК > 0 Тогда
		Метки = Метки + "<b class=""t-ok"">ОК " + ЧислоСтрокой(Блок.ОК) + "</b>";
	КонецЕсли;
	Если Блок.Ошибок > 0 Тогда
		Метки = Метки + "<b class=""t-bad"">ошибок " + ЧислоСтрокой(Блок.Ошибок) + "</b>";
	КонецЕсли;
	Если Блок.Внимание > 0 Тогда
		Метки = Метки + "<b class=""t-warn"">внимание " + ЧислоСтрокой(Блок.Внимание) + "</b>";
	КонецЕсли;
	Если Блок.Пропусков > 0 Тогда
		Метки = Метки + "<b class=""t-skip"">пропусков " + ЧислоСтрокой(Блок.Пропусков) + "</b>";
	КонецЕсли;
	Если Блок.ВПрошломСеансе > 0 Тогда
		Метки = Метки + "<b class=""t-skip"">в прошлом сеансе " + ЧислоСтрокой(Блок.ВПрошломСеансе) + "</b>";
	КонецЕсли;

	Время = "";
	Если Блок.Начало > 0 Тогда
		Конец = ?(Блок.Конец > 0, Блок.Конец, Сейчас);
		Время = ТекстДлительности(Цел((Конец - Блок.Начало) / 1000));
	КонецЕсли;

	Возврат "<div class=""card " + КлассКарточки + """><div class=""ch""><span class=""dot" + ?(ЭтоТекущий, " anim", "")
		+ """></span><span class=""nm"">" + ТекстДляHTML(Блок.Имя) + "</span><span class=""cnt"">"
		+ ЧислоСтрокой(Блок.Выполнено) + "/" + ЧислоСтрокой(Блок.Всего) + "</span></div><div class=""track"">"
		+ "<i class=""" + ?(ЭтоТекущий, "fill flow anim", "fill") + """ style=""width:" + ЧислоДляCSS(Доля * 100)
		+ "%""></i></div><div class=""tags"">" + Метки + "<span class=""tm"">" + Время + "</span></div></div>";

КонецФункции

&НаКлиенте
Функция ПлиткаСчетчика(Класс, Название, Значение)

	Возврат "<div class=""tile " + Класс + ?(Значение > 0, " on", "") + """><div class=""v"">" + ЧислоСтрокой(Значение)
		+ "</div><div class=""l"">" + Название + "</div></div>";

КонецФункции

// Оценка, сколько осталось: по среднему времени выполненных в этом сеансе заданий.
&НаКлиенте
Функция ОценкаОстатка(Панель, ПрошлоСекунд)

	ВПрошломСеансе = 0;
	Для Каждого Блок Из Панель.Блоки Цикл
		ВПрошломСеансе = ВПрошломСеансе + Блок.ВПрошломСеансе;
	КонецЦикла;
	ВыполненоЗдесь = Панель.Выполнено - ВПрошломСеансе;

	Если Не ПустаяСтрока(Панель.Итог) Или ВыполненоЗдесь < 5 Или Панель.Всего <= Панель.Выполнено Тогда
		Возврат "";
	КонецЕсли;

	Осталось = Цел(ПрошлоСекунд / ВыполненоЗдесь * (Панель.Всего - Панель.Выполнено));
	Возврат " · осталось ~" + ТекстДлительности(Осталось);

КонецФункции

&НаКлиенте
Функция ТекстИтогаПанели(СтатусИтога)

	Если СтатусИтога = "done" Тогда
		Возврат "Прогон закончен";
	ИначеЕсли СтатусИтога = "same" Тогда
		Возврат "База не менялась с прошлого прогона: тестирование не нужно";
	ИначеЕсли СтатусИтога = "refused" Тогда
		Возврат "Отказ: база не похожа на тестовую, а запуск не только на чтение";
	Иначе
		Возврат "Прогон не начался";
	КонецЕсли;

КонецФункции

// Возвращает полную страницу экрана: оформление, обработчик ciUpdate и изменяемая часть.
//
// Параметры:
//  ТекстЭкрана - Строка - см. ТекстЭкранаАвтозапуска.
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
&НаКлиенте
Функция СтраницаАвтозапуска(ТекстЭкрана)

	Стили = "body{margin:0;background:#0f1320;color:#d6dcea;overflow-x:hidden;"
		+ "font:14px/1.35 'Segoe UI',Arial,sans-serif}"
		+ ".wrap{padding:18px 22px 14px}"
		+ ".top{display:flex;align-items:center}"
		+ ".logo{width:46px;height:46px;border-radius:14px;margin-right:14px;position:relative;"
		+ "background:linear-gradient(135deg,#5a56e0,#3ec7a0);box-shadow:0 6px 22px rgba(90,86,224,.35)}"
		+ ".top.ok .logo{background:linear-gradient(135deg,#2fb57a,#3ec7a0)}"
		+ ".top.warn .logo{background:linear-gradient(135deg,#e0a03a,#f0c060)}"
		+ ".top.bad .logo{background:linear-gradient(135deg,#d9475b,#f07a6a)}"
		+ ".beat{position:absolute;left:15px;top:15px;width:16px;height:16px;border-radius:50%;background:#fff;"
		+ "animation:beat 1.6s ease-in-out infinite}"
		+ ".top.ok .beat,.top.warn .beat,.top.bad .beat{animation:none}"
		+ "@keyframes beat{0%,100%{transform:scale(.75);opacity:.85}50%{transform:scale(1.15);opacity:1}}"
		+ ".ttl{flex:1}.h1{font-size:22px;font-weight:600;color:#fff}.sub{color:#8a93ab;font-size:12px;margin-top:2px}"
		+ ".big{text-align:right}.pct{font-size:34px;font-weight:300;color:#fff;line-height:1}"
		+ ".pct small{font-size:16px;color:#8a93ab;margin-left:2px}"
		+ ".track{height:8px;border-radius:8px;background:#1f2638;overflow:hidden;margin-top:8px}"
		+ ".track.main{height:14px;margin-top:16px;box-shadow:inset 0 1px 3px rgba(0,0,0,.4)}"
		+ ".fill{display:block;height:100%;border-radius:8px;background:linear-gradient(90deg,#5a56e0,#3ec7a0);"
		+ "transition:width .6s ease}"
		+ ".flow{background:linear-gradient(110deg,#5a56e0 0%,#5a56e0 35%,#8f8cf5 50%,#3ec7a0 65%,#3ec7a0 100%);"
		+ "background-size:220% 100%;animation:flow 2.2s linear infinite}"
		+ "@keyframes flow{0%{background-position:100% 0}100%{background-position:-120% 0}}"
		+ ".meta{color:#8a93ab;font-size:12px;margin-top:6px}"
		+ ".tiles{display:flex;margin:14px -5px 0}"
		+ ".tile{flex:1;margin:0 5px;padding:9px 12px;border-radius:10px;background:#161c2c;border:1px solid #222a3e}"
		+ ".tile .v{font-size:22px;font-weight:600;color:#59627a}.tile .l{font-size:11px;color:#6f7891;"
		+ "text-transform:uppercase;letter-spacing:.06em}"
		+ ".tile.ok.on .v{color:#3ec7a0}.tile.bad.on{border-color:#5a2633;background:#22141b}"
		+ ".tile.bad.on .v{color:#ff6b7f}"
		+ ".tile.warn.on{border-color:#4d3d1c}.tile.warn.on .v{color:#f0b54a}.tile.skip.on .v{color:#a3abc0}"
		+ ".now{display:flex;align-items:center;margin-top:14px;padding:10px 14px;border-radius:10px;"
