root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psd1,cmd,bsl,xml}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.bsl]
indent_style = tab

[*.ps1]
charset = utf-8-bom

[*.go]
indent_style = tab

[*.{md,yml,json}]
end_of_line = lf
indent_style = space
indent_size = 2
